<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CIPRMS-CSPC-CIRL</title>
  <link rel="icon" type="image/jpg" href="/images/cirl-logo.jpg">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #eef2f9;
      color: #1a1a2e;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .top-header {
      background: #fff;
      border-bottom: 1px solid #e2e8f0;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 22px 0 18px;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .header-logo {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      object-fit: cover;
    }

    .header-title {
      font-size: 19px;
      font-weight: 700;
      color: #0d1b3e;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .layout {
      display: flex;
      margin-top: 64px;
      height: calc(100vh - 64px);
    }

    .sidebar {
      width: 62px;
      background: #fff;
      border-right: 1px solid #e2e8f0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px 0 14px;
      position: fixed;
      left: 0;
      top: 64px;
      bottom: 0;
      z-index: 50;
    }

    .sidebar-top-icons {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      flex: 1;
    }

    .sidebar-icon {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      cursor: pointer;
      color: #64748b;
      font-size: 17px;
      transition: all .2s;
      text-decoration: none;
    }

    .sidebar-icon:hover {
      background: #f1f5f9;
      color: #1e3a5f;
    }

    .sidebar-icon.active {
      background: #e8f0fe;
      color: #1e3a8a;
    }

    .sidebar-bottom {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .sidebar-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #e2e8f0;
      cursor: pointer;
    }

    .main-content {
      margin-left: 62px;
      flex: 1;
      padding: 20px 22px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 16px;
      min-height: 0;
    }

    .tab-bar {
      display: flex;
      gap: 4px;
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 12px;
      padding: 5px;
      width: fit-content;
    }

    .tab-btn {
      padding: 7px 18px;
      border-radius: 8px;
      border: none;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      background: transparent;
      color: #64748b;
    }

    .tab-btn.active {
      background: #1e3a8a;
      color: #fff;
      box-shadow: 0 2px 8px rgba(30, 58, 138, .25);
    }

    .tab-content {
      display: none;
      flex-direction: column;
      gap: 14px;
    }

    .tab-content.active {
      display: flex;
      flex: 1;
      min-height: 0;
    }

    .stat-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
    }

    .stat-card {
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 12px;
      padding: 14px 16px;
    }

    .sc-icon {
      font-size: 20px;
      margin-bottom: 4px;
    }

    .sc-val {
      font-size: 28px;
      font-weight: 800;
      line-height: 1.1;
    }

    .sc-label {
      font-size: 11px;
      color: #64748b;
      font-weight: 600;
      margin-top: 2px;
    }

    .filter-card {
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 12px;
      padding: 16px 18px;
    }

    .filter-row {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr auto;
      gap: 10px;
      align-items: flex-end;
    }

    .f-label {
      font-size: 11px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: .5px;
      margin-bottom: 5px;
    }

    .f-input,
    .f-select {
      width: 100%;
      padding: 8px 12px;
      border: 1.5px solid #d8e2f0;
      border-radius: 8px;
      font-size: 13px;
      font-family: 'Inter', sans-serif;
      color: #1e293b;
      background: #f8faff;
      outline: none;
    }

    .f-btn {
      padding: 9px 18px;
      background: #1e3a8a;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }

    /* ── Two-column lifecycle layout ───────────────────────────────── */
    .lc-layout {
      display: grid;
      grid-template-columns: 230px 1fr;
      gap: 16px;
      align-items: stretch;
      flex: 1;
      min-height: 0;
    }

    .lc-side {
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 0;
    }

    .lc-side-card {
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 12px;
      padding: 14px 16px;
      overflow-y: auto;
    }

    .lc-side-card:last-child {
      flex: 1;
      min-height: 0;
    }

    .side-card-title {
      font-size: 11px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: .5px;
      margin-bottom: 10px;
    }

    .qstat-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 7px 0;
      border-bottom: 1px solid #f1f5f9;
      font-size: 13px;
    }

    .qstat-row:last-child {
      border-bottom: none;
    }

    .qstat-label {
      color: #64748b;
      font-size: 12.5px;
    }

    .qstat-val {
      font-weight: 800;
      font-size: 15px;
    }

    .urgent-item {
      display: flex;
      gap: 9px;
      align-items: flex-start;
      padding: 8px 0;
      border-bottom: 1px solid #f1f5f9;
    }

    .urgent-item:last-child {
      border-bottom: none;
    }

    .urgent-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 4px;
    }

    .urgent-inst {
      font-size: 12px;
      font-weight: 700;
      color: #1e293b;
    }

    .urgent-meta {
      font-size: 11px;
      color: #94a3b8;
    }

    .lc-main {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
    }

    .table-card {
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 12px;
      overflow: hidden;
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .tc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px 10px;
      border-bottom: 1px solid #e2e8f0;
    }

    .tc-title {
      font-size: 15px;
      font-weight: 700;
      color: #0d1b3e;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    thead tr {
      background: #f8faff;
      position: sticky;
      top: 0;
      z-index: 1;
    }

    th {
      padding: 10px 14px;
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: .5px;
      border-bottom: 1px solid #e2e8f0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    td {
      padding: 11px 14px;
      font-size: 13px;
      color: #1e293b;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    tbody tr:hover {
      background: #f8faff;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    .act-btn {
      background: none;
      border: none;
      padding: 0;
      font-size: 12px;
      font-weight: 600;
      color: #1e293b;
      cursor: pointer;
      text-decoration: none;
      text-underline-offset: 2px;
    }

    .act-btn:hover {
      color: #1e3a8a;
    }

    .notif-card {
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 12px;
      padding: 18px 20px;
    }

    .notif-title {
      font-size: 15px;
      font-weight: 700;
      color: #0d1b3e;
      margin-bottom: 14px;
    }

    .notif-row {
      display: flex;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid #f1f5f9;
      align-items: flex-start;
    }

    .notif-row:last-child {
      border-bottom: none;
    }

    .n-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
      margin-top: 5px;
    }

    .notif-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #64748b;
      margin-bottom: 5px;
    }

    .form-select {
      width: 100%;
      padding: 9px 12px;
      border: 1.5px solid #d8e2f0;
      border-radius: 8px;
      font-size: 13px;
      font-family: 'Inter', sans-serif;
      color: #1e293b;
      background: #f8faff;
      outline: none;
    }

    .save-btn {
      padding: 9px 20px;
      background: #1e3a8a;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }

    /* filter pills */
    .pill-group {
      display: flex;
      gap: 4px;
      flex-wrap: wrap;
    }

    .pill {
      padding: 4px 11px;
      border-radius: 20px;
      border: 1.5px solid #d8e2f0;
      background: #f8faff;
      font-size: 11.5px;
      font-weight: 600;
      color: #64748b;
      cursor: pointer;
      white-space: nowrap;
      transition: all .15s;
    }

    .pill:hover {
      border-color: #93c5fd;
      color: #1e3a8a;
    }

    .pill.active {
      background: #1e3a8a;
      color: #fff;
      border-color: #1e3a8a;
    }

    /* overview mini progress bar */
    .mini-bar-wrap {
      background: #f1f5f9;
      border-radius: 4px;
      height: 5px;
      margin-top: 6px;
      overflow: hidden;
    }

    .mini-bar {
      height: 5px;
      border-radius: 4px;
      background: #1e3a8a;
    }
  </style>
</head>

<body>

  <%- include('partials/header') %>
    <div class="layout">
      <%- include('partials/sidebar') %>
        <main class="main-content">

          <div style="display:flex;align-items:center;justify-content:space-between;">
            <div>
              <h1 style="font-size:22px;font-weight:800;color:#0d1b3e;">Lifecycle Monitor</h1>
              <p style="font-size:13px;color:#64748b;margin-top:2px;">Track agreement validity, expirations, and
                automated alerts</p>
            </div>

          </div>

          <div class="tab-content active" id="content-lc">
            <div class="lc-layout">

              <!-- LEFT SIDEBAR -->
              <div class="lc-side">
                <div class="lc-side-card">
                  <div class="side-card-title">Overview</div>
                  <div class="qstat-row"><span class="qstat-label">Total Agreements</span><span class="qstat-val"
                      style="color:#0d1b3e;">102</span></div>
                  <div class="qstat-row"><span class="qstat-label">Active</span><span class="qstat-val"
                      style="color:#15803d;">61</span></div>
                  <div class="qstat-row"><span class="qstat-label">Expiring &le; 30d</span><span class="qstat-val"
                      style="color:#b91c1c;">9</span></div>
                  <div class="qstat-row"><span class="qstat-label">Expiring &le; 90d</span><span class="qstat-val"
                      style="color:#d97706;">18</span></div>
                  <div class="qstat-row"><span class="qstat-label">Expired</span><span class="qstat-val"
                      style="color:#b91c1c;">14</span></div>
                  <div class="qstat-row"><span class="qstat-label">Renewed (yr)</span><span class="qstat-val"
                      style="color:#1e40af;">7</span></div>
                  <div style="margin-top:10px;padding-top:10px;border-top:1px solid #f1f5f9;">
                    <div
                      style="display:flex;justify-content:space-between;font-size:11.5px;color:#64748b;margin-bottom:3px;">
                      <span>Active rate</span><span style="font-weight:700;color:#15803d;">60%</span>
                    </div>
                    <div class="mini-bar-wrap">
                      <div class="mini-bar" style="width:60%;background:#15803d;"></div>
                    </div>
                  </div>
                  <div style="margin-top:8px;">
                    <div
                      style="display:flex;justify-content:space-between;font-size:11.5px;color:#64748b;margin-bottom:3px;">
                      <span>MOA</span><span style="font-weight:700;color:#1e3a8a;">58</span>
                    </div>
                    <div class="mini-bar-wrap">
                      <div class="mini-bar" style="width:57%;"></div>
                    </div>
                  </div>
                  <div style="margin-top:8px;">
                    <div
                      style="display:flex;justify-content:space-between;font-size:11.5px;color:#64748b;margin-bottom:3px;">
                      <span>MOU</span><span style="font-weight:700;color:#1e3a8a;">44</span>
                    </div>
                    <div class="mini-bar-wrap">
                      <div class="mini-bar" style="width:43%;"></div>
                    </div>
                  </div>
                  <div
                    style="margin-top:8px;padding-top:8px;border-top:1px solid #f1f5f9;font-size:11.5px;color:#64748b;display:flex;justify-content:space-between;">
                    <span>International <strong style="color:#3730a3;">67</strong></span>
                    <span>Local <strong style="color:#854d0e;">35</strong></span>
                  </div>
                </div>
                <div class="lc-side-card">
                  <div class="side-card-title"><i class="fa-solid fa-triangle-exclamation" style="color:#d97706;"></i>
                    Urgent</div>
                  <div class="urgent-item">
                    <div class="urgent-dot" style="background:#b91c1c;"></div>
                    <div>
                      <div class="urgent-inst">Ateneo de Manila</div>
                      <div class="urgent-meta">MOA &middot; <strong style="color:#b91c1c;">12 days</strong></div>
                    </div>
                  </div>
                  <div class="urgent-item">
                    <div class="urgent-dot" style="background:#d97706;"></div>
                    <div>
                      <div class="urgent-inst">Osaka University</div>
                      <div class="urgent-meta">MOU &middot; <strong style="color:#d97706;">21 days</strong></div>
                    </div>
                  </div>
                  <div class="urgent-item">
                    <div class="urgent-dot" style="background:#d97706;"></div>
                    <div>
                      <div class="urgent-inst">Hiroshima University</div>
                      <div class="urgent-meta">MOA &middot; <strong style="color:#d97706;">38 days</strong></div>
                    </div>
                  </div>
                  <div class="urgent-item">
                    <div class="urgent-dot" style="background:#d97706;"></div>
                    <div>
                      <div class="urgent-inst">Mapua University</div>
                      <div class="urgent-meta">MOU &middot; <strong style="color:#d97706;">55 days</strong></div>
                    </div>
                  </div>
                  <div class="urgent-item">
                    <div class="urgent-dot" style="background:#b91c1c;"></div>
                    <div>
                      <div class="urgent-inst">TESDA Region V</div>
                      <div class="urgent-meta">MOA &middot; <strong style="color:#b91c1c;">Expired</strong></div>
                    </div>
                  </div>
                  <div class="urgent-item">
                    <div class="urgent-dot" style="background:#b91c1c;"></div>
                    <div>
                      <div class="urgent-inst">NTU Singapore</div>
                      <div class="urgent-meta">MOU &middot; <strong style="color:#b91c1c;">Expired</strong></div>
                    </div>
                  </div>
                  <div class="urgent-item">
                    <div class="urgent-dot" style="background:#b91c1c;"></div>
                    <div>
                      <div class="urgent-inst">CLSU</div>
                      <div class="urgent-meta">MOA &middot; <strong style="color:#b91c1c;">Expired</strong></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- RIGHT: filter + table -->
              <div class="lc-main">
                <div class="table-card">
                  <!-- Pill filter header -->
                  <div class="tc-header"
                    style="flex-direction:column;align-items:flex-start;gap:10px;padding:14px 16px;">
                    <div style="display:flex;justify-content:space-between;align-items:center;width:100%;">
                      <span class="tc-title">Agreement Validity Tracker</span>
                      <span id="lc-count" style="font-size:12px;color:#94a3b8;"></span>
                    </div>
                    <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap;">
                      <div style="display:flex;gap:6px;align-items:center;">
                        <span
                          style="font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.4px;">Status</span>
                        <div class="pill-group" id="pills-status">
                          <button class="pill active" onclick="setPill('status','',this)">All</button>
                          <button class="pill" onclick="setPill('status','Active',this)">Active</button>
                          <button class="pill" onclick="setPill('status','Expiring',this)">Expiring</button>
                          <button class="pill" onclick="setPill('status','Expired',this)">Expired</button>
                        </div>
                      </div>
                      <div style="display:flex;gap:6px;align-items:center;">
                        <span
                          style="font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.4px;">Category</span>
                        <div class="pill-group" id="pills-cat">
                          <button class="pill active" onclick="setPill('cat','',this)">All</button>
                          <button class="pill" onclick="setPill('cat','International',this)">International</button>
                          <button class="pill" onclick="setPill('cat','Local',this)">Local</button>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div style="flex:1;overflow-y:auto;min-height:0;">
                    <table>
                      <colgroup>
                        <col style="width:32%">
                        <col style="width:12%">
                        <col style="width:16%">
                        <col style="width:14%">
                        <col style="width:14%">
                        <col style="width:12%">
                      </colgroup>
                      <thead>
                        <tr>
                          <th>Institution</th>
                          <th>Agreement</th>
                          <th>Expiry Date</th>
                          <th>Days Left</th>
                          <th>Status</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody id="lc-tbody"></tbody>
                    </table>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </main>
    </div>
    <script>
      const agreements = [
        { inst: "Ateneo de Manila University", type: "MOA", cat: "Local", start: "Apr 12, 2021", expiry: "Apr 12, 2026", days: 12, status: "Expiring" },
        { inst: "Osaka University", type: "MOU", cat: "International", start: "May 3, 2022", expiry: "May 3, 2026", days: 21, status: "Expiring" },
        { inst: "Hiroshima University", type: "MOA", cat: "International", start: "Mar 6, 2023", expiry: "May 13, 2026", days: 38, status: "Expiring" },
        { inst: "Mapua University", type: "MOU", cat: "Local", start: "Jan 20, 2023", expiry: "May 30, 2026", days: 55, status: "Expiring" },
        { inst: "TESDA Region V", type: "MOA", cat: "Local", start: "Jan 1, 2020", expiry: "Jan 1, 2025", days: -440, status: "Expired" },
        { inst: "NTU Singapore", type: "MOU", cat: "International", start: "Aug 10, 2022", expiry: "Aug 10, 2025", days: -214, status: "Expired" },
        { inst: "CLSU", type: "MOA", cat: "Local", start: "Feb 14, 2019", expiry: "Feb 14, 2024", days: -759, status: "Expired" },
        { inst: "Jilin University", type: "MOU", cat: "International", start: "Sep 5, 2020", expiry: "Sep 5, 2023", days: -921, status: "Expired" },
        { inst: "University of Santo Tomas", type: "MOA", cat: "Local", start: "Dec 15, 2021", expiry: "Dec 15, 2026", days: 279, status: "Active" },
        { inst: "Chonnam National University", type: "MOU", cat: "International", start: "Mar 30, 2022", expiry: "Mar 30, 2027", days: 384, status: "Active" },
        { inst: "University of Macau", type: "MOA", cat: "International", start: "Jul 22, 2022", expiry: "Jul 22, 2027", days: 498, status: "Active" },
        { inst: "De La Salle University", type: "MOA", cat: "Local", start: "Feb 1, 2023", expiry: "Feb 1, 2028", days: 691, status: "Active" },
        { inst: "University of Melbourne", type: "MOU", cat: "International", start: "Jun 5, 2023", expiry: "Jun 5, 2028", days: 816, status: "Active" },
        { inst: "DOST Region V", type: "MOA", cat: "Local", start: "Nov 15, 2022", expiry: "Nov 15, 2026", days: 248, status: "Active" },
        { inst: "Kyoto University", type: "MOU", cat: "International", start: "Apr 10, 2022", expiry: "Apr 10, 2027", days: 394, status: "Active" },
        { inst: "AUN-QA", type: "MOA", cat: "International", start: "Mar 1, 2023", expiry: "Mar 1, 2028", days: 718, status: "Active" },
        { inst: "Hanyang University", type: "MOU", cat: "International", start: "Aug 20, 2021", expiry: "Aug 20, 2026", days: 159, status: "Active" },
        { inst: "PNU Manila", type: "MOA", cat: "Local", start: "Oct 5, 2022", expiry: "Oct 5, 2027", days: 573, status: "Active" },
        { inst: "Tohoku University", type: "MOU", cat: "International", start: "Dec 1, 2021", expiry: "Dec 1, 2026", days: 262, status: "Active" },
        { inst: "Bulacan State University", type: "MOA", cat: "Local", start: "Jun 10, 2023", expiry: "Jun 10, 2028", days: 822, status: "Active" },
      ];
      let lcFiltered = [...agreements];
      let activeStatus = '', activeCat = '';
      function setPill(type, val, btn) {
        const group = document.getElementById('pills-' + type);
        group.querySelectorAll('.pill').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        if (type === 'status') activeStatus = val;
        else activeCat = val;
        filterLC();
      }
      function daysBadge(d, s) {
        if (s === "Expired") return `<span style="color:#b91c1c;font-weight:700;">Expired</span>`;
        if (d <= 14) return `<span style="color:#b91c1c;font-weight:800;">Critical (${d}d)</span>`;
        if (d <= 90) return `<span style="color:#d97706;font-weight:700;">${d} days</span>`;
        return `<span style="color:#15803d;font-weight:600;">${d} days</span>`;
      }
      function sbadge(s) {
        const c = { Active: '#15803d', Expiring: '#d97706', Expired: '#b91c1c', Renewed: '#1e40af' };
        return `<span style="color:${c[s] || '#15803d'};font-weight:700;">${s}</span>`;
      }
      function filterLC() {
        lcFiltered = agreements.filter(a =>
          (!activeStatus || a.status === activeStatus) &&
          (!activeCat || a.cat === activeCat)
        );
        renderLC();
      }
      function renderLC() {
        document.getElementById('lc-count').textContent = `${lcFiltered.length} of ${agreements.length}`;
        document.getElementById('lc-tbody').innerHTML = lcFiltered.map(a =>
          `<tr>
            <td style="font-weight:700;color:#0d1b3e;">${a.inst}</td>
            <td style="color:#3730a3;font-weight:700;">${a.type} <span style="color:#94a3b8;font-weight:400;font-size:11px;">${a.cat}</span></td>
            <td style="color:${a.status === 'Expired' ? '#b91c1c' : a.days <= 30 ? '#dc2626' : a.days <= 90 ? '#d97706' : '#15803d'};font-weight:600;">${a.expiry}</td>
            <td>${daysBadge(a.days, a.status)}</td>
            <td>${sbadge(a.status)}</td>
            <td>${a.status === 'Expired' ? `<button class="act-btn">Renew</button>` : a.days <= 90 ? `<button class="act-btn">Remind</button>` : `<button class="act-btn">View</button>`}</td>
          </tr>`
        ).join('');
      }
      renderLC();
    </script>
</body>

</html>