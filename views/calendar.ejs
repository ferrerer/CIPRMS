    <script>
        let today = new Date(), currentYear = today.getFullYear(), currentMonth = today.getMonth(), currentDay = today.getDate(), viewMode = 'week';
        const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
        const DAYS = ['SUNDAY', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'];
        const DAYS_S = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        function pad(n) { return String(n).padStart(2, '0'); }
        function dateKey(y, m, d) { return `${y}-${pad(m)}-${pad(d)}`; }
        function typeClass(t) { return ({ meeting: 'type-meeting', expiry: 'type-expiry', renewal: 'type-renewal', mobility: 'type-mobility' }[t] || 'type-meeting'); }
        function typeBadgeClass(t) { return ({ meeting: 'badge-meeting', expiry: 'badge-expiry', renewal: 'badge-renewal', mobility: 'badge-mobility' }[t] || 'badge-meeting'); }
        function typeLabel(t) { return ({ meeting: 'Meeting', expiry: 'Expiry/Deadline', renewal: 'Renewal', mobility: 'Mobility' }[t] || 'Meeting'); }
        function typeDotColor(t) { return ({ meeting: '#3b82f6', expiry: '#ef4444', renewal: '#22c55e', mobility: '#eab308' }[t] || '#3b82f6'); }
        function typeColors(t) { return { bg: ({ meeting: '#dbeafe', expiry: '#fee2e2', renewal: '#dcfce7', mobility: '#fef9c3' }[t] || '#dbeafe'), text: ({ meeting: '#1e40af', expiry: '#b91c1c', renewal: '#15803d', mobility: '#92400e' }[t] || '#1e40af') }; }

        // ── Filter state ──────────────────────────────────────────────
        const activeFilters = { inst: new Set(), status: new Set(), type: new Set() };

        function filterEvents(evArr) {
            return evArr.filter(ev => {
                if (activeFilters.inst.size && !activeFilters.inst.has(ev.inst)) return false;
                if (activeFilters.type.size && !activeFilters.type.has(ev.type)) return false;
                // status filter: map agreement status via agtype field or leave open
                // (status filter applies when agtype matches: MOA=active/expiring/expired context)
                // For demo we treat 'expiry' type events as 'expired' status
                if (activeFilters.status.size) {
                    const evStatus = ev.type === 'expiry' ? 'expired' : ev.type === 'renewal' ? 'expiring' : 'active';
                    if (!activeFilters.status.has(evStatus)) return false;
                }
                return true;
            });
        }

        function toggleDD(id, e) {
            e.stopPropagation();
            document.querySelectorAll('.filter-dropdown').forEach(d => { if (d.id !== id) d.classList.remove('open'); });
            document.getElementById(id).classList.toggle('open');
        }
        document.addEventListener('click', () => { document.querySelectorAll('.filter-dropdown').forEach(d => d.classList.remove('open')); });

        // pending filter state — staged until Apply is clicked
        const pendingFilters = { inst: new Set(), type: new Set() };

        function toggleFilter(type, val, el) {
            const p = pendingFilters[type];
            if (p.has(val)) { p.delete(val); el.classList.remove('selected'); }
            else { p.add(val); el.classList.add('selected'); }
            markPending();
        }
        function markPending() {
            const btn = document.getElementById('btn-apply-filter');
            const anyPendingNew = ['inst', 'type'].some(t => {
                if (!pendingFilters[t] || !activeFilters[t]) return false;
