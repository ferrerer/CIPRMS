                pendingFilters.inst.delete(val);
                el.classList.remove('selected');
                const chk = el.querySelector('.dd-check');
                if (chk) chk.textContent = '';
            });
            markPending();
        }
        document.addEventListener('keydown', e => { if (e.key === 'Escape') { document.getElementById('event-modal').classList.remove('open'); document.getElementById('add-modal').classList.remove('open'); } if (e.key === 'ArrowLeft') navigate(-1); if (e.key === 'ArrowRight') navigate(1); });
        setView('month');
    </script>
</body>

</html>