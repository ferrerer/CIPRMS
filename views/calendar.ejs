<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendar — CSPC-CIRL Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #eef2f9;
            color: #1a1a2e;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .top-header {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 22px 0 18px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-logo {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
        }

        .header-title {
            font-size: 19px;
            font-weight: 700;
            color: #0d1b3e;
            letter-spacing: -.2px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header-search-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: #64748b;
            font-size: 18px;
            padding: 6px 8px;
            border-radius: 8px;
            transition: background .2s;
        }

        .header-search-btn:hover {
            background: #f1f5f9;
        }

        .header-add-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #0d1b3e;
            color: #fff;
            border: none;
            font-size: 18px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .2s;
        }

        .header-add-btn:hover {
            background: #1e3a8a;
        }

        .layout {
            display: flex;
            margin-top: 64px;
            height: calc(100vh - 64px);
        }

        .sidebar {
            width: 62px;
            background: #fff;
            border-right: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 16px 0 14px;
            position: fixed;
            left: 0;
            top: 64px;
            bottom: 0;
            z-index: 50;
        }

        .sidebar-top-icons {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            flex: 1;
        }

        .sidebar-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            cursor: pointer;
            color: #64748b;
            font-size: 17px;
            transition: all .2s;
            text-decoration: none;
        }

        .sidebar-icon:hover {
            background: #f1f5f9;
            color: #1e3a5f;
        }

        .sidebar-icon.active {
            background: #e8f0fe;
            color: #1e3a8a;
        }

        .sidebar-bottom {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .sidebar-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
            cursor: pointer;
        }

        .main-content {
            margin-left: 62px;
            flex: 1;
            padding: 20px 22px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .page-title {
            font-size: 24px;
            font-weight: 800;
            color: #0d1b3e;
        }

        .calendar-card {
            background: #dde6f5;
            border: 1.5px solid #c8d5ea;
            border-radius: 16px;
            overflow: hidden;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .filter-bar {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 18px 0;
            flex-wrap: wrap;
        }

        .filter-wrap {
            position: relative;
        }

        .now-btn {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 5px 14px;
            background: #f1f5f9;
            color: #334155;
            border: 1.5px solid #d8e2f0;
            border-radius: 20px;
            font-size: 12.5px;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s;
            white-space: nowrap;
        }

        .now-btn:hover {
            background: #1e3a8a;
            color: #fff;
            border-color: #1e3a8a;
        }

        .filter-chip {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            background: #1e3a8a;
            color: #fff;
            border: none;
            border-radius: 20px;
            font-size: 12.5px;
            font-weight: 500;
            cursor: pointer;
            transition: background .2s;
            user-select: none;
        }

        .filter-chip:hover {
            background: #1e40af;
        }

        .filter-chip.light {
            background: rgba(255, 255, 255, .6);
            color: #334155;
            border: 1px solid rgba(30, 58, 138, .18);
        }

        .filter-chip.light:hover {
            background: rgba(255, 255, 255, .9);
        }

        .filter-chip.has-active {
            background: #1e3a8a !important;
            color: #fff !important;
            border-color: transparent !important;
        }

        .filter-badge {
            background: rgba(255, 255, 255, .3);
            color: #fff;
            border-radius: 50%;
            width: 16px;
            height: 16px;
            font-size: 10px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .filter-dropdown {
            position: absolute;
            top: calc(100% + 6px);
            left: 0;
            z-index: 200;
            background: #fff;
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, .12);
            min-width: 190px;
            padding: 6px 0;
            display: none;
            animation: ddIn .15s ease;
        }

        @keyframes ddIn {
            from {
                opacity: 0;
                transform: translateY(-4px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .filter-dropdown.open {
            display: block;
        }

        .dd-section-label {
            padding: 6px 14px 2px;
            font-size: 10px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .dd-option {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 14px;
            font-size: 13px;
            color: #334155;
            cursor: pointer;
            transition: background .15s;
        }

        .dd-option:hover {
            background: #f1f5f9;
        }

        .dd-option.selected {
            color: #1e3a8a;
            font-weight: 600;
        }

        .dd-check {
            width: 16px;
            height: 16px;
            border: 1.5px solid #c8d5ea;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            flex-shrink: 0;
            transition: all .15s;
        }

        .dd-option.selected .dd-check {
            background: #1e3a8a;
            border-color: #1e3a8a;
            color: #fff;
        }

        .dd-divider {
            height: 1px;
            background: #e2e8f0;
            margin: 4px 0;
        }

        .dd-clear {
            display: block;
            width: 100%;
            text-align: center;
            padding: 6px 14px;
            font-size: 12px;
            color: #ef4444;
            font-weight: 600;
            cursor: pointer;
            background: none;
            border: none;
        }

        .dd-clear:hover {
            background: #fef2f2;
        }

        .active-filters-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            background: #e8f0fe;
            color: #1e3a8a;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            border: none;
        }

        .active-filters-pill:hover {
            background: #dbeafe;
        }

        /* ── Institution search dropdown ─────────────────────────────── */
        .dd-inst-head {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #fff;
            padding: 8px 10px 6px;
            border-bottom: 1px solid #edf2f7;
        }

        .dd-inst-search-wrap {
            position: relative;
        }

        .dd-inst-search {
            width: 100%;
            padding: 5px 10px 5px 28px;
            border: 1.5px solid #d8e2f0;
            border-radius: 7px;
            font-size: 12px;
            font-family: 'Inter', sans-serif;
            color: #1e293b;
            background: #f8faff;
            outline: none;
            box-sizing: border-box;
        }

        .dd-inst-search:focus {
            border-color: #1e3a8a;
        }

        .dd-inst-search-ico {
            position: absolute;
            left: 9px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 10px;
            color: #94a3b8;
            pointer-events: none;
        }

        .dd-inst-actions {
            display: flex;
            justify-content: space-between;
            padding: 6px 2px 0;
        }

        .dd-inst-act {
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            background: none;
            border: none;
            padding: 2px 4px;
            border-radius: 4px;
            color: #1e3a8a;
        }

        .dd-inst-act:hover {
            background: #eff6ff;
        }

        .dd-inst-act.desel {
            color: #64748b;
        }

        .dd-inst-act.desel:hover {
            background: #f1f5f9;
        }

        .cal-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 18px 12px;
        }

        .apply-filter-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 14px;
            border-radius: 20px;
            border: none;
            font-size: 12px;
            font-weight: 700;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            background: #1e3a8a;
            color: #fff;
            transition: background .2s, transform .1s;
            white-space: nowrap;
        }

        .apply-filter-btn:hover {
            background: #1e40af;
        }

        .apply-filter-btn:active {
            transform: scale(.97);
        }

        .apply-filter-btn .pending-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #facc15;
            display: none;
        }

        .apply-filter-btn.has-pending .pending-dot {
            display: inline-block;
        }

        .view-tabs {
            display: flex;
            align-items: center;
            background: rgba(255, 255, 255, .55);
            border-radius: 20px;
            padding: 3px;
            gap: 2px;
        }

        .view-tab {
            padding: 5px 14px;
            border-radius: 16px;
            border: none;
            background: transparent;
            font-size: 12.5px;
            font-weight: 500;
            color: #475569;
            cursor: pointer;
            transition: all .2s;
        }

        .view-tab.active {
            background: #1e3a8a;
            color: #fff;
            box-shadow: 0 2px 6px rgba(30, 58, 138, .3);
        }

        .cal-nav {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cal-month-label {
            font-size: 18px;
            font-weight: 700;
            color: #0d1b3e;
            min-width: 140px;
            text-align: center;
        }

        .nav-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #1e3a8a;
            color: #fff;
            border: none;
            font-size: 13px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .2s;
        }

        .nav-btn:hover {
            background: #1e40af;
        }

        .cal-grid-wrap {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 0 10px 10px;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .cal-grid {
            flex: 1;
            min-height: 0;
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            grid-template-rows: auto;
            grid-auto-rows: 1fr;
            gap: 0;
            background: #c8d5ea;
            border: 1.5px solid #c8d5ea;
            border-radius: 10px;
            overflow: hidden;
            width: 100%;
        }

        .cal-day-header {
            background: #fff;
            text-align: center;
            padding: 7px 4px;
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            letter-spacing: .5px;
            text-transform: uppercase;
            border-bottom: 1px solid #c8d5ea;
        }

        .cal-cell {
            background: #f8faff;
            padding: 6px 7px 4px;
            border-right: 1px solid #c8d5ea;
            border-bottom: 1px solid #c8d5ea;
            cursor: pointer;
            transition: background .15s;
            position: relative;
            min-width: 0;
            overflow: hidden;
        }

        .cal-cell:nth-child(7n) {
            border-right: none;
        }

        .cal-cell:hover {
            background: #e4ebf7;
        }

        .cal-cell.other-month {
            background: #e2ecff;
        }

        .cal-cell.other-month .cal-date-num {
            color: #c0cce0;
        }

        .cal-cell.today {
            background: #e8f0fe;
        }

        .cal-cell.today .cal-date-num {
            background: #1e3a8a;
            color: #fff;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cal-date-num {
            font-size: 12px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 4px;
        }

        .cal-event {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 2px 6px;
            border-radius: 4px;
            margin-bottom: 2px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 500;
            transition: opacity .15s;
            min-width: 0;
            overflow: hidden;
        }

        .cal-event:hover {
            opacity: .85;
        }

        .cal-event .ev-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .cal-event .ev-label {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            flex: 1;
        }

        .cal-event.type-meeting {
            background: #dbeafe;
            color: #1e40af;
        }

        .cal-event.type-expiry {
            background: #fee2e2;
            color: #b91c1c;
        }

        .cal-event.type-renewal {
            background: #dcfce7;
            color: #15803d;
        }

        .cal-event.type-mobility {
            background: #fef9c3;
            color: #92400e;
        }

        .week-view {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 0 10px 10px;
            min-height: 0;
        }

        .week-header {
            display: grid;
            grid-template-columns: 50px repeat(7, 1fr);
            background: #c8d5ea;
            border-radius: 10px 10px 0 0;
            overflow: hidden;
            border: 1.5px solid #c8d5ea;
        }

        .week-time-col-hdr {
            background: #dde6f5;
        }

        .week-day-hdr {
            background: #dde6f5;
            border-left: 1px solid #c8d5ea;
            padding: 8px 4px;
            text-align: center;
        }

        .week-day-hdr .wdh-name {
            font-size: 10px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .week-day-hdr .wdh-num {
            font-size: 20px;
            font-weight: 700;
            color: #0d1b3e;
        }

        .week-day-hdr .wdh-num.today-num {
            background: #1e3a8a;
            color: #fff;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
        }

        .week-body {
            display: grid;
            grid-template-columns: 50px repeat(7, 1fr);
            border: 1.5px solid #c8d5ea;
            border-top: none;
            border-radius: 0 0 10px 10px;
            overflow-y: auto;
            flex: 1;
            min-height: 0;
            background: #eef2f9;
        }

        .week-time-col {
            background: #f5f7fc;
            border-right: 1px solid #c8d5ea;
        }

        .week-time-slot {
            height: 60px;
            border-bottom: 1px solid #e2e8f0;
            padding: 4px 6px;
            font-size: 10px;
            color: #94a3b8;
            font-weight: 500;
            text-align: right;
        }

        .week-col {
            border-left: 1px solid #e2e8f0;
            position: relative;
        }

        .week-slot {
            height: 60px;
            border-bottom: 1px solid #f1f5f9;
        }

        .week-event-block {
            position: absolute;
            left: 4px;
            right: 4px;
            border-radius: 6px;
            padding: 4px 6px;
            font-size: 11px;
            font-weight: 600;
            z-index: 5;
            cursor: pointer;
        }

        .week-event-block:hover {
            opacity: .88;
        }

        .day-view {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 0 10px 10px;
            min-height: 0;
        }

        .day-header-bar {
            background: #1e3a8a;
            color: #fff;
            padding: 12px 20px;
            border-radius: 10px 10px 0 0;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .day-header-bar .day-big {
            font-size: 40px;
            font-weight: 800;
            line-height: 1;
        }

        .day-body {
            display: grid;
            grid-template-columns: 50px 1fr;
            border: 1.5px solid #c8d5ea;
            border-top: none;
            border-radius: 0 0 10px 10px;
            overflow-y: auto;
            flex: 1;
            min-height: 0;
            background: #eef2f9;
        }

        .day-time-col {
            background: #f5f7fc;
            border-right: 1px solid #c8d5ea;
        }

        .day-time-slot {
            height: 60px;
            border-bottom: 1px solid #e2e8f0;
            padding: 4px 6px;
            font-size: 10px;
            color: #94a3b8;
            font-weight: 500;
            text-align: right;
        }

        .day-events-col {
            position: relative;
        }

        .day-slot {
            height: 60px;
            border-bottom: 1px solid #f1f5f9;
        }

        .day-event-block {
            position: absolute;
            left: 10px;
            right: 10px;
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            z-index: 5;
        }

        .day-event-block:hover {
            opacity: .85;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .35);
            backdrop-filter: blur(3px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .modal-overlay.open {
            display: flex;
        }

        .modal-box {
            background: #fff;
            border-radius: 18px;
            width: 480px;
            max-width: 95vw;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(0, 0, 0, .18);
            animation: modalIn .22s ease;
        }

        @keyframes modalIn {
            from {
                transform: scale(.92);
                opacity: 0
            }

            to {
                transform: scale(1);
                opacity: 1
            }
        }

        .modal-header {
            padding: 20px 22px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .modal-title {
            font-size: 17px;
            font-weight: 700;
            color: #0d1b3e;
        }

        .modal-close {
            background: #f1f5f9;
            border: none;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            cursor: pointer;
            font-size: 15px;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-close:hover {
            background: #e2e8f0;
        }

        .modal-body {
            padding: 16px 22px 22px;
        }

        .modal-field {
            margin-bottom: 14px;
        }

        .modal-label {
            font-size: 11px;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: 4px;
        }

        .modal-value {
            font-size: 14px;
            font-weight: 500;
            color: #1e293b;
        }

        .modal-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .badge-meeting {
            background: #dbeafe;
            color: #1e40af;
        }

        .badge-expiry {
            background: #fee2e2;
            color: #b91c1c;
        }

        .badge-renewal {
            background: #dcfce7;
            color: #15803d;
        }

        .badge-mobility {
            background: #fef9c3;
            color: #92400e;
        }

        .modal-actions {
            display: flex;
            gap: 8px;
            padding: 0 22px 22px;
        }

        .modal-btn {
            flex: 1;
            padding: 9px;
            border-radius: 10px;
            border: none;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .modal-btn.primary {
            background: #1e3a8a;
            color: #fff;
        }

        .modal-btn.primary:hover {
            background: #1e40af;
        }

        .modal-btn.secondary {
            background: #f1f5f9;
            color: #334155;
        }

        .modal-btn.secondary:hover {
            background: #e2e8f0;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 5px;
        }

        .form-input,
        .form-select,
        .form-textarea {
            width: 100%;
            padding: 9px 12px;
            border: 1.5px solid #d8e2f0;
            border-radius: 10px;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            color: #1e293b;
            background: #f8faff;
            outline: none;
            transition: border .2s;
        }

        .form-input:focus,
        .form-select:focus,
        .form-textarea:focus {
            border-color: #1e3a8a;
        }

        .form-textarea {
            resize: vertical;
            min-height: 70px;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        /* Institution combobox in add-modal */
        .add-inst-wrap {
            position: relative;
        }

        .add-inst-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            background: #fff;
            border: 1.5px solid #d8e2f0;
            border-radius: 10px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, .1);
            z-index: 200;
            max-height: 220px;
            overflow-y: auto;
            padding: 4px 0;
        }

        .add-inst-dropdown.open {
            display: block;
        }

        .add-inst-group {
            padding: 5px 12px 2px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #94a3b8;
        }

        .add-inst-opt {
            padding: 7px 14px;
            font-size: 12.5px;
            color: #1e293b;
            cursor: pointer;
            transition: background .12s;
        }

        .add-inst-opt:hover,
        .add-inst-opt.focused {
            background: #eff6ff;
            color: #1e3a8a;
        }

        .add-inst-opt.picked {
            background: #eff6ff;
            color: #1e3a8a;
            font-weight: 600;
        }

        .add-inst-opt.picked::after {
            content: '✓';
            margin-left: auto;
            font-size: 11px;
        }

        .add-inst-opt {
            display: flex;
            justify-content: space-between;
        }

        .add-inst-empty {
            padding: 10px 14px;
            font-size: 12px;
            color: #94a3b8;
        }

        /* Tag chips */
        .inst-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            padding: 4px 0 0;
            min-height: 0;
            margin-bottom: 6px;
        }

        .inst-tag {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: #dbeafe;
            color: #1e3a8a;
            border-radius: 20px;
            padding: 3px 10px 3px 9px;
            font-size: 11.5px;
            font-weight: 600;
        }

        .inst-tag-x {
            cursor: pointer;
            font-size: 10px;
            opacity: .7;
            line-height: 1;
        }

        .inst-tag-x:hover {
            opacity: 1;
        }
    </style>
</head>

