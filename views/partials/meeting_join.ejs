<%# Join control for a calendar meeting the signed-in user is invited to. Shared by
    the Administrator/CIRL Staff/College Dean calendar (administrator/calendar.ejs)
    and the Partner calendar (potential_partner/partner_calendar.ejs) so there is one
    implementation. A page shows it by calling MeetingJoin.render(eventId, event.myInvite).
    The control only exists while the meeting is on (start ≤ now < end): before the start and
    after the end there is no Join button at all, and it appears by itself the moment the
    meeting starts. Clicking it records the attendance and sends the person to the meeting's
    Google Meet room. The button is only a convenience: the server enforces both bounds, records
    the server's clock (never this page's) and is the one that hands out the Meet link. %>
<div id="mj-block" class="d-none mb-3">
    <div class="d-flex align-items-start">
        <div class="flex-shrink-0 me-3"><i class="ri-user-follow-line text-muted fs-16"></i></div>
        <div class="flex-grow-1">
            <h6 class="fw-semibold mb-2"><span class="badge bg-info-subtle text-info" id="mj-badge">You're invited</span></h6>
            <button type="button" class="btn btn-success btn-sm" id="mj-btn">
                <i class="ri-video-chat-line align-bottom me-1"></i><span id="mj-btn-label">Join</span>
            </button>
            <div class="text-muted fs-12 mt-2" id="mj-hint" aria-live="polite"></div>
        </div>
    </div>
</div>
<script>
window.MeetingJoin = (function () {
    var state = null, timer = null, busy = false, joinedListener = null;
    function el(id) { return document.getElementById(id); }

    // The server's "now", as best the browser can tell: the device clock shifted by
    // the difference measured against the server when the event was loaded.
    function serverNow() { return Date.now() + state.offset; }

    // Only a real Google Meet address is ever opened, whatever the server sends.
    function isMeetLink(u) { return typeof u === 'string' && /^https:\/\/meet\.google\.com\//.test(u); }

    function setVisible(on) { el('mj-block').classList.toggle('d-none', !on); }

    // Is the meeting on right now, by the server's clock?
    function isOn() {
        if (!state || state.startsMs === null) return false;
        var now = serverNow();
        return now >= state.startsMs && (state.endsMs === null || now < state.endsMs);
    }

    function paint() {
        if (!state) return;
        // Not on yet, or already over: no Join button. The timer keeps running, so the control shows itself the
        // moment the meeting starts (and goes away again when it ends).
        if (!isOn()) { setVisible(false); return; }
        setVisible(true);
        var btn = el('mj-btn'), label = el('mj-btn-label'), hint = el('mj-hint'), badge = el('mj-badge');
        btn.disabled = busy;
        if (state.joined) {
            badge.className = 'badge bg-success-subtle text-success';
            badge.textContent = 'Joined';
            label.textContent = 'Open Google Meet';
            if (!state.message) hint.textContent = 'You joined at ' + state.joinedAtDisplay + ' (' + state.timeZone + ').';
        } else {
            badge.className = 'badge bg-info-subtle text-info';
            badge.textContent = "You're invited";
            label.textContent = 'Join';
            if (!state.message) hint.textContent = 'The meeting is on. Join to open Google Meet and record your attendance.';
        }
    }

    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    function hide() { stop(); state = null; setVisible(false); }

    function load(invite) {
        state = {
            joined: !!invite.joined,
            joinedAtDisplay: invite.joinedAtDisplay,
            timeZone: invite.timeZone || '',
            startsMs: invite.startsAt ? Date.parse(invite.startsAt) : null,
            endsMs: invite.endsAt ? Date.parse(invite.endsAt) : null,
            offset: invite.serverNow ? Date.parse(invite.serverNow) - Date.now() : 0,
            message: ''
        };
    }

    function render(eventId, invite) {
        stop();
        if (!invite || !invite.invited) { hide(); return; }
        load(invite);
        state.eventId = eventId;
        el('mj-hint').textContent = '';
        paint();
        timer = setInterval(paint, 1000);
    }

    function join() {
        if (!state || busy || !isOn()) return;
        // Open the tab NOW, while the click still counts as a user gesture — browsers block a window opened after a
        // network round trip. It is pointed at Google Meet once the server has recorded the join.
        var tab = null;
        try { tab = window.open('', '_blank'); if (tab) tab.opener = null; } catch (e) { tab = null; }
        function closeTab() { try { if (tab) tab.close(); } catch (e) { /* already gone */ } }
        busy = true; state.message = ''; paint();
        fetch('/api/calendarevents/' + encodeURIComponent(state.eventId) + '/join', { method: 'POST' })
            .then(function (r) { return r.json().then(function (data) { return { status: r.status, data: data }; }); })
            .then(function (res) {
                if (res.data && res.data.success) {
                    var eventId = state.eventId;
                    load(res.data.myInvite); state.eventId = eventId;
                    if (joinedListener) joinedListener(res.data.myInvite);
                    if (isMeetLink(res.data.meetLink)) {
                        if (tab) tab.location.href = res.data.meetLink;   // the new tab
                        else window.location.href = res.data.meetLink;    // pop-up blocked: go there in this tab
                        tab = null;
                    } else {
                        closeTab();
                        state.message = 'no-meet';
                        el('mj-hint').textContent = 'Your attendance is recorded, but this meeting has no Google Meet link. Ask the organizer for the meeting link.';
                    }
                } else if (res.data && res.data.code === 'MEETING_NOT_STARTED') {
                    // Our clock said "started" but the server's says not yet — trust the server and re-sync.
                    closeTab();
                    state.startsMs = Date.parse(res.data.startsAt);
                    state.offset = Date.parse(res.data.serverNow) - Date.now();
                    state.message = '';
                } else if (res.data && res.data.code === 'MEETING_ENDED') {
                    // The meeting is over on the server's clock: the control goes away.
                    closeTab();
                    state.endsMs = Date.parse(res.data.endsAt);
                    state.offset = Date.parse(res.data.serverNow) - Date.now();
                    state.message = '';
                } else {
                    closeTab();
                    state.message = 'error';
                    el('mj-hint').textContent = (res.data && res.data.error) || 'Could not record your attendance.';
                }
            })
            .catch(function () { closeTab(); state.message = 'error'; el('mj-hint').textContent = 'Could not reach the server. Try again.'; })
            .then(function () { busy = false; paint(); });
    }

    document.addEventListener('DOMContentLoaded', function () { el('mj-btn').addEventListener('click', join); });
    return { render: render, hide: hide, stop: stop, onJoined: function (fn) { joinedListener = fn; } };
})();
</script>
