<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <%- include('../partials/ui-state-init') %>
    <title>Requests | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <!-- Shared Country option list (same one the Registry and the Reports Custom Report Builder use). -->
    <script src="/velzon/assets/js/shared/country-options.js"></script>
    <style>
        /* ── Country searchable dropdown (same look as reports.ejs's Custom Report Builder filter) ── */
        .cr-country-wrap { position: relative; }
        .cr-country-dropdown {
            position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 20;
            background: #fff; border: 1px solid #dfe3ea; border-radius: 8px;
            box-shadow: 0 10px 28px rgba(20,25,45,.14); max-height: 220px; overflow-y: auto; padding: 6px;
            display: none;
        }
        .cr-country-option { padding: 8px 10px; border-radius: 6px; font-size: .85rem; color: #313a46; cursor: pointer; }
        .cr-country-option:hover { background: #f0f2fb; color: #405189; }
        .cr-country-empty { padding: 10px; font-size: .8rem; color: #878a99; text-align: center; }
        [data-bs-theme="dark"] .cr-country-dropdown { background: #2a2f3c; border-color: #3a4053; box-shadow: 0 10px 28px rgba(0,0,0,.4); }
        [data-bs-theme="dark"] .cr-country-option { color: #d3d5db; }
        [data-bs-theme="dark"] .cr-country-option:hover { background: #363c4c; color: #a9bcf5; }

        /* ── Section Switcher Tabs (same convention as administrator/partnership_requests.ejs) ── */
        .section-tabs { display: flex; gap: .5rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
        .section-tab {
            padding: .45rem 1.15rem; border-radius: 20px; font-size: .82rem; font-weight: 600;
            cursor: pointer; border: 2px solid transparent; transition: all .18s;
            display: flex; align-items: center; gap: .4rem; background: #f3f4fa; color: #495057;
        }
        .section-tab:hover { background: #e8eaf6; color: #405189; }
        .section-tab.active { background: #405189; color: #fff; border-color: #405189; }

        /* ── CSPC-F-CIRL-04 "Documents Request Form" — styled to resemble the
           official paper form (bordered label/value rows) instead of a generic
           Bootstrap two-column grid. ── */
        .dr-form-header {
            display: flex; align-items: center; gap: 12px;
            padding-bottom: 14px; margin-bottom: 4px; border-bottom: 3px solid #405189;
        }
        .dr-form-header img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
        .dr-form-header .dr-form-title { font-weight: 700; color: #405189; font-size: 1rem; margin: 0; letter-spacing: .3px; }
        .dr-form-header .dr-form-subtitle { font-size: .75rem; color: #878a99; margin: 0; }
        .dr-form-header .dr-form-code { margin-left: auto; font-size: .72rem; font-weight: 700; color: #405189; text-align: right; }

        .dr-form-table { border: 1px solid #dfe3ea; border-radius: 6px; overflow: hidden; margin-top: 16px; }
        .dr-row { display: flex; border-bottom: 1px solid #dfe3ea; }
        .dr-row:last-child { border-bottom: none; }
        .dr-label {
            flex: 0 0 230px; background: #f8f9fb; font-weight: 600; font-size: .78rem;
            text-transform: uppercase; letter-spacing: .3px; color: #495057;
            padding: 12px 16px; display: flex; align-items: center; border-right: 1px solid #dfe3ea;
        }
        .dr-value { flex: 1; padding: 10px 16px; display: flex; align-items: center; min-width: 0; }
        .dr-row-tall .dr-value { align-items: flex-start; padding-top: 12px; }
        .dr-readonly {
            color: #313a46; font-weight: 500; font-size: .875rem;
            background: #fbfbfc; border: 1px dashed #dfe3ea; border-radius: 4px;
            padding: 6px 10px; width: 100%;
        }
        .dr-readonly small { display: block; color: #878a99; font-weight: 400; font-size: .68rem; margin-top: 2px; }
        .dr-value .form-control, .dr-value .form-select { font-size: .875rem; }
        .dr-radio-group { display: flex; flex-wrap: wrap; gap: 10px 28px; }
        .dr-radio { display: flex; align-items: center; gap: 6px; font-size: .875rem; font-weight: 500; color: #495057; cursor: pointer; margin: 0; }
        .dr-radio input { width: 16px; height: 16px; cursor: pointer; }

        @media (max-width: 576px) {
            .dr-row { flex-direction: column; }
            .dr-label { border-right: none; border-bottom: 1px solid #dfe3ea; flex: 1 1 auto; }
            .dr-form-header { flex-wrap: wrap; }
            .dr-form-header .dr-form-code { margin-left: 0; text-align: left; }
        }

        /* ── "Document(s) Requested" combobox — searchable multi-select with
           removable chips + free-text custom entries (2026-09-02). ── */
        .doc-combo { width: 100%; }
        .doc-combo-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
        .doc-combo-chips:empty { display: none; }
        .doc-chip {
            display: inline-flex; align-items: center; gap: 6px;
            background: #e7ebfa; color: #405189; border: 1px solid #c9d2f5;
            border-radius: 20px; padding: 5px 8px 5px 14px; font-size: .8rem; font-weight: 600;
            max-width: 100%;
        }
        .doc-chip span.doc-chip-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 320px; }
        .doc-chip button {
            border: none; background: rgba(64,81,137,.14); color: #405189; border-radius: 50%;
            width: 18px; height: 18px; line-height: 1; font-size: .85rem; flex-shrink: 0;
            cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0;
        }
        .doc-chip button:hover { background: rgba(64,81,137,.28); }
        .doc-combo-input-wrap { position: relative; }
        .doc-combo-dropdown {
            position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 20;
            background: #fff; border: 1px solid #dfe3ea; border-radius: 8px;
            box-shadow: 0 10px 28px rgba(20,25,45,.14); max-height: 260px; overflow-y: auto; padding: 6px;
        }
        .doc-combo-option {
            padding: 8px 10px; border-radius: 6px; font-size: .85rem; color: #313a46;
            cursor: pointer; display: flex; align-items: center; gap: 8px;
        }
        .doc-combo-option:hover, .doc-combo-option.active { background: #f0f2fb; color: #405189; }
        .doc-combo-option.custom { color: #0ab39c; font-weight: 600; }
        .doc-combo-option .doc-combo-option-hint { margin-left: auto; font-size: .68rem; color: #878a99; text-transform: uppercase; letter-spacing: .3px; }
        .doc-combo-empty { padding: 10px; font-size: .8rem; color: #878a99; text-align: center; }

        [data-bs-theme="dark"] .doc-chip { background: rgba(96,126,224,.18); color: #a9bcf5; border-color: rgba(96,126,224,.35); }
        [data-bs-theme="dark"] .doc-chip button { background: rgba(169,188,245,.18); color: #a9bcf5; }
        [data-bs-theme="dark"] .doc-combo-dropdown { background: #2a2f3c; border-color: #3a4053; box-shadow: 0 10px 28px rgba(0,0,0,.4); }
        [data-bs-theme="dark"] .doc-combo-option { color: #d3d5db; }
        [data-bs-theme="dark"] .doc-combo-option:hover, [data-bs-theme="dark"] .doc-combo-option.active { background: #363c4c; color: #a9bcf5; }
        [data-bs-theme="dark"] .doc-combo-option.custom { color: #4bd1b0; }

        /* ── Dark mode — the rest of this page's custom classes above
           (section tabs, Document Request Form) never got the same
           [data-bs-theme="dark"] treatment as the doc-combo classes above,
           so they stayed hardcoded light. Same dark surface/border/text
           tones used throughout the rest of the app's dark-mode CSS. ── */
        [data-bs-theme="dark"] .section-tab { background: #262d3d; color: #ced4da; }
        [data-bs-theme="dark"] .section-tab:hover { background: #2f3749; color: #7094f5; }
        [data-bs-theme="dark"] .dr-form-header { border-bottom-color: #5a72d4; }
        [data-bs-theme="dark"] .dr-form-header .dr-form-title,
        [data-bs-theme="dark"] .dr-form-header .dr-form-code { color: #7094f5; }
        [data-bs-theme="dark"] .dr-form-table,
        [data-bs-theme="dark"] .dr-row { border-color: rgba(255,255,255,.1); }
        [data-bs-theme="dark"] .dr-label {
            background: #262d3d; color: #ced4da; border-right-color: rgba(255,255,255,.1);
        }
        [data-bs-theme="dark"] .dr-readonly {
            background: #1a1f2b; border-color: rgba(255,255,255,.15); color: #e9ecef;
        }
        @media (max-width: 576px) {
            [data-bs-theme="dark"] .dr-label { border-bottom-color: rgba(255,255,255,.1); }
        }

        @media (max-width: 576px) {
            .doc-chip span.doc-chip-label { max-width: 200px; }
        }
    </style>
</head>
<body>

<div id="layout-wrapper">
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar_partner') %>

    <div class="main-content">
        <div class="page-content">
            <div class="container-fluid">

                <div class="row">
                  <div class="col-12">
                    <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                      <h4 class="mb-sm-0">Requests</h4>
                      <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                          <li class="breadcrumb-item"><a href="/partner/monitoring">CIPRMS</a></li>
                          <li class="breadcrumb-item active">Requests</li>
                        </ol>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Section switcher — Partnership Request / Submission Of MOA/MOU share this page but
                     remain fully independent forms; only one panel is visible at a time. -->
                <div class="section-tabs">
                    <a class="section-tab active" id="tab-pr" href="#" onclick="switchSection('pr');return false;">
                        <i class="ri-building-4-line"></i> Partnership Request
                    </a>
                    <a class="section-tab" id="tab-dr" href="#" onclick="switchSection('dr');return false;">
                        <i class="ri-file-upload-line"></i> Submission Of MOA/MOU
                    </a>
                </div>

                <!-- ═══════════ PANEL: PARTNERSHIP REQUEST ═══════════ -->
                <div id="panel-pr">
                    <div class="card" id="request-form-card">
                        <div class="card-header d-flex align-items-center">
                            <h4 class="card-title mb-0 flex-grow-1" id="form-title">New Partnership Request</h4>
                        </div>
                        <div class="card-body">

                            <!-- OCR auto-fill from a supporting document -->
                            <div class="card border border-primary-subtle mb-4">
                                <div class="card-body">
                                    <h6 class="mb-2"><i class="ri-scan-2-line text-primary me-1"></i>Auto-fill from Document (OCR) — Optional</h6>
                                    <p class="text-muted fs-13 mb-3">Upload a proposal, MOA/MOU draft, or letter of intent (PDF, JPG, or PNG — max 10MB). The system extracts text and suggests values below, and the file itself becomes your request's supporting document attachment.</p>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <input type="file" class="form-control" id="ocr-file-input" accept=".pdf,.jpg,.jpeg,.png" style="max-width:360px">
                                        <button type="button" class="btn btn-primary text-nowrap" onclick="startOcrExtraction()"><i class="ri-magic-line me-1"></i>Extract & Attach</button>
                                    </div>
                                    <div id="ocr-progress-wrap" class="mt-3" style="display:none">
                                        <div class="d-flex justify-content-between fs-12 text-muted mb-1"><span id="ocr-stage-text">Uploading…</span><span id="ocr-percent-text">0%</span></div>
                                        <div class="progress" style="height:6px"><div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" id="ocr-progress-bar" style="width:0%"></div></div>
                                    </div>
                                    <div id="ocr-result-box" class="mt-3" style="display:none">
                                        <span class="badge bg-success-subtle text-success"><i class="ri-checkbox-circle-line me-1"></i>Document attached — form auto-filled below</span>
                                        <button type="button" class="btn btn-sm btn-light ms-2" onclick="applyOcrToForm()">Re-apply suggested values</button>
                                        <div id="ocr-idp-panel" class="mt-3" style="display:none"></div>
                                    </div>
                                    <div id="ocr-error-box" class="alert alert-danger mt-3 mb-0 py-2 fs-13" style="display:none"></div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-6 mb-3">
                                    <label class="form-label" for="f-inst">Institution Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="f-inst">
                                </div>
                                <div class="col-lg-6 mb-3">
                                    <label class="form-label" for="f-country">Country <span class="text-danger">*</span></label>
                                    <div class="cr-country-wrap">
                                        <input type="text" class="form-control" id="f-country" placeholder="Select or search a country" autocomplete="off" role="combobox" aria-expanded="false" aria-haspopup="listbox">
                                        <div class="cr-country-dropdown" id="f-country-dropdown" role="listbox"></div>
                                    </div>
                                </div>
                                <div class="col-lg-4 mb-3">
                                    <label class="form-label" for="f-type">Agreement Type <span class="text-danger">*</span></label>
                                    <select class="form-select" id="f-type">
                                        <option value="">Select…</option>
                                        <option>MOA</option><option>MOU</option>
                                    </select>
                                    <div class="form-text text-warning fs-12" id="f-type-warn" style="display:none"></div>
                                </div>
                                <div class="col-lg-4 mb-3">
                                    <label class="form-label" for="f-nature">Nature of Partnership <span class="text-danger">*</span></label>
                                    <select class="form-select" id="f-nature">
                                        <option value="">Select…</option>
                                        <option>Research</option><option>Student Exchange</option><option>Joint Program</option>
                                        <option>Faculty Development</option><option>Technology Transfer</option><option>Community Outreach</option><option>Other</option>
                                    </select>
                                </div>
                                <div class="col-lg-4 mb-3">
                                    <label class="form-label" for="f-cat">Category</label>
                                    <select class="form-select" id="f-cat">
                                        <option value="">Select…</option>
                                        <option value="International">International</option>
                                        <option value="Local">Local</option>
                                    </select>
                                </div>
                                <div class="col-lg-4 mb-3">
                                    <label class="form-label" for="f-region">Region</label>
                                    <select class="form-select" id="f-region">
                                        <option value="">Select…</option>
                                        <option>Asia</option><option>Africa</option><option>North America</option><option>South America</option><option>Antarctica</option><option>Europe</option><option>Oceania</option>
                                    </select>
                                </div>
                                <div class="col-lg-4 mb-3">
                                    <label class="form-label" for="f-unit">Responsible CSPC Unit</label>
                                    <select class="form-select" id="f-unit">
                                        <option value="">Select…</option>
                                        <option>CCS</option><option>CILS</option><option>CETE</option><option>CNAS</option><option>CAMS</option><option>CIRL</option>
                                    </select>
                                </div>
                                <div class="col-lg-4 mb-3">
                                    <label class="form-label" for="f-start">Proposed Start Date</label>
                                    <input type="date" class="form-control" id="f-start">
                                </div>
                                <div class="col-lg-4 mb-3">
                                    <label class="form-label" for="f-end">Proposed End Date</label>
                                    <input type="date" class="form-control" id="f-end">
                                </div>
                                <div class="col-12 mb-3">
                                    <label class="form-label" for="f-notes">Additional Details</label>
                                    <textarea class="form-control" id="f-notes" rows="4"></textarea>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-success" onclick="submitRequest(this)"><i class="ri-send-plane-line me-1"></i>Submit Request</button>
                            </div>
                        </div>
                    </div>
                    <p class="text-muted fs-13"><i class="ri-information-line me-1"></i>Track the status of everything you've submitted on the <a href="/partner/monitoring">Monitoring</a> page.</p>
                </div>

                <!-- ═══════════ PANEL: SUBMISSION OF MOA/MOU ═══════════ -->
                <div id="panel-dr" style="display:none">
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="dr-form-header">
                                <img src="/images/cirl-logo.jpg" alt="CSPC-CIRL">
                                <div>
                                    <p class="dr-form-title">Submission Of MOA/MOU</p>
                                    <p class="dr-form-subtitle">Center for International Relations and Linkages — CSPC</p>
                                </div>
                            </div>
                            <p class="text-muted fs-13 mt-2 mb-0">Send CSPC-CIRL your MOA/MOU files, images and notes. Attach a file or image, write a note, or do both — a file is optional. To propose a new partnership, use Partnership Request instead.</p>
                            <form id="drForm" onsubmit="return false;">
                                <div class="dr-form-table">
                                    <div class="dr-row">
                                        <div class="dr-label">Submitted By</div>
                                        <div class="dr-value"><div class="dr-readonly"><%= user.name %></div></div>
                                    </div>
                                    <div class="dr-row">
                                        <div class="dr-label">Office / College / Institution <span class="text-danger ms-1">*</span></div>
                                        <div class="dr-value">
                                            <input type="text" class="form-control" id="dr-f-inst">
                                            <small class="text-muted d-none mt-1" id="dr-inst-autofill-hint">Auto-filled from your profile</small>
                                        </div>
                                    </div>
                                    <div class="dr-row">
                                        <div class="dr-label">Date / Time</div>
                                        <div class="dr-value"><div class="dr-readonly" id="dr-datetime-display">—</div></div>
                                    </div>
                                    <div class="dr-row dr-row-tall">
                                        <div class="dr-label">Notes</div>
                                        <div class="dr-value" style="display:block">
                                            <textarea class="form-control" id="dr-f-notes" rows="5" maxlength="2000"></textarea>
                                        </div>
                                    </div>
                                    <div class="dr-row dr-row-tall">
                                        <div class="dr-label">File / Image <span class="text-muted fw-normal ms-1">(optional)</span></div>
                                        <div class="dr-value" style="display:block">
                                            <input type="file" class="form-control" id="dr-f-file" accept=".pdf,.jpg,.jpeg,.png">
                                            <small class="text-muted d-block mt-2">PDF, JPG, JPEG or PNG — max 10MB. You can submit notes only, a file/image only, or both.</small>
                                        </div>
                                    </div>
                                    <div class="dr-row">
                                        <div class="dr-label">Email Address</div>
                                        <div class="dr-value"><div class="dr-readonly"><%= user.email %></div></div>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end gap-2 mt-4">
                                    <button type="button" class="btn btn-light px-4" onclick="resetDocRequestForm()">Clear</button>
                                    <button type="button" class="btn btn-success px-5 fw-bold" id="dr-submit-btn" onclick="submitMoaMou()">
                                        Submit
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <p class="text-muted fs-13"><i class="ri-information-line me-1"></i>Your submission is sent to CSPC-CIRL for review.</p>
                </div>

            </div>
        </div>

        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6"><script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL</div>
                    <div class="col-sm-6"><div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div></div>
                </div>
            </div>
        </footer>
    </div>
</div>

<!-- Toast (shared by both panels) -->
<div id="reg-toast" style="display:none;position:fixed;bottom:20px;right:20px;z-index:9999" class="alert alert-dark shadow-lg align-items-center">
    <span id="reg-toast-msg"></span>
</div>

<script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
<script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
<script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
<script src="/velzon/assets/js/app.js"></script>
<script src="/velzon/assets/js/pages/idp-ocr-widget.js"></script>
<script>
    /* ─── SECTION SWITCHER ─── */
    function switchSection(sec) {
        document.getElementById('panel-pr').style.display = sec === 'pr' ? '' : 'none';
        document.getElementById('panel-dr').style.display = sec === 'dr' ? '' : 'none';
        document.getElementById('tab-pr').classList.toggle('active', sec === 'pr');
        document.getElementById('tab-dr').classList.toggle('active', sec === 'dr');
    }

    function showToast(msg) {
        var t = document.getElementById('reg-toast');
        document.getElementById('reg-toast-msg').textContent = msg;
        t.style.display = 'flex';
        setTimeout(function () { t.style.display = 'none'; }, 3500);
    }

    /* ═══════════════════════════════════════════════════
       PARTNERSHIP REQUEST (unchanged from the previous
       standalone page — same fields, same /api/requests
       endpoints, same OCR auto-fill and draft-resume logic)
       ═══════════════════════════════════════════════════ */
    var myRequests = [];
    var editingId = null;
    var ocrExtractedResult = null;

    function loadHistory() {
        return CIPRMS.api('/api/requests/mine', { quiet: true }).then(function (res) {
            if (res.ok && Array.isArray(res.data)) myRequests = res.data;
        });
    }

    function resetForm() {
        editingId = null;
        ['f-inst', 'f-country', 'f-notes'].forEach(function (id) { document.getElementById(id).value = ''; });
        ['f-type', 'f-nature', 'f-cat', 'f-region', 'f-unit'].forEach(function (id) { document.getElementById(id).value = ''; });
        document.getElementById('f-start').value = '';
        document.getElementById('f-end').value = '';
        document.getElementById('f-country').classList.remove('is-invalid');
        ocrExtractedResult = null;
        document.getElementById('ocr-file-input').value = '';
        document.getElementById('ocr-progress-wrap').style.display = 'none';
        document.getElementById('ocr-result-box').style.display = 'none';
        document.getElementById('ocr-error-box').style.display = 'none';
        document.getElementById('ocr-idp-panel').style.display = 'none';
        document.getElementById('f-type-warn').style.display = 'none';
    }

    function openNewRequestForm() {
        resetForm();
        document.getElementById('form-title').textContent = 'New Partnership Request';
    }

    function editDraft(id) {
        var r = myRequests.find(function (x) { return x.id === id; });
        if (!r) return;
        resetForm();
        editingId = id;
        document.getElementById('form-title').textContent = 'Edit Draft Request';
        document.getElementById('f-inst').value = r.institution || '';
        document.getElementById('f-country').value = r.country || '';
        document.getElementById('f-type').value = r.type || '';
        document.getElementById('f-nature').value = r.nature || '';
        document.getElementById('f-cat').value = r.category || '';
        document.getElementById('f-region').value = r.region || '';
        document.getElementById('f-unit').value = r.unit || '';
        document.getElementById('f-start').value = r.startDate || '';
        document.getElementById('f-end').value = r.endDate || '';
        document.getElementById('f-notes').value = r.notes || '';
    }

    function collectFormData() {
        return {
            institution: document.getElementById('f-inst').value.trim(),
            country: document.getElementById('f-country').value.trim(),
            type: document.getElementById('f-type').value,
            nature: document.getElementById('f-nature').value,
            category: document.getElementById('f-cat').value,
            region: document.getElementById('f-region').value,
            unit: document.getElementById('f-unit').value,
            startDate: document.getElementById('f-start').value,
            endDate: document.getElementById('f-end').value,
            notes: document.getElementById('f-notes').value.trim(),
            attachmentLink: (ocrExtractedResult && ocrExtractedResult.fileLink) || undefined
        };
    }

    // One submission at a time (CIPRMS.busy ignores a double click while the first is in flight), and a draft is only
    // submitted once its edit has actually been saved.
    function submitRequest(btn) {
        var payload = collectFormData();
        if (!payload.institution || !payload.country || !payload.type || !payload.nature) {
            showToast('Institution, country, agreement type, and nature are required to submit.');
            return;
        }
        // Country must be one of the shared COUNTRY_OPTIONS (a typed/OCR value is snapped to its exact
        // spelling when it matches ignoring case), so requests store the same names the Registry and Reports use.
        var country = matchCountryOption(payload.country);
        if (!country) {
            showToast('Please select a country from the list.');
            document.getElementById('f-country').focus();
            return;
        }
        payload.country = country;
        document.getElementById('f-country').value = country;
        return CIPRMS.busy(btn, function () {
            var step;
            if (editingId) {
                var id = editingId;
                step = CIPRMS.api('/api/requests/' + id + '/edit', { method: 'PATCH', json: payload, quiet: true }).then(function (saved) {
                    return saved.ok ? CIPRMS.api('/api/requests/' + id + '/submit', { method: 'POST', quiet: true }) : saved;
                });
            } else {
                payload.isDraft = false;
                step = CIPRMS.api('/api/requests', { method: 'POST', json: payload, quiet: true });
            }
            return step.then(function (res) {
                if (res.ok) { showToast('Request submitted.'); openNewRequestForm(); return loadHistory(); }
                showToast(res.error || 'Failed to submit request.');
            });
        }, 'Submitting…');
    }

    // ── OCR auto-fill (reuses the same /api/ocr endpoints as the Registry module) ──
    function startOcrExtraction() {
        var file = document.getElementById('ocr-file-input').files[0];
        if (!file) { showToast('Choose a file first.'); return; }

        document.getElementById('ocr-error-box').style.display = 'none';
        document.getElementById('ocr-result-box').style.display = 'none';
        document.getElementById('ocr-progress-wrap').style.display = '';
        document.getElementById('ocr-progress-bar').style.width = '0%';

        var formData = new FormData();
        formData.append('document', file);
        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/ocr/extract');
        xhr.upload.addEventListener('progress', function (e) {
            if (!e.lengthComputable) return;
            var pct = Math.round((e.loaded / e.total) * 100);
            document.getElementById('ocr-progress-bar').style.width = pct + '%';
        });
        xhr.onload = function () {
            var data;
            try { data = JSON.parse(xhr.responseText); } catch (e) { data = null; }
            if (xhr.status !== 202 || !data || !data.success) { ocrFail((data && data.error) || 'Failed to start OCR.'); return; }
            document.getElementById('ocr-stage-text').textContent = 'OCR Processing…';
            pollOcrStatus(data.jobId);
        };
        xhr.onerror = function () { ocrFail('Network error while uploading.'); };
        xhr.send(formData);
    }

    function pollOcrStatus(jobId) {
        fetch('/api/ocr/status/' + jobId).then(function (r) { return r.json(); }).then(function (data) {
            if (!data.success) { ocrFail(data.error || 'Job not found.'); return; }
            document.getElementById('ocr-progress-bar').style.width = (data.progress || 0) + '%';
            if (data.status === 'error') { ocrFail(data.error || 'OCR failed.'); return; }
            if (data.status === 'done') { ocrSucceed(data.result); return; }
            setTimeout(function () { pollOcrStatus(jobId); }, 700);
        }).catch(function () { ocrFail('Lost connection while checking OCR progress.'); });
    }

    function ocrFail(message) {
        document.getElementById('ocr-progress-wrap').style.display = 'none';
        var box = document.getElementById('ocr-error-box');
        box.textContent = message;
        box.style.display = '';
    }

    function ocrSucceed(result) {
        ocrExtractedResult = result;
        document.getElementById('ocr-progress-wrap').style.display = 'none';
        document.getElementById('ocr-result-box').style.display = '';
        if (window.IDP) {
            IDP.renderResult('ocr-idp-panel', result, {
                onCancelDuplicate: function (documentId) {
                    if (!documentId) return;
                    fetch('/api/documents/' + documentId + '/organize', {
                        method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ archived: true })
                    }).then(function () { showToast('Upload archived — removed from the active Document Library.'); });
                },
                onViewDuplicate: function (fileLink) { window.open(fileLink, '_blank'); }
            });
        }
        // 2026-07-29: auto-fill immediately — no manual "Apply" click required.
        // applyOcrToForm() only ever sets a field when OCR actually found a
        // value for it, shows its own confirmation toast, and remains safe to
        // re-run from the "Re-apply suggested values" button afterward.
        applyOcrToForm();
    }

    function ocrIsoDate(str) {
        if (!str) return '';
        var d = new Date(str);
        if (isNaN(d.getTime())) return '';
        // Use LOCAL date parts, not toISOString() (which converts to UTC) —
        // a date-only string like "March 3, 2026" parses as local midnight,
        // and toISOString() can roll that back to March 2 in UTC+ timezones.
        var mm = String(d.getMonth() + 1).padStart(2, '0');
        var dd = String(d.getDate()).padStart(2, '0');
        return d.getFullYear() + '-' + mm + '-' + dd;
    }

    function applyOcrToForm() {
        if (!ocrExtractedResult) return;
        var r = ocrExtractedResult;
        var filled = []; // { id, confidence }
        function set(id, value, confidence) {
            if (value === null || value === undefined || value === '') return;
            var el = document.getElementById(id);
            if (!el) return;
            el.value = value;
            filled.push({ id: id, confidence: confidence });
        }

        if (r.institution) set('f-inst', r.partner || r.institution, r.institutionConfidence);
        set('f-country', r.country, r.countryConfidence);
        set('f-cat', r.category, r.categoryConfidence);
        set('f-region', r.region, r.regionConfidence);
        set('f-unit', r.unit, r.unitConfidence);
        if (r.nature) set('f-nature', r.nature, r.natureConfidence);

        var typeWarn = document.getElementById('f-type-warn');
        var mappedType = window.IDP ? IDP.mapDocumentType(r.documentType, ['MOA', 'MOU']) : null;
        if (mappedType) {
            set('f-type', mappedType, r.documentTypeConfidence);
            if (typeWarn) typeWarn.style.display = 'none';
        } else if (r.documentType && typeWarn) {
            typeWarn.textContent = 'Detected "' + r.documentType + '" — please select the closest Agreement Type manually.';
            typeWarn.style.display = '';
        }

        var startIso = ocrIsoDate(r.startDate), endIso = ocrIsoDate(r.endDate);
        set('f-start', startIso, r.startDateConfidence);
        set('f-end', endIso, r.endDateConfidence);

        var extras = [];
        if (r.purpose) extras.push('Purpose: ' + r.purpose);
        if (r.objectives) extras.push('Objectives: ' + r.objectives);
        if (r.scope) extras.push('Scope: ' + r.scope);
        if (extras.length) {
            var notesEl = document.getElementById('f-notes');
            notesEl.value = (notesEl.value ? notesEl.value + '\n\n' : '') + '[From OCR] ' + extras.join(' | ');
            filled.push({ id: 'f-notes', confidence: null });
        }

        if (window.IDP) filled.forEach(function (f) { IDP.markFilled(f.id, f.confidence); });
        if (filled.length) {
            var firstEl = document.getElementById(filled[0].id);
            if (firstEl) firstEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        showToast('Suggested values applied — please review before saving.');
    }

    // Clicking "Requests" should land straight in the Partnership Request
    // form — no extra "New Request" click needed. If a draft already exists,
    // resume it instead of opening a blank form (avoids creating a duplicate
    // draft). Request tracking/history now lives entirely on the Monitoring
    // page, so notifications deep-link there instead of here.
    function openFormOnEntry() {
        var draft = myRequests.find(function (r) { return r.status === 'Draft'; });
        if (draft) editDraft(draft.id);
        else openNewRequestForm();
    }

    /* ═══════════════════════════════════════════════════
       SUBMISSION OF MOA/MOU (was the Document Request form) —
       now filed through /api/requests as a Partnership Request, with `dr-` prefixed
       ids/function names so it can coexist on the same page
       as the Partnership Request form above
       ═══════════════════════════════════════════════════ */
    var drAutoInst = ''; // organization pulled from the partner's saved profile, if any

    function setDrDateTimeDisplay() {
        var el = document.getElementById('dr-datetime-display');
        if (el) el.textContent = new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
    }
    setDrDateTimeDisplay();

    // Office/College/Institution auto-fills from the partner's saved profile
    // (organization) when one exists — same /api/partner/profile endpoint the
    // Settings page already uses. Falls back to a normal editable field when
    // no organization has been saved yet.
    fetch('/api/partner/profile').then(function (r) { return r.json(); }).then(function (profile) {
        if (profile && profile.organization) {
            drAutoInst = profile.organization;
            var instEl = document.getElementById('dr-f-inst');
            instEl.value = drAutoInst;
            instEl.readOnly = true;
            document.getElementById('dr-inst-autofill-hint').classList.remove('d-none');
        }
    }).catch(function () { /* profile fetch is a best-effort auto-fill, not required to use the form */ });

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    /* Submission Of MOA/MOU is filed as a PARTNERSHIP REQUEST (reviewers handle it under Partnership
       Requests/Submission, and the partner tracks it on Monitoring), not a Document Request:
         POST /api/requests { isSubmission: true }  creates the submission (institution + notes) and notifies the reviewers
         POST /api/requests/:id/documents           attaches the file/image through the normal secure upload +
                                                    Document Library archive (`initial` marks it as part of the
                                                    submission itself, so it is not treated as a revised draft).
       Accepted: notes only, a file/image only, or both. */
    var MOA_MAX_BYTES = 10 * 1024 * 1024;
    var moaPendingId = null; // a submission that was created but whose file upload failed — Submit then retries ONLY the upload

    function resetDocRequestForm() {
        document.getElementById('dr-f-inst').value = drAutoInst;
        document.getElementById('dr-f-notes').value = '';
        document.getElementById('dr-f-file').value = '';
        moaPendingId = null;
        document.querySelectorAll('#panel-dr .is-invalid').forEach(function (el) { el.classList.remove('is-invalid'); });
    }

    function moaFileProblem(file) {
        if (!file) return '';
        if (file.size > MOA_MAX_BYTES) return 'That file is too large. The maximum size is 10MB.';
        if (!/\.(pdf|jpe?g|png)$/i.test(file.name)) return 'Only PDF, JPG, JPEG or PNG files are accepted.';
        return '';
    }

    function submitMoaMou() {
        var inst = document.getElementById('dr-f-inst').value.trim();
        var notes = document.getElementById('dr-f-notes').value.trim();
        var fileEl = document.getElementById('dr-f-file');
        var file = fileEl.files[0] || null;

        document.querySelectorAll('#panel-dr .is-invalid').forEach(function (el) { el.classList.remove('is-invalid'); });
        if (!inst) { showToast('Please enter your office / college / institution.'); document.getElementById('dr-f-inst').classList.add('is-invalid'); return; }
        if (!notes && !file && !moaPendingId) { showToast('Add a note, attach a file or image, or both.'); return; }
        var problem = moaFileProblem(file);
        if (problem) { showToast(problem); fileEl.classList.add('is-invalid'); return; }

        var btn = document.getElementById('dr-submit-btn');
        var orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="ri-loader-4-line me-2"></i>Submitting...';

        var create = moaPendingId
            ? Promise.resolve(moaPendingId)
            : CIPRMS.api('/api/requests', {
                method: 'POST', json: { institution: inst, notes: notes, isSubmission: true }, quiet: true
            }).then(function (res) {
                if (!res.ok) throw new Error(res.error || 'Error submitting.');
                return res.data.request.id;
            });

        create.then(function (id) {
            if (!file) return id; // notes only — nothing to upload
            var fd = new FormData();
            fd.append('document', file);
            fd.append('initial', '1');
            return CIPRMS.api('/api/requests/' + id + '/documents', { method: 'POST', body: fd, quiet: true }).then(function (res) {
                if (!res.ok) { var err = new Error(res.error || 'Upload failed.'); err.uploadStep = true; err.requestId = id; throw err; }
                return id;
            });
        }).then(function () {
            showToast('Submission sent to CSPC-CIRL!');
            resetDocRequestForm();
        }).catch(function (e) {
            if (e && e.uploadStep) {
                moaPendingId = e.requestId;
                showToast('Your notes were received, but the file could not be uploaded: ' + e.message + ' Click Submit to try the file again.');
            } else {
                showToast((e && e.message) || 'Error submitting.');
            }
        }).then(function () {
            btn.disabled = false;
            btn.innerHTML = orig;
        });
    }

    // ── Country — searchable dropdown over the shared COUNTRY_OPTIONS list ──────────
    // Same behaviour as reports.ejs's initCustomReportCountrySearch(): #f-country stays a plain <input>
    // (so drafts, OCR auto-fill and collectFormData() keep working unchanged) with a type-to-filter
    // dropdown on top. Matching is substring-anywhere and case-insensitive.
    function matchCountryOption(raw) {
        var q = String(raw || '').trim().toLowerCase();
        if (!q || typeof COUNTRY_OPTIONS === 'undefined') return null;
        return COUNTRY_OPTIONS.find(function (c) { return c.toLowerCase() === q; }) || null;
    }

    function initCountrySearch() {
        var input = document.getElementById('f-country');
        var dropdown = document.getElementById('f-country-dropdown');
        if (!input || !dropdown || typeof COUNTRY_OPTIONS === 'undefined') return;
        var blurTimer = null;

        function closeDropdown() {
            dropdown.style.display = 'none';
            dropdown.innerHTML = '';
            input.setAttribute('aria-expanded', 'false');
        }
        function selectValue(val) {
            input.value = val;
            input.classList.remove('is-invalid');
            closeDropdown();
        }
        function openDropdown() {
            if (blurTimer) { clearTimeout(blurTimer); blurTimer = null; }
            var q = input.value.trim().toLowerCase();
            // An exact pick (e.g. just selected, or a resumed draft) shows the full list again on reopen.
            var matches = (q && !matchCountryOption(q)) ? COUNTRY_OPTIONS.filter(function (c) { return c.toLowerCase().indexOf(q) !== -1; }) : COUNTRY_OPTIONS;
            dropdown.innerHTML = matches.length
                ? matches.map(function (c) { return '<div class="cr-country-option" data-val="' + escapeHtml(c) + '">' + escapeHtml(c) + '</div>'; }).join('')
                : '<div class="cr-country-empty">No matching country.</div>';
            dropdown.style.display = 'block';
            input.setAttribute('aria-expanded', 'true');
            dropdown.querySelectorAll('.cr-country-option').forEach(function (opt) {
                opt.addEventListener('mousedown', function (e) { e.preventDefault(); selectValue(opt.getAttribute('data-val')); });
            });
        }

        input.addEventListener('focus', openDropdown);
        input.addEventListener('click', openDropdown);
        input.addEventListener('input', openDropdown);
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                var q = input.value.trim().toUpperCase();
                var match = COUNTRY_OPTIONS.find(function (c) { return c.toUpperCase() === q; }) || COUNTRY_OPTIONS.find(function (c) { return c.toUpperCase().indexOf(q) === 0; });
                if (match) selectValue(match);
            } else if (e.key === 'Escape' && dropdown.style.display === 'block') {
                e.stopPropagation();
                closeDropdown();
            }
        });
        input.addEventListener('blur', function () {
            blurTimer = setTimeout(function () {
                closeDropdown();
                // Snap a case-only difference to the list's spelling; flag anything not on the list.
                var match = matchCountryOption(input.value);
                if (match) input.value = match;
                input.classList.toggle('is-invalid', !!input.value.trim() && !match);
            }, 120);
        });
        document.addEventListener('click', function (e) {
            if (e.target !== input && !dropdown.contains(e.target)) closeDropdown();
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        initCountrySearch();
        // A notification about a MOA/MOU submission lands here on its tab: /partner/requests?tab=dr
        if (new URLSearchParams(window.location.search).get('tab') === 'dr') switchSection('dr');
        loadHistory().then(openFormOnEntry);
    });
</script>
</body>
</html>
