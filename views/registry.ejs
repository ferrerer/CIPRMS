<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Partnership Registry — CSPC-CIRL</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #eef2f9;
      color: #1a1a2e;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .top-header {
      background: #fff;
      border-bottom: 1px solid #e2e8f0;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 22px 0 18px;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .header-logo {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      object-fit: cover;
    }

    .header-title {
      font-size: 19px;
      font-weight: 700;
      color: #0d1b3e;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .add-btn-hdr {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 7px 16px;
      background: #1e3a8a;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }

    .add-btn-hdr:hover {
      background: #1e40af;
    }

    .layout {
      display: flex;
      margin-top: 64px;
      height: calc(100vh - 64px);
    }

    .sidebar {
      width: 62px;
      background: #fff;
      border-right: 1px solid #e2e8f0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px 0 14px;
      position: fixed;
      left: 0;
      top: 64px;
      bottom: 0;
      z-index: 50;
    }

    .sidebar-top-icons {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2px;
      flex: 1;
    }

    .sidebar-icon {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      cursor: pointer;
      color: #64748b;
      font-size: 17px;
      transition: all .2s;
      text-decoration: none;
    }

    .sidebar-icon:hover {
      background: #f1f5f9;
      color: #1e3a5f;
    }

    .sidebar-icon.active {
      background: #e8f0fe;
      color: #1e3a8a;
    }

    .sidebar-bottom {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
    }

    .sidebar-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid #e2e8f0;
      cursor: pointer;
    }

    .main-content {
      margin-left: 62px;
      flex: 1;
      padding: 20px 22px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-height: 0;
    }

    /* Stat mini-cards */
    .stats-mini {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .sm-card {
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 12px;
      padding: 14px 16px;
    }

    .sm-label {
      font-size: 12px;
      font-weight: 600;
      color: #64748b;
    }

    .sm-val {
      font-size: 30px;
      font-weight: 800;
      line-height: 1.1;
    }

    /* Filters */
    .filter-card {
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 12px;
      padding: 14px 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .filter-row {
      display: grid;
      gap: 10px;
      align-items: flex-end;
    }

    .filter-row-1 {
      grid-template-columns: 1fr 130px 130px 130px 130px 130px auto;
    }

    .filter-row-2 {
      grid-template-columns: 130px 130px auto;
    }

    .f-label {
      font-size: 11px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: .5px;
      margin-bottom: 4px;
    }

    .f-input,
    .f-select {
      width: 100%;
      padding: 8px 10px;
      border: 1.5px solid #d8e2f0;
      border-radius: 8px;
      font-size: 13px;
      font-family: 'Inter', sans-serif;
      color: #1e293b;
      background: #f8faff;
      outline: none;
    }

    .f-input:focus,
    .f-select:focus {
      border-color: #1e3a8a;
    }

    .f-btn {
      padding: 9px 18px;
      background: #1e3a8a;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
    }

    .f-btn:hover {
      background: #1e40af;
    }

    .f-btn-clear {
      padding: 9px 14px;
      background: transparent;
      color: #64748b;
      border: 1.5px solid #d8e2f0;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
    }

    .f-btn-clear:hover {
      background: #f1f5f9;
    }

    /* Table */
    .table-card {
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 12px;
      overflow: hidden;
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .table-scroll-wrap {
      flex: 1;
      overflow-y: auto;
      overflow-x: auto;
      min-height: 0;
    }

    .table-scroll-wrap thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      background: #f8faff;
    }

    .tc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 20px 10px;
      border-bottom: 1px solid #e2e8f0;
    }

    .tc-title {
      font-size: 16px;
      font-weight: 700;
      color: #0d1b3e;
    }

    .tc-count {
      font-size: 12px;
      color: #64748b;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead tr {
      background: #f8faff;
    }

    th {
      padding: 10px 14px;
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: .5px;
      border-bottom: 1px solid #e2e8f0;
      white-space: nowrap;
    }

    td {
      padding: 11px 14px;
      font-size: 13px;
      color: #1e293b;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
    }

    tbody tr:hover {
      background: #f8faff;
    }

    tbody tr:last-child td {
      border-bottom: none;
    }

    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
    }

    .badge-active {
      background: #dcfce7;
      color: #15803d;
      border: 1px solid #bbf7d0;
    }

    .badge-expiring {
      background: #fef3c7;
      color: #d97706;
      border: 1px solid #fde68a;
    }

    .badge-expired {
      background: #fee2e2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    .badge-intl {
      background: #dbeafe;
      color: #1e40af;
      border: 1px solid #bfdbfe;
    }

    .badge-local {
      background: #fef9c3;
      color: #854d0e;
      border: 1px solid #fef08a;
    }

    .act-btn {
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      border: 1.5px solid;
      transition: all .15s;
    }

    .act-view {
      background: #1e3a8a;
      color: #fff;
      border-color: #1e3a8a;
    }

    .act-view:hover {
      background: #1e40af;
    }

    .act-edit {
      background: transparent;
      color: #1e3a8a;
      border-color: #1e3a8a;
    }

    .act-edit:hover {
      background: #e8f0fe;
    }

    .act-renew {
      background: #15803d;
      color: #fff;
      border-color: #15803d;
    }

    .act-renew:hover {
      background: #166534;
    }

    .pg-info {
      font-size: 12px;
      color: #64748b;
      padding: 8px 20px;
      border-top: 1px solid #e2e8f0;
      flex-shrink: 0;
    }

    /* Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .45);
      z-index: 999;
      align-items: center;
      justify-content: center;
    }

    .modal-overlay.open {
      display: flex;
    }

    .modal-box {
      background: #fff;
      border-radius: 16px;
      width: 780px;
      max-width: 95vw;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 24px 60px rgba(0, 0, 0, .18);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 24px 14px;
      border-bottom: 1px solid #e2e8f0;
    }

    .modal-title {
      font-size: 17px;
      font-weight: 800;
      color: #0d1b3e;
    }

    .modal-close {
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: #94a3b8;
      line-height: 1;
      padding: 2px 6px;
    }

    .modal-close:hover {
      color: #1e293b;
    }

    .modal-body {
      padding: 20px 24px 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .form-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .form-grid-3 {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 14px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .form-label {
      font-size: 11px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: .4px;
    }

    .form-label span {
      color: #dc2626;
    }

    .form-input,
    .form-select,
    .form-textarea {
      padding: 9px 12px;
      border: 1.5px solid #d8e2f0;
      border-radius: 8px;
      font-size: 13px;
      font-family: 'Inter', sans-serif;
      color: #1e293b;
      background: #f8faff;
      outline: none;
    }

    .form-input:focus,
    .form-select:focus,
    .form-textarea:focus {
      border-color: #1e3a8a;
    }

    .form-textarea {
      resize: vertical;
      min-height: 70px;
    }

    .form-section-label {
      font-size: 12px;
      font-weight: 800;
      color: #1e3a8a;
      text-transform: uppercase;
      letter-spacing: .6px;
      padding-bottom: 4px;
      border-bottom: 2px solid #e8f0fe;
      margin-top: 4px;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding: 14px 24px;
      border-top: 1px solid #e2e8f0;
    }

    .m-btn {
      padding: 9px 20px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      border: none;
    }

    .m-btn.primary {
      background: #1e3a8a;
      color: #fff;
    }

    .m-btn.primary:hover {
      background: #1e40af;
    }

    .m-btn.secondary {
      background: #f1f5f9;
      color: #334155;
      border: 1.5px solid #d8e2f0;
    }

    .m-btn.secondary:hover {
      background: #e2e8f0;
    }

    /* View-detail modal */
    .kv-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .kv-item {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .kv-label {
      font-size: 11px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: .4px;
    }

    .kv-val {
      font-size: 13.5px;
      font-weight: 600;
      color: #1e293b;
    }

    .kv-val a {
      color: #1e3a8a;
      word-break: break-all;
    }

    /* ── Institution Autocomplete ─────────────────────── */
    .ac-wrapper {
      position: relative;
    }

    .ac-spinner {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 13px;
      color: #94a3b8;
      display: none;
      animation: ac-spin 1s linear infinite;
    }

    @keyframes ac-spin {
      to {
        transform: translateY(-50%) rotate(360deg);
      }
    }

    .ac-dropdown {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      right: 0;
      background: #fff;
      border: 1.5px solid #d8e2f0;
      border-radius: 10px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, .12);
      z-index: 1100;
      max-height: 240px;
      overflow-y: auto;
      display: none;
    }

    .ac-dropdown.open {
      display: block;
    }

    .ac-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 14px;
      cursor: pointer;
      border-bottom: 1px solid #f1f5f9;
      transition: background .12s;
    }

    .ac-item:last-child {
      border-bottom: none;
    }

    .ac-item:hover,
    .ac-item.highlighted {
      background: #eff6ff;
    }

    .ac-name {
      font-size: 13px;
      font-weight: 600;
      color: #1e293b;
      flex: 1;
    }

    .ac-country {
      font-size: 11px;
      font-weight: 600;
      color: #64748b;
      background: #f1f5f9;
      border-radius: 20px;
      padding: 2px 8px;
      white-space: nowrap;
    }

    .ac-empty {
      padding: 14px;
      font-size: 13px;
      color: #94a3b8;
      text-align: center;
    }

    .ac-badge-api {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10px;
      font-weight: 700;
      color: #3b82f6;
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 20px;
      padding: 2px 8px;
    }
  </style>
</head>

<body>
  <%- include('partials/header', {
    headerAction: '<button class="add-btn-hdr" onclick="openAddModal()"><i class="fa-solid fa-plus"></i> Add Partnership</button>'
    }) %>
    <div class="layout">
      <%- include('partials/sidebar') %>
        <main class="main-content">
          <div>
            <h1 style="font-size:22px;font-weight:800;color:#0d1b3e;">Partnership Registry</h1>
            <p style="font-size:13px;color:#64748b;margin-top:2px;">Centralized records of all institutional
              partnerships (MOA/MOU)</p>
          </div>

          <!-- STAT MINI CARDS -->
          <div class="stats-mini">
            <div class="sm-card">
              <div class="sm-label">Total</div>
              <div class="sm-val" style="color:#0d1b3e;" id="cnt-total">0</div>
            </div>
            <div class="sm-card">
              <div class="sm-label">Active</div>
              <div class="sm-val" style="color:#15803d;" id="cnt-active">0</div>
            </div>
            <div class="sm-card">
              <div class="sm-label">Expiring Soon</div>
              <div class="sm-val" style="color:#d97706;" id="cnt-expiring">0</div>
            </div>
            <div class="sm-card">
              <div class="sm-label">Expired</div>
              <div class="sm-val" style="color:#b91c1c;" id="cnt-expired">0</div>
            </div>
          </div>

          <!-- FILTERS -->
          <div class="filter-card">
            <div class="filter-row filter-row-1">
              <div>
                <div class="f-label">Search Institution</div>
                <input class="f-input" id="reg-search" placeholder="Institution name or country…"
                  oninput="applyFilter()">
              </div>
              <div>
                <div class="f-label">Type</div>
                <select class="f-select" id="reg-type" onchange="applyFilter()">
                  <option value="">All</option>
                  <option>MOA</option>
                  <option>MOU</option>
                </select>
              </div>
              <div>
                <div class="f-label">Category</div>
                <select class="f-select" id="reg-cat" onchange="applyFilter()">
                  <option value="">All</option>
                  <option>International</option>
                  <option>Local</option>
                </select>
              </div>
              <div>
                <div class="f-label">Status</div>
                <select class="f-select" id="reg-status" onchange="applyFilter()">
                  <option value="">All</option>
                  <option>Active</option>
                  <option>Expiring Soon</option>
                  <option>Expired</option>
                </select>
              </div>
              <div>
                <div class="f-label">Region</div>
                <select class="f-select" id="reg-region" onchange="applyFilter()">
                  <option value="">All</option>
                  <option>Asia</option>
                  <option>Europe</option>
                  <option>Americas</option>
                  <option>Oceania</option>
                  <option>Africa</option>
                  <option>Local</option>
                </select>
              </div>
              <div>
                <div class="f-label">College / Unit</div>
                <select class="f-select" id="reg-unit" onchange="applyFilter()">
                  <option value="">All</option>
                  <option>CCS</option>
                  <option>CILS</option>
                  <option>CETE</option>
                  <option>CNAS</option>
                  <option>CAMS</option>
                  <option>CIRL</option>
                </select>
              </div>
            </div>
            <div class="filter-row filter-row-2" style="border-top:1px solid #f1f5f9;padding-top:10px;">
              <div>
                <div class="f-label">Year Signed</div>
                <select class="f-select" id="reg-yr-signed" onchange="applyFilter()">
                  <option value="">All Years</option>
                  <option>2019</option>
                  <option>2020</option>
                  <option>2021</option>
                  <option>2022</option>
                  <option>2023</option>
                  <option>2024</option>
                  <option>2025</option>
                  <option>2026</option>
                </select>
              </div>
              <div>
                <div class="f-label">Year Expiring</div>
                <select class="f-select" id="reg-yr-exp" onchange="applyFilter()">
                  <option value="">All Years</option>
                  <option>2024</option>
                  <option>2025</option>
                  <option>2026</option>
                  <option>2027</option>
                  <option>2028</option>
                  <option>2029</option>
                  <option>2030</option>
                </select>
              </div>
              <button class="f-btn-clear" onclick="clearFilters()"><i class="fa-solid "></i> Clear
                Filters</button>
            </div>
          </div>

          <!-- TABLE -->
          <div class="table-card">
            <div class="tc-header">
              <span class="tc-title">All Partnerships</span>
              <span class="tc-count" id="reg-count"></span>
            </div>
            <div class="table-scroll-wrap">
              <table>
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Institution</th>
                    <th>Country / Region</th>
                    <th>Type</th>
                    <th>Nature</th>
                    <th>Responsible Unit</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="reg-tbody"></tbody>
              </table>
            </div>
            <span class="pg-info" id="pg-info"></span>
          </div>

        </main>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- ADD PARTNERSHIP MODAL                                   -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div class="modal-overlay" id="add-modal">
      <div class="modal-box">
        <div class="modal-header">
          <span class="modal-title"><i class="fa-solid fa-circle-plus" style="color:#1e3a8a;margin-right:6px;"></i>Add
            New Partnership</span>
          <button class="modal-close" onclick="closeModal('add-modal')">✕</button>
        </div>
        <div class="modal-body">
          <div class="form-section-label">Partner Information</div>
          <div class="form-grid-2">
            <div class="form-group" style="grid-column:1/-1;">
              <label class="form-label">
                Partnership Institution Name <span>*</span>
                <span class="ac-badge-api" style="margin-left:8px;vertical-align:middle;">
                  <i class="fa-solid fa-globe"></i> Worldwide DB
                </span>
              </label>
              <div class="ac-wrapper">
                <input class="form-input" id="f-inst" placeholder="Type to search worldwide universities…"
                  autocomplete="off" oninput="instSearch(this.value)" onkeydown="instKeyNav(event)">
                <i class="fa-solid fa-circle-notch ac-spinner" id="ac-spinner"></i>
                <div class="ac-dropdown" id="ac-dropdown"></div>
              </div>
              <div style="font-size:11px;color:#94a3b8;margin-top:3px;">
                <i class="fa-solid fa-circle-info"></i> Searches 9,000+ institutions worldwide. Country &amp; region
                auto-fill on select.
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Country <span>*</span></label>
              <input class="form-input" id="f-country" placeholder="e.g. Japan">
            </div>
            <div class="form-group">
              <label class="form-label">Region <span>*</span></label>
              <select class="form-select" id="f-region">
                <option value="">Select region…</option>
                <option>Asia</option>
                <option>Europe</option>
