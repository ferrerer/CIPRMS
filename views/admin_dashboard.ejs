<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CIPRMS-CSPC-CIRL</title>
    <link rel="icon" type="image/jpg" href="/images/cirl-logo.jpg">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #eef2f9;
            color: #1a1a2e;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .top-header {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 22px 0 18px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-logo {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
        }

        .header-title {
            font-size: 19px;
            font-weight: 700;
            color: #0d1b3e;
            letter-spacing: -.2px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .layout {
            display: flex;
            margin-top: 64px;
            height: calc(100vh - 64px);
        }

        .sidebar {
            width: 62px;
            background: #fff;
            border-right: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 16px 0 14px;
            position: fixed;
            left: 0;
            top: 64px;
            bottom: 0;
            z-index: 50;
        }

        .sidebar-top-icons {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            flex: 1;
        }

        .sidebar-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            cursor: pointer;
            color: #64748b;
            font-size: 17px;
            transition: all .2s;
            text-decoration: none;
        }

        .sidebar-icon:hover {
            background: #f1f5f9;
            color: #1e3a5f;
        }

        .sidebar-icon.active {
            background: #e8f0fe;
            color: #1e3a8a;
        }

        .sidebar-bottom {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .sidebar-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #e2e8f0;
            cursor: pointer;
        }

        .main-content {
            margin-left: 62px;
            flex: 1;
            padding: 20px 22px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
        }

        .breakdown-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .breakdown-card {
            background: #fff;
            border: 1.5px solid #d8e2f0;
            border-radius: 14px;
            padding: 18px 20px;
        }

        .bc-title {
            font-size: 14px;
            font-weight: 700;
            color: #0d1b3e;
            margin-bottom: 14px;
        }

        .type-bars {
            display: flex;
            gap: 10px;
            align-items: flex-end;
        }

        .type-bar-group {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0;
        }

        .type-bar-val {
            font-size: 18px;
            font-weight: 800;
            color: #0d1b3e;
            margin-bottom: 5px;
            line-height: 1;
        }

        .type-bar-wrap {
            width: 100%;
            height: 56px;
            background: #f1f5f9;
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .type-bar-fill {
            width: 100%;
            border-radius: 8px 8px 0 0;
            transition: height .5s cubic-bezier(.4, 0, .2, 1);
        }

        .type-bar-label {
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            margin-top: 6px;
        }

        .unit-row {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .unit-label {
            width: 42px;
            font-size: 11.5px;
            font-weight: 700;
            color: #334155;
            flex-shrink: 0;
        }

        .unit-track {
            flex: 1;
            height: 10px;
            background: #f1f5f9;
            border-radius: 99px;
            overflow: hidden;
        }

        .unit-fill {
            height: 100%;
            border-radius: 99px;
            background: #1e3a8a;
        }

        .unit-count {
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            flex-shrink: 0;
            width: 20px;
            text-align: right;
        }

        .stat-card {
            background: #fff;
            border: 1.5px solid #d8e2f0;
            border-radius: 14px;
            padding: 16px 18px 14px;
            transition: box-shadow .2s;
        }

        .stat-card:hover {
            box-shadow: 0 4px 16px rgba(0, 0, 0, .07);
        }

        .stat-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .stat-label {
            font-size: 13.5px;
            font-weight: 500;
            color: #64748b;
        }

        .stat-menu-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: #94a3b8;
            font-size: 15px;
            line-height: 1;
            padding: 2px 3px;
            border-radius: 4px;
        }

        .stat-menu-btn:hover {
            background: #f1f5f9;
        }

        .stat-value {
            font-size: 40px;
            font-weight: 700;
            color: #0d1b3e;
            line-height: 1;
            margin-bottom: 10px;
        }

        .stat-footer-label {
            font-size: 11.5px;
            font-weight: 500;
            color: #64748b;
        }

        .stat-footer-label.positive {
            color: #16a34a;
        }

        .stat-footer-label.warn {
            color: #d97706;
        }

        .stat-footer-label.danger {
            color: #dc2626;
        }

        .map-card {
            background: #fff;
            border: 1.5px solid #d8e2f0;
            border-radius: 14px;
            overflow: hidden;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .map-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px 12px;
        }

        .map-card-title {
            font-size: 17px;
            font-weight: 700;
            color: #0d1b3e;
        }

        .map-card-body {
            display: flex;
            flex: 1;
            min-height: 0;
            border-top: 1px solid #e2e8f0;
        }

        .map-left {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            position: relative;
        }

        #partnership-map {
            flex: 1;
            min-height: 300px;
        }

        .continent-tabs {
            position: absolute;
            bottom: 12px;
            left: 12px;
            display: flex;
            align-items: center;
            gap: 5px;
            flex-wrap: wrap;
            z-index: 1000;
            pointer-events: all;
        }

        .continent-tab {
            padding: 5px 12px;
            border-radius: 20px;
            border: 1.5px solid rgba(255, 255, 255, .6);
            background: rgba(255, 255, 255, .88);
            backdrop-filter: blur(6px);
            font-size: 11.5px;
            font-weight: 600;
            color: #334155;
            cursor: pointer;
            transition: all .18s;
            user-select: none;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .12);
        }

        .continent-tab:hover {
            background: rgba(232, 240, 254, .95);
            border-color: #93c5fd;
            color: #1e3a8a;
        }

        .continent-tab.active {
            background: #1e3a8a;
            border-color: #1e3a8a;
            color: #fff;
            box-shadow: 0 2px 8px rgba(30, 58, 138, .35);
        }

        .partner-panel {
            width: 260px;
            flex-shrink: 0;
            border-left: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            padding: 18px 16px 14px;
            overflow-y: auto;
        }

        .pp-title {
            font-size: 13px;
            font-weight: 800;
            color: #0d1b3e;
            margin-bottom: 4px;
        }

        .pp-sub {
            font-size: 11px;
            color: #94a3b8;
            margin-bottom: 16px;
        }

        .pp-item {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            cursor: pointer;
            border-radius: 8px;
            padding: 4px 6px;
            margin-left: -6px;
            transition: background .15s;
        }

        .pp-item:hover {
            background: #f1f5f9;
        }

        .pp-flag {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            flex-shrink: 0;
            border: 1.5px solid #e2e8f0;
        }

        .pp-flag img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .pp-info {
            flex: 1;
            min-width: 0;
        }

        .pp-name {
            font-size: 12px;
            font-weight: 700;
            color: #1e293b;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .pp-count {
            font-size: 11px;
            color: #64748b;
        }

        .pp-track {
            width: 100%;
            height: 4px;
            background: #f1f5f9;
            border-radius: 99px;
            overflow: hidden;
            margin-top: 5px;
        }

        .pp-fill {
            height: 100%;
            border-radius: 99px;
            background: #1e3a8a;
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

        <div class="layout">
            <%- include('partials/sidebar') %>

                <main class="main-content">

                    <section class="stats-row">
                        <!-- Active -->
                        <div class="stat-card">
                            <div class="stat-card-header">
                                <span class="stat-label">Active MOA/MOU</span>
                            </div>
                            <div class="stat-value">37</div>
                            <div class="stat-footer-label positive">
                                <i class="fa-solid fa-circle-check fa-xs"></i> Currently active agreements
                            </div>
                        </div>
                        <!-- Expiring Soon -->
                        <div class="stat-card">
                            <div class="stat-card-header">
                                <span class="stat-label">Expiring Soon</span>
                            </div>
                            <div class="stat-value" style="color:#d97706;">9</div>
                            <div class="stat-footer-label warn">
                                <i class="fa-solid fa-hourglass-half fa-xs"></i> Expiring within 90 days
                            </div>
                        </div>
                        <!-- Expired -->
                        <div class="stat-card">
                            <div class="stat-card-header">
                                <span class="stat-label">Expired MOA/MOU</span>
                            </div>
                            <div class="stat-value" style="color:#dc2626;">5</div>
                            <div class="stat-footer-label danger">
                                <i class="fa-solid fa-circle-xmark fa-xs"></i> Require renewal action
                            </div>
                        </div>
                        <!-- Total -->
                        <div class="stat-card">
                            <div class="stat-card-header">
                                <span class="stat-label">Total MOA/MOU</span>
                            </div>
                            <div class="stat-value">51</div>
                            <div class="stat-footer-label positive">
                                <i class="fa-solid fa-handshake fa-xs"></i> All registered agreements
                            </div>
                        </div>
                    </section>

                    <!-- ── MOA vs MOU & By College/Unit Breakdown ── -->
                    <div class="breakdown-row">
                        <div class="breakdown-card">
                            <div class="bc-title">
                                <i class="fa-solid fa-chart-bar" style="color:#1e3a8a;margin-right:6px;"></i>By Type:
                                MOA &amp; MOU
                            </div>
                            <div class="type-bars">
                                <div class="type-bar-group">
                                    <div class="type-bar-val">32</div>
                                    <div class="type-bar-wrap">
                                        <div class="type-bar-fill" style="height:73%;background:#1e3a8a;"></div>
                                    </div>
                                    <div class="type-bar-label">MOA</div>
                                </div>
                                <div class="type-bar-group">
                                    <div class="type-bar-val">19</div>
                                    <div class="type-bar-wrap">
                                        <div class="type-bar-fill" style="height:43%;background:#3b82f6;"></div>
                                    </div>
                                    <div class="type-bar-label">MOU</div>
                                </div>
                                <div class="type-bar-group">
                                    <div class="type-bar-val" style="color:#15803d;">37</div>
                                    <div class="type-bar-wrap">
                                        <div class="type-bar-fill" style="height:84%;background:#16a34a;"></div>
                                    </div>
                                    <div class="type-bar-label" style="color:#15803d;">Active</div>
                                </div>
                                <div class="type-bar-group">
                                    <div class="type-bar-val" style="color:#d97706;">9</div>
                                    <div class="type-bar-wrap">
                                        <div class="type-bar-fill" style="height:20%;background:#d97706;"></div>
                                    </div>
                                    <div class="type-bar-label" style="color:#d97706;">Expiring</div>
                                </div>
                                <div class="type-bar-group">
                                    <div class="type-bar-val" style="color:#dc2626;">5</div>
                                    <div class="type-bar-wrap">
                                        <div class="type-bar-fill" style="height:11%;background:#dc2626;"></div>
                                    </div>
                                    <div class="type-bar-label" style="color:#dc2626;">Expired</div>
                                </div>
                            </div>
                        </div>
                        <div class="breakdown-card">
                            <div class="bc-title">
                                <i class="fa-solid fa-building-columns" style="color:#1e3a8a;margin-right:6px;"></i>By
                                College / Unit
                            </div>
                            <div>
                                <div class="unit-row">
                                    <div class="unit-label">CIRL</div>
                                    <div class="unit-track">
                                        <div class="unit-fill" style="width:100%;"></div>
                                    </div>
                                    <div class="unit-count">18</div>
                                </div>
                                <div class="unit-row">
                                    <div class="unit-label">CCS</div>
                                    <div class="unit-track">
                                        <div class="unit-fill" style="width:72%;background:#3b82f6;"></div>
                                    </div>
                                    <div class="unit-count">13</div>
                                </div>
                                <div class="unit-row">
                                    <div class="unit-label">CILS</div>
                                    <div class="unit-track">
                                        <div class="unit-fill" style="width:55%;background:#8b5cf6;"></div>
                                    </div>
                                    <div class="unit-count">10</div>
                                </div>
                                <div class="unit-row">
                                    <div class="unit-label">CETE</div>
                                    <div class="unit-track">
                                        <div class="unit-fill" style="width:39%;background:#d97706;"></div>
                                    </div>
                                    <div class="unit-count">7</div>
                                </div>
                                <div class="unit-row">
                                    <div class="unit-label">CNAS</div>
                                    <div class="unit-track">
                                        <div class="unit-fill" style="width:17%;background:#15803d;"></div>
                                    </div>
                                    <div class="unit-count">3</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="map-card">
                        <div class="map-card-header">
                            <h2 class="map-card-title">
                                <i class="fa-solid fa-earth-asia"
                                    style="color:#1e3a8a;margin-right:8px;"></i>Partnerships Geographical Map
                            </h2>
                        </div>
                        <div class="map-card-body">
                            <div class="map-left">
                                <div id="partnership-map"></div>
                                <div class="continent-tabs">
                                    <button class="continent-tab"
                                        onclick="flyToContinent(this, 34, 100, 4)">Asia</button>
                                    <button class="continent-tab"
                                        onclick="flyToContinent(this, 54, 15, 4)">Europe</button>
                                    <button class="continent-tab"
                                        onclick="flyToContinent(this, 38, -97, 4)">Americas</button>
                                    <button class="continent-tab"
                                        onclick="flyToContinent(this, -25, 135, 4)">Oceania</button>
                                    <button class="continent-tab"
                                        onclick="flyToContinent(this, 20, 0, 2)">World</button>
                                </div>
                            </div>

                            <!-- Top Partner Countries panel -->
                            <div class="partner-panel">
                                <div class="pp-title">
                                    <i class="fa-solid fa-earth-americas"
                                        style="color:#1e3a8a;margin-right:6px;"></i>Top Partner Countries
                                </div>
                                <div class="pp-sub">By number of MOA/MOU agreements</div>

                                <% var topPartners=[ { country: 'Japan' , code: 'jp' , count: 12, pct: 100, lat: 36,
                                    lng: 138 }, { country: 'United States' , code: 'us' , count: 9, pct: 75, lat: 38,
                                    lng: -97 }, { country: 'South Korea' , code: 'kr' , count: 7, pct: 58, lat: 37, lng:
                                    127 }, { country: 'Philippines' , code: 'ph' , count: 6, pct: 50, lat: 13, lng: 122
                                    }, { country: 'China' , code: 'cn' , count: 5, pct: 42, lat: 35, lng: 104 }, {
                                    country: 'Australia' , code: 'au' , count: 4, pct: 33, lat: -25, lng: 133 }, {
                                    country: 'Germany' , code: 'de' , count: 3, pct: 25, lat: 51, lng: 10 } ]; %>
                                    <% topPartners.forEach(function(p) { %>
                                        <div class="pp-item"
                                            onclick="flyToContinent(null, <%= p.lat %>, <%= p.lng %>, 5)">
                                            <div class="pp-flag">
                                                <img src="https://flagcdn.com/w80/<%= p.code %>.png"
                                                    alt="<%= p.country %>">
                                            </div>
                                            <div class="pp-info">
                                                <div class="pp-name">
                                                    <%= p.country %>
                                                </div>
                                                <div class="pp-count">
                                                    <%= p.count %> agreements
                                                </div>
                                                <div class="pp-track">
                                                    <div class="pp-fill" style="width:<%= p.pct %>%"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <% }); %>

                            </div>
                        </div>
                    </div>

                </main>
        </div>

        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            // ── Map init ────────────────────────────────────────────────
            const map = L.map('partnership-map', {
                center: [20, 15], zoom: 2,
                zoomControl: true, scrollWheelZoom: true
            });
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/">CARTO</a>',
                subdomains: 'abcd', maxZoom: 19
            }).addTo(map);

            // ── Partnership data ────────────────────────────────────────
            const PARTNERSHIPS = [
                // Philippines (Local)
                { name: 'CSPC - Main Campus', institution: 'Camarines Sur Polytechnic Colleges', lat: 13.6234, lng: 123.1945, country: 'Philippines', type: 'MOA', status: 'active' },
                { name: 'De La Salle University', institution: 'De La Salle University', lat: 14.5627, lng: 120.9930, country: 'Philippines', type: 'MOA', status: 'active' },
                { name: 'Ateneo de Manila University', institution: 'Ateneo de Manila University', lat: 14.6407, lng: 121.0778, country: 'Philippines', type: 'MOA', status: 'active' },
                { name: 'University of Santo Tomas', institution: 'University of Santo Tomas', lat: 14.6096, lng: 120.9895, country: 'Philippines', type: 'MOU', status: 'active' },
                { name: 'Bicol University', institution: 'Bicol University', lat: 13.1391, lng: 123.7438, country: 'Philippines', type: 'MOA', status: 'expiring' },
                { name: 'Partido State University', institution: 'Partido State University', lat: 13.7791, lng: 123.7416, country: 'Philippines', type: 'MOU', status: 'active' },

                // Japan
                { name: 'Osaka University Partnership', institution: 'Osaka University', lat: 34.8219, lng: 135.5235, country: 'Japan', type: 'MOA', status: 'active' },
                { name: 'University of Tokyo MOU', institution: 'University of Tokyo', lat: 35.7127, lng: 139.7613, country: 'Japan', type: 'MOU', status: 'active' },
                { name: 'Kyoto University', institution: 'Kyoto University', lat: 35.0261, lng: 135.7804, country: 'Japan', type: 'MOU', status: 'active' },
                { name: 'Tohoku University', institution: 'Tohoku University', lat: 38.2558, lng: 140.8421, country: 'Japan', type: 'MOA', status: 'expiring' },
                { name: 'Nagoya University', institution: 'Nagoya University', lat: 35.1569, lng: 136.9237, country: 'Japan', type: 'MOA', status: 'active' },

                // South Korea
                { name: 'Seoul National University', institution: 'Seoul National University', lat: 37.4601, lng: 126.9522, country: 'South Korea', type: 'MOU', status: 'active' },
                { name: 'KAIST', institution: 'Korea Advanced Inst. of Science', lat: 36.3715, lng: 127.3614, country: 'South Korea', type: 'MOU', status: 'active' },
                { name: 'Yonsei University', institution: 'Yonsei University', lat: 37.5641, lng: 126.9381, country: 'South Korea', type: 'MOA', status: 'expiring' },

                // United States
                { name: 'MIT Partnership', institution: 'Massachusetts Institute of Technology', lat: 42.3601, lng: -71.0942, country: 'USA', type: 'MOA', status: 'active' },
                { name: 'University of California', institution: 'University of California, Berkeley', lat: 37.8724, lng: -122.2595, country: 'USA', type: 'MOU', status: 'active' },
                { name: 'Harvard University', institution: 'Harvard University', lat: 42.3770, lng: -71.1167, country: 'USA', type: 'MOA', status: 'expired' },
                { name: 'Stanford University', institution: 'Stanford University', lat: 37.4275, lng: -122.1697, country: 'USA', type: 'MOU', status: 'active' },

                // Australia
                { name: 'University of Melbourne', institution: 'University of Melbourne', lat: -37.7963, lng: 144.9614, country: 'Australia', type: 'MOU', status: 'expiring' },
                { name: 'Australia National University', institution: 'Australian National University', lat: -35.2777, lng: 149.1185, country: 'Australia', type: 'MOA', status: 'active' },

                // China
                { name: 'Tsinghua University', institution: 'Tsinghua University', lat: 40.0022, lng: 116.3260, country: 'China', type: 'MOU', status: 'active' },
                { name: 'Peking University', institution: 'Peking University', lat: 39.9993, lng: 116.3073, country: 'China', type: 'MOA', status: 'active' },
                { name: 'Fudan University', institution: 'Fudan University', lat: 31.2986, lng: 121.5032, country: 'China', type: 'MOU', status: 'expired' },

                // Germany
                { name: 'Technical University Munich', institution: 'Technical University of Munich', lat: 48.1499, lng: 11.5680, country: 'Germany', type: 'MOU', status: 'active' },
                { name: 'Heidelberg University', institution: 'Heidelberg University', lat: 49.4083, lng: 8.6939, country: 'Germany', type: 'MOA', status: 'active' },
            ];

            // ── Custom SVG icon factory ─────────────────────────────────
            const STATUS_COLOR = { active: '#16a34a', expiring: '#d97706', expired: '#dc2626' };
            const STATUS_RING = { active: '#bbf7d0', expiring: '#fde68a', expired: '#fecaca' };

            function makeIcon(status) {
                const c = STATUS_COLOR[status];
                const r = STATUS_RING[status];
                const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="32" viewBox="0 0 26 32">
              <ellipse cx="13" cy="30" rx="5" ry="2.5" fill="rgba(0,0,0,.18)"/>
              <circle cx="13" cy="13" r="12" fill="${r}" stroke="${c}" stroke-width="2.5"/>
              <circle cx="13" cy="13" r="6"  fill="${c}"/>
            </svg>`;
                return L.divIcon({
                    className: '',
                    html: svg,
                    iconSize: [26, 32],
                    iconAnchor: [13, 30],
                    popupAnchor: [0, -28]
                });
            }

            // ── Drop markers ────────────────────────────────────────────
            PARTNERSHIPS.forEach(function (p) {
                const color = STATUS_COLOR[p.status];
                const label = p.status.charAt(0).toUpperCase() + p.status.slice(1);
                const popup = `
              <div style="font-family:'Inter',sans-serif;min-width:200px;padding:2px 0">
                <div style="font-size:13px;font-weight:700;color:#0d1b3e;margin-bottom:4px">${p.institution}</div>
                <div style="font-size:11.5px;color:#64748b;margin-bottom:8px">
                  <i class="fa-solid fa-location-dot" style="color:${color}"></i> ${p.country}
                </div>
                <div style="display:flex;gap:6px;flex-wrap:wrap">
                  <span style="font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px;background:#e8f0fe;color:#1e3a8a">${p.type}</span>
                  <span style="font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px;background:${STATUS_RING[p.status]};color:${color}">${label}</span>
                </div>
              </div>`;
                L.marker([p.lat, p.lng], { icon: makeIcon(p.status) })
                    .addTo(map)
                    .bindPopup(popup, { maxWidth: 240 });
            });

            // ── Map legend ──────────────────────────────────────────────
            const legend = L.control({ position: 'bottomright' });
            legend.onAdd = function () {
                const div = L.DomUtil.create('div');
                div.style.cssText = 'background:#fff;border-radius:10px;padding:10px 14px;box-shadow:0 2px 12px rgba(0,0,0,.15);font-family:Inter,sans-serif;font-size:11.5px;line-height:1.8;pointer-events:none';
                div.innerHTML = [
                    '<div style="font-weight:800;color:#0d1b3e;margin-bottom:-15px">Legend</div>',
                    dot('#16a34a', '#bbf7d0') + ' Active',
                    dot('#d97706', '#fde68a') + ' Expiring Soon',
                    dot('#dc2626', '#fecaca') + ' Expired',
                ].join('<br>');
                return div;
            };
            function dot(c, r) {
                return `<span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:${r};border:2px solid ${c};vertical-align:middle;margin-right:5px"></span>`;
            }
            legend.addTo(map);

            // ── Continent fly-to ────────────────────────────────────────
            function flyToContinent(btn, lat, lng, zoom) {
                document.querySelectorAll('.continent-tab').forEach(function (t) {
                    t.classList.remove('active');
                });
                if (btn) btn.classList.add('active');
                map.flyTo([lat, lng], zoom, { duration: 1.2 });
            }
            setTimeout(function () { map.invalidateSize(); }, 200);
        </script>

</body>

</html>