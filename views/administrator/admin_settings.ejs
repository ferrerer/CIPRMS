<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">
<head>
  <meta charset="utf-8" />
  <%- include('../partials/ui-state-init') %>
  <title>Account Settings | CIPRMS-CSPC-CIRL</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/images/cirl-logo.jpg">
  <script src="/velzon/assets/js/layout.js"></script>
  <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/app.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/ciprms-bridge.css?v=20260925" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
<div id="layout-wrapper">

  <%- include('../partials/header') %>
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <div class="page-content">
      <div class="container-fluid">

        <!-- Page Title -->
        <div class="row">
          <div class="col-12">
            <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
              <h4 class="mb-sm-0"><i class="ri-settings-3-line me-2 text-primary"></i>Account Settings</h4>
              <div class="page-title-right">
                <ol class="breadcrumb m-0">
                  <li class="breadcrumb-item"><a href="<%= typeof homeHref !== 'undefined' ? homeHref : '/dashboard' %>">CIPRMS</a></li>
                  <li class="breadcrumb-item active">Account Settings</li>
                </ol>
              </div>
            </div>
          </div>
        </div>

        <div class="row">

          <!-- Left: Profile Card -->
          <div class="col-xxl-3 col-lg-4">
            <div class="card">
              <div class="card-body p-4 text-center">
                <div class="position-relative d-inline-block mb-3" style="cursor:pointer;" onclick="document.getElementById('photo-input').click()" title="Change photo">
                  <div id="hero-avatar" class="avatar-xl mx-auto rounded-circle d-flex align-items-center justify-content-center fs-1 fw-bold text-white"
                    style="background:linear-gradient(135deg,#405189,#0ab39c);overflow:hidden;background-size:cover;background-position:center;">A</div>
                  <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-primary p-1" style="width:22px;height:22px;display:flex;align-items:center;justify-content:center;">
                    <i class="ri-camera-fill fs-11"></i>
                  </span>
                </div>
                <input id="photo-input" type="file" accept=".jpg,.jpeg,.png" class="d-none" onchange="handlePhotoChange(event)">
                <h5 class="mb-1" id="hero-name">Administrator</h5>
                <p class="text-muted mb-3" id="hero-role">System Administrator</p>
                <div class="border-top pt-3 text-start">
                  <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                    <i class="ri-building-2-line text-primary"></i>
                    <span id="info-dept">—</span>
                  </div>
                  <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                    <i class="ri-briefcase-line text-primary"></i>
                    <span id="info-position">—</span>
                  </div>
                  <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                    <i class="ri-map-pin-line text-primary"></i>
                    <span id="info-institution">—</span>
                  </div>
                  <div class="d-flex align-items-center gap-2 text-muted small">
                    <i class="ri-phone-line text-primary"></i>
                    <span id="info-phone">—</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Tab Panel -->
          <div class="col-xxl-9 col-lg-8">
            <div class="card">
              <div class="card-header border-0">
                <ul class="nav nav-tabs-custom rounded card-header-tabs border-bottom-0" role="tablist">
                  <li class="nav-item" role="presentation">
                    <a class="nav-link active" data-bs-toggle="tab" href="#tab-personal" role="tab">
                      <i class="ri-user-3-line me-1"></i>Personal Details
                    </a>
                  </li>
                  <li class="nav-item" role="presentation">
                    <a class="nav-link" data-bs-toggle="tab" href="#tab-password" role="tab">
                      <i class="ri-lock-line me-1"></i>Change Password
                    </a>
                  </li>
                  <li class="nav-item" role="presentation">
                    <a class="nav-link" data-bs-toggle="tab" href="#tab-integrations" role="tab">
                      <i class="ri-google-fill me-1"></i>Integrations
                    </a>
                  </li>
                </ul>
              </div>
              <div class="card-body p-4">
                <div class="tab-content">

                  <!-- Tab: Personal Details -->
                  <div class="tab-pane active" id="tab-personal" role="tabpanel">
                    <form id="profile-form" action="javascript:void(0);">
                      <div class="row g-3">
                        <div class="col-md-6">
                          <label class="form-label" for="s-name">Full Name <span class="text-danger">*</span></label>
                          <input type="text" class="form-control" id="s-name" oninput="updateCard()">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" for="s-email">Email Address <span class="text-danger">*</span></label>
                          <input type="email" class="form-control" id="s-email" value="<%= userEmail %>" disabled title="Email is tied to your login and cannot be changed here.">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" for="s-contact">Contact Number</label>
                          <input type="text" class="form-control" id="s-contact" readonly title="Set when your account was registered and cannot be changed here.">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" for="s-dept">Department / College</label>
                          <input type="text" class="form-control" id="s-dept" readonly title="Set when your account was registered and cannot be changed here.">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" for="s-position">Designation / Position</label>
                          <input type="text" class="form-control" id="s-position" readonly title="Set when your account was registered and cannot be changed here.">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" for="s-institution">Institution / School</label>
                          <input type="text" class="form-control" id="s-institution" readonly title="Set when your account was registered and cannot be changed here.">
                        </div>
                        <div class="col-12">
                          <div class="form-text"><i class="ri-lock-line me-1"></i>Department, position, institution and contact number are set when your account is registered and cannot be changed here. Contact the CIRL Administrator if they need updating.</div>
                        </div>
                      </div>
                      <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-light" onclick="resetForm()">
                          <i class="ri-refresh-line me-1"></i>Cancel
                        </button>
                        <button type="button" id="save-btn" class="btn btn-primary" onclick="saveSettings()">
                          <i class="ri-save-3-line me-1"></i>Update Settings
                        </button>
                      </div>
                    </form>
                  </div>

                  <!-- Tab: Change Password -->
                  <div class="tab-pane" id="tab-password" role="tabpanel">
                    <form id="pwd-form" action="javascript:void(0);" onsubmit="changePassword(event)">
                      <div class="row g-3">
                        <div class="col-12">
                          <label class="form-label" for="oldpasswordInput">Current Password <span class="text-danger">*</span></label>
                          <div class="position-relative">
                            <input type="password" class="form-control pe-5" id="oldpasswordInput">
                            <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted px-3" onclick="togglePwd('oldpasswordInput',this)" aria-label="Show or hide password">
                              <i class="ri-eye-line"></i>
                            </button>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" for="newpasswordInput">New Password <span class="text-danger">*</span></label>
                          <div class="position-relative">
                            <input type="password" class="form-control pe-5" id="newpasswordInput">
                            <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted px-3" onclick="togglePwd('newpasswordInput',this)" aria-label="Show or hide password">
                              <i class="ri-eye-line"></i>
                            </button>
                          </div>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label" for="confirmpasswordInput">Confirm New Password <span class="text-danger">*</span></label>
                          <div class="position-relative">
                            <input type="password" class="form-control pe-5" id="confirmpasswordInput">
                            <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted px-3" onclick="togglePwd('confirmpasswordInput',this)" aria-label="Show or hide password">
                              <i class="ri-eye-line"></i>
                            </button>
                          </div>
                        </div>
                      </div>
                      <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-light"
                          onclick="['oldpasswordInput','newpasswordInput','confirmpasswordInput'].forEach(id=>document.getElementById(id).value='')">
                          <i class="ri-refresh-line me-1"></i>Cancel
                        </button>
                        <button type="submit" id="pwd-btn" class="btn btn-primary">
                          <i class="ri-lock-line me-1"></i>Update Password
                        </button>
                      </div>
                    </form>
                  </div>

                  <!-- Tab: Integrations -->
                  <div class="tab-pane" id="tab-integrations" role="tabpanel">
                    <div class="d-flex align-items-start gap-3">
                      <div class="avatar-sm flex-shrink-0">
                        <span class="avatar-title bg-light rounded-circle fs-3">
                          <i class="ri-google-fill text-danger"></i>
                        </span>
                      </div>
                      <div class="flex-grow-1">
                        <h5 class="mb-1">Google Calendar</h5>
                        <p class="text-muted fs-13 mb-3">When connected, every calendar event's selected recipients are automatically invited on Google Calendar, so it appears on their phone with normal Google reminders — alongside, not instead of, CIPRMS's own in-app notifications.</p>
                        <div id="gc-status-box">
                          <p class="text-muted fs-13">Loading…</p>
                        </div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>

        </div><!-- row -->
      </div><!-- container-fluid -->
    </div><!-- page-content -->

    <footer class="footer">
      <div class="container-fluid">
        <div class="row">
          <div class="col-sm-6"><script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL</div>
          <div class="col-sm-6"><div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div></div>
        </div>
      </div>
    </footer>
  </div><!-- end main content -->
</div><!-- END layout-wrapper -->

<!-- Toast -->
<div id="s-toast" style="position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;color:#fff;padding:.65rem 1.1rem;border-radius:.5rem;font-size:.8125rem;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,.18);opacity:0;pointer-events:none;transition:opacity .3s;display:flex;align-items:center;gap:.4rem;"></div>

<script>
  // The profile picture lives on the account now (it used to be kept in this browser only under this key).
  try { localStorage.removeItem('ciprms_admin_photo'); } catch (_) {}
  const INITIAL_AVATAR = <%- JSON.stringify(typeof userAvatarUrl !== 'undefined' ? userAvatarUrl : '/images/default-avatar.jpg').replace(/</g, '\\u003c') %>;

  function togglePwd(id, btn) {
    const inp = document.getElementById(id);
    const ico = btn.querySelector('i');
    inp.type = inp.type === 'password' ? 'text' : 'password';
    ico.className = inp.type === 'password' ? 'ri-eye-line' : 'ri-eye-off-line';
  }

  function updateCard() {
    const name = document.getElementById('s-name').value.trim();
    const dept = document.getElementById('s-dept').value;
    const pos  = document.getElementById('s-position').value.trim();
    const inst = document.getElementById('s-institution').value.trim();
    const phone = document.getElementById('s-contact').value.trim();
    const parts = name.split(' ').filter(Boolean);
    const initials = parts.length >= 2 ? (parts[0][0]+parts[parts.length-1][0]).toUpperCase() : (parts[0] ? parts[0][0].toUpperCase() : 'A');
    const av = document.getElementById('hero-avatar');
    if (!av.dataset.hasPhoto) { av.textContent = initials; av.style.backgroundImage = ''; }
    document.getElementById('hero-name').textContent = name || 'Administrator';
    document.getElementById('info-dept').textContent = dept || '—';
    document.getElementById('info-position').textContent = pos || '—';
    document.getElementById('info-institution').textContent = inst || '—';
    document.getElementById('info-phone').textContent = phone || '—';
  }

  function applyPhoto(dataUrl) {
    const el = document.getElementById('hero-avatar');
    if (dataUrl) {
      el.style.backgroundImage = `url('${dataUrl}')`;
      el.style.backgroundSize = 'cover';
      el.style.backgroundPosition = 'center';
      el.textContent = '';
      el.dataset.hasPhoto = '1';
    } else {
      delete el.dataset.hasPhoto;
      el.style.backgroundImage = '';
      updateCard();
    }
  }

  // Uploads to the account (every page's header/sidebar picture comes from there) and swaps the new picture in right away.
  function handlePhotoChange(e) {
    const file = e.target.files[0];
    e.target.value = '';
    if (!file) return;
    const form = new FormData();
    form.append('avatar', file);
    fetch('/api/profile/avatar', { method: 'POST', body: form, headers: { 'X-Requested-With': 'ciprms' } })
      .then(r => r.json().catch(() => ({})))
      .then(data => {
        if (!data.success) {
          showToast('<i class="ri-error-warning-line me-1"></i>' + escapeText(data.error || 'Unable to upload the photo.'), '#f06548');
          return;
        }
        applyPhoto(data.avatarUrl);
        document.querySelectorAll('.js-user-avatar').forEach(img => { img.src = data.avatarUrl; });
        showToast('<i class="ri-image-line me-1"></i>Profile picture updated!', '#0ab39c');
      })
      .catch(() => showToast('<i class="ri-error-warning-line me-1"></i>Unable to upload the photo. Please try again.', '#f06548'));
  }

  function escapeText(s) {
    const d = document.createElement('div');
    d.textContent = String(s);
    return d.innerHTML;
  }

  async function loadProfile() {
    applyPhoto(INITIAL_AVATAR);
    try {
      const data = await fetch('/api/admin/profile').then(r => r.json());
      if (data.name)        document.getElementById('s-name').value        = data.name;
      if (data.dept)        document.getElementById('s-dept').value        = data.dept;
      if (data.position)    document.getElementById('s-position').value    = data.position;
      if (data.institution) document.getElementById('s-institution').value = data.institution;
      document.getElementById('s-contact').value = data.contactNumber || '';
      updateCard();
    } catch(_) { updateCard(); }
  }

  async function saveSettings() {
    const name = document.getElementById('s-name').value.trim();
    // Only the name is editable: department, position, institution and contact number are fixed when the account is registered.
    if (!name)
      return showToast('<i class="ri-error-warning-line me-1"></i>Please enter your full name.', '#f06548');
    const btn = document.getElementById('save-btn');
    btn.disabled = true; btn.innerHTML = '<i class="ri-loader-4-line me-1"></i>Saving…';
    try {
      // Email is not submitted here — it's tied to the authenticated account
      // and cannot be changed from this form (server ignores it either way).
      const res = await fetch('/api/admin/profile', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ name })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Save failed.');
      updateCard();
      // Header/sidebar name is server-rendered; refresh it now instead of on the next page load.
      document.querySelectorAll('.user-name-text, .sidebar-user-name-text').forEach(el => el.textContent = name);
      showToast('<i class="ri-checkbox-circle-line me-1"></i>Settings saved!', '#0ab39c');
    } catch(err) {
      showToast('<i class="ri-error-warning-line me-1"></i>' + err.message, '#f06548');
    } finally {
      btn.disabled = false; btn.innerHTML = '<i class="ri-save-3-line me-1"></i>Update Settings';
    }
  }

  function resetForm() {
    loadProfile();   // Cancel: back to the saved name; the other fields are read-only
  }

  async function changePassword(e) {
    e.preventDefault();
    const oldP = document.getElementById('oldpasswordInput').value.trim();
    const newP = document.getElementById('newpasswordInput').value.trim();
    const confP = document.getElementById('confirmpasswordInput').value.trim();
    if (!oldP || !newP || !confP) return showToast('<i class="ri-error-warning-line me-1"></i>All fields are required.', '#f06548');
    if (newP !== confP) return showToast('<i class="ri-error-warning-line me-1"></i>Passwords do not match.', '#f06548');
    const isStrongPassword = pw => pw.length >= 8 && /[a-z]/.test(pw) && /[A-Z]/.test(pw) && /[0-9]/.test(pw);
    if (!isStrongPassword(newP)) return showToast('<i class="ri-error-warning-line me-1"></i>Password must be at least 8 characters and include an uppercase letter, a lowercase letter, and a number.', '#f06548');
    const btn = document.getElementById('pwd-btn');
    let relogin = false;
    btn.disabled = true; btn.innerHTML = '<i class="ri-loader-4-line me-1"></i>Updating…';
    try {
      const res = await fetch('/api/admin/password', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ oldPassword: oldP, newPassword: newP })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Update failed.');
      ['oldpasswordInput','newpasswordInput','confirmpasswordInput'].forEach(id => document.getElementById(id).value = '');
      // The server ended this session with the password change: sign in again with the new password.
      relogin = true;
      showToast('<i class="ri-lock-line me-1"></i>Password changed. Please log in again with your new password…', '#0ab39c');
      setTimeout(() => { window.location.href = '/?passwordChanged=1'; }, 2500);
    } catch(err) {
      showToast('<i class="ri-error-warning-line me-1"></i>' + err.message, '#f06548');
    } finally {
      if (!relogin) { btn.disabled = false; btn.innerHTML = '<i class="ri-lock-line me-1"></i>Update Password'; }
    }
  }

  function showToast(msg, bg = '#405189') {
    const t = document.getElementById('s-toast');
    t.style.background = bg; t.innerHTML = msg; t.style.opacity = '1';
    clearTimeout(t._to); t._to = setTimeout(() => t.style.opacity = '0', 3500);
  }

  // ── Google Calendar integration (2026-08-02; connection details 2026-09-20) ──
  function gcEsc(v) { return String(v == null ? '' : v).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

  const GC_FAILURE_REASONS = {
    denied: 'Google Calendar access was not granted. Click Connect again and choose Allow.',
    state: 'The connection attempt could not be verified (it expired or was opened in another window). Please try again.',
    google_error: 'Google reported a problem during sign-in. Please try again.',
    no_refresh_token: 'Google did not issue a long-lived authorization. Remove "CIPRMS" from your Google Account → Security → Third-party access, then connect again.',
    redirect_uri: 'Google rejected the redirect address. Add the exact redirect URI shown below to the OAuth client in Google Cloud, then try again.',
    client: 'Google rejected the OAuth client ID/secret configured for CIPRMS.',
    not_configured: 'Google credentials are not configured on this server (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and GOOGLE_TOKEN_ENCRYPTION_KEY).',
    exchange: 'Google would not complete the connection. Please try again; if it keeps failing, check the server log.'
  };

  function gcRedirectUriHelp(data) {
    return `<div class="mt-3 fs-12 text-muted">
        Redirect URI for this address (register it under <em>Google Cloud → APIs &amp; Services → Credentials → your OAuth client → Authorized redirect URIs</em>):
        <div><code class="user-select-all">${gcEsc(data.redirectUri)}</code></div>
      </div>`;
  }

  function renderGoogleCalendarStatus(data) {
    const box = document.getElementById('gc-status-box');
    if (data.connected) {
      // lastSyncOk === false means the most recent real attempt against Google
      // failed (revoked grant, API not enabled, …) — event creation still succeeds
      // in CIPRMS regardless, but this is otherwise a silent failure.
      const syncWarning = data.lastSyncOk === false
        ? `<div class="alert alert-warning py-2 px-3 mt-2 mb-0 fs-13">
             <i class="ri-error-warning-line align-middle me-1"></i>
             Last Google attempt failed${data.lastSyncAt ? ' at ' + gcEsc(new Date(data.lastSyncAt).toLocaleString()) : ''}: ${gcEsc(data.lastSyncError || 'Unknown error')}
           </div>`
        : '';
      const account = data.googleAccountEmail
        ? `Google account: <strong>${gcEsc(data.googleAccountEmail)}</strong> <span class="text-muted fs-12">(invitations are sent from this account)</span>`
        : `Google account: <span class="text-muted">not confirmed yet — use Check connection</span>`;
      box.innerHTML = `
        <div class="alert alert-success mb-0" role="alert">
          <div class="d-flex align-items-start justify-content-between gap-2">
            <div>
              <i class="ri-checkbox-circle-line align-middle me-1"></i>Connected
              <div class="mt-1">${account}</div>
              <div class="fs-12 text-muted mt-1">Connected by ${gcEsc(data.connectedByEmail)} on ${data.connectedAt ? gcEsc(new Date(data.connectedAt).toLocaleString()) : '—'}
                · meeting times are sent as ${gcEsc(data.timeZone)}${data.calendarTimeZone ? ' (calendar time zone: ' + gcEsc(data.calendarTimeZone) + ')' : ''}
                ${data.verifiedAt ? '· last checked ' + gcEsc(new Date(data.verifiedAt).toLocaleString()) : ''}</div>
            </div>
            <div class="d-flex gap-2 flex-shrink-0">
              <button type="button" class="btn btn-sm btn-outline-primary" id="gc-verify-btn" onclick="verifyGoogleCalendar()"><i class="ri-refresh-line me-1"></i>Check connection</button>
              <button type="button" class="btn btn-sm btn-outline-danger" onclick="disconnectGoogleCalendar()"><i class="ri-link-unlink-m me-1"></i>Disconnect</button>
            </div>
          </div>
        </div>
        ${syncWarning}`;
    } else {
      box.innerHTML = `
        ${data.configured ? '' : '<div class="alert alert-danger py-2 px-3 fs-13">Google credentials are not configured on this server, so Google Calendar cannot be connected.</div>'}
        <a href="/api/google-calendar/connect" class="btn btn-primary${data.configured ? '' : ' disabled'}">
          <i class="ri-google-fill me-1"></i>Connect Google Calendar
        </a>
        <div class="fs-12 text-muted mt-2">Google will ask you to sign in and allow CIPRMS to <em>view and edit events on all your calendars</em>. Invitations are then e-mailed by Google Calendar from the account you choose.</div>
        ${gcRedirectUriHelp(data)}`;
    }
  }

  function loadGoogleCalendarStatus() {
    fetch('/api/google-calendar/status').then(r => r.json()).then(renderGoogleCalendarStatus)
      .catch(() => { document.getElementById('gc-status-box').innerHTML = '<p class="text-danger fs-13">Failed to load status.</p>'; });
  }

  function verifyGoogleCalendar() {
    const btn = document.getElementById('gc-verify-btn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Checking…'; }
    fetch('/api/google-calendar/verify', { method: 'POST' }).then(r => r.json()).then(data => {
      if (data.success) showToast('<i class="ri-checkbox-circle-line me-1"></i>Google Calendar connection is working.', '#0ab39c');
      else showToast('<i class="ri-error-warning-line me-1"></i>' + gcEsc(data.error || 'Connection check failed.'), '#f06548');
      loadGoogleCalendarStatus();
    }).catch(() => { showToast('Could not run the check.', '#f06548'); loadGoogleCalendarStatus(); });
  }

  function disconnectGoogleCalendar() {
    if (!confirm('Disconnect Google Calendar? New events will stop syncing until reconnected.')) return;
    fetch('/api/google-calendar/disconnect', { method: 'POST' }).then(r => r.json()).then(data => {
      if (data.success) { showToast('<i class="ri-checkbox-circle-line me-1"></i>Google Calendar disconnected.', '#0ab39c'); loadGoogleCalendarStatus(); }
    });
  }

  // Land back on the Integrations tab with a toast after the OAuth redirect.
  // Toggles tab classes by hand (rather than the bootstrap.Tab JS API) since
  // this script block runs before the bootstrap bundle <script> further down
  // the page loads.
  (function handleGoogleCalendarRedirect() {
    const params = new URLSearchParams(window.location.search);
    const result = params.get('googleCalendar');
    if (!result) return;
    document.querySelectorAll('.nav-tabs-custom .nav-link').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab-content .tab-pane').forEach(el => el.classList.remove('active', 'show'));
    document.querySelector('a[href="#tab-integrations"]').classList.add('active');
    document.getElementById('tab-integrations').classList.add('active', 'show');
    if (result === 'connected') showToast('<i class="ri-checkbox-circle-line me-1"></i>Google Calendar connected and checked.', '#0ab39c');
    else if (result === 'connected_unverified') showToast('<i class="ri-error-warning-line me-1"></i>Connected, but the first check failed — see the message below.', '#f7b84b');
    else showToast('<i class="ri-error-warning-line me-1"></i>' + gcEsc(GC_FAILURE_REASONS[params.get('reason')] || 'Could not connect Google Calendar. Please try again.'), '#f06548');
    window.history.replaceState({}, '', window.location.pathname);
  })();

  loadGoogleCalendarStatus();
  loadProfile();
</script>

