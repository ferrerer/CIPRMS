    <script>
        function switchTab(tab) {
            document.getElementById('tab-rep').classList.toggle('active', tab === 'rep');
            document.getElementById('tab-audit').classList.toggle('active', tab === 'audit');
            if (document.getElementById('tab-insights')) {
                document.getElementById('tab-insights').classList.toggle('active', tab === 'insights');
            }
            document.getElementById('content-rep').style.display = tab === 'rep' ? '' : 'none';
            document.getElementById('content-audit').style.display = tab === 'audit' ? '' : 'none';
            if (document.getElementById('content-insights')) {
                document.getElementById('content-insights').style.display = tab === 'insights' ? '' : 'none';
            }
            // Lazy-load data when tab becomes visible
            if (tab === 'audit') loadAuditGrid();
            if (tab === 'insights') loadDssInsights();
        }

        const actionBadge = {
            ADD: 'bg-success-subtle text-success', EDIT: 'bg-primary-subtle text-primary',
            RENEW: 'bg-warning-subtle text-warning', VIEW: 'bg-secondary-subtle text-secondary',
            DELETE: 'bg-danger-subtle text-danger', APPROVE: 'bg-info-subtle text-info',
            REJECT: 'bg-danger-subtle text-danger'
        };
        const roleBadge = {
            'Administrator': 'bg-primary-subtle text-primary',
            'Auth. Personnel': 'bg-warning-subtle text-warning',
            'potential_partner': 'bg-success-subtle text-success',
            'Staff': 'bg-secondary-subtle text-secondary'
        };
        function formatRole(role) {
            if (role === 'potential_partner') return 'Partner';
            return role || '';
        }
        const roleLabel = {
            'potential_partner': 'Partner'
        };

        var auditGrid = null;
        var allAuditLogs = [];

        // ── Load Audit Trail from MongoDB ────────────────────────────────────────────
        function loadAuditGrid() {
            // destroy old instance so we can re-render fresh data
            if (auditGrid) {
                auditGrid.destroy();
                auditGrid = null;
                document.getElementById('audit-grid').innerHTML = '';
            }
            document.getElementById('audit-empty').style.display = 'none';

            fetch('/api/activitylogs')
                .then(r => r.json())
                .then(function (logs) {
                    allAuditLogs = logs;
                    renderAuditGrid(logs);
                })
                .catch(function (err) { console.error('Failed to load audit log:', err); });
        }

        function renderAuditGrid(logs) {
            if (auditGrid) { auditGrid.destroy(); auditGrid = null; document.getElementById('audit-grid').innerHTML = ''; }
            if (!logs || logs.length === 0) {
                document.getElementById('audit-empty').style.display = '';
                return;
            }
            document.getElementById('audit-empty').style.display = 'none';
            auditGrid = new gridjs.Grid({
                columns: [
                    { name: '#', width: '50px', formatter: (_, row) => gridjs.html(`<span class="text-muted fw-semibold">${row.cells[0].data}</span>`) },
                    { name: 'Action', formatter: (cell) => gridjs.html(`<span class="badge ${actionBadge[cell] || 'bg-secondary-subtle text-secondary'}">${cell}</span>`) },
                    { name: 'Record / Details', width: '38%' },
                    { name: 'Performed By' },
                    { name: 'Role', formatter: (cell) => gridjs.html(`<span class="badge ${roleBadge[cell] || 'bg-secondary-subtle text-secondary'}">${formatRole(cell)}</span>`) },
                    { name: 'Date & Time' }
                ],
                data: logs.map((a, i) => [i + 1, a.action, a.record, a.by, a.role, a.date]),
                search: true,
                pagination: { limit: 15 },
                sort: true,
                language: { search: { placeholder: 'Search audit log...' } },
                style: {
                    table: { border: 'none' },
                    th: { background: 'var(--vz-table-bg,#f3f6f9)', color: 'var(--vz-table-color,#878a99)', fontSize: '11px', textTransform: 'uppercase', letterSpacing: '.5px', fontWeight: '700', border: 'none', padding: '10px 16px' },
                    td: { border: 'none', padding: '10px 16px', fontSize: '13px' }
                }
            }).render(document.getElementById('audit-grid'));
        }

        function applyAuditFilters() {
            const action = document.getElementById('audit-filter-action').value;
            const role   = document.getElementById('audit-filter-role').value;
            const from   = document.getElementById('audit-filter-from').value;
            const to     = document.getElementById('audit-filter-to').value;
            let filtered = allAuditLogs.filter(function(log) {
                if (action && log.action !== action) return false;
                if (role   && log.role   !== role)   return false;
                if (from || to) {
                    // log.date is like "Jun 25, 2026, 09:30 PM" — parse it
                    var d = new Date(log.date);
                    if (from && d < new Date(from)) return false;
                    if (to   && d > new Date(to + 'T23:59:59')) return false;
                }
                return true;
            });
            renderAuditGrid(filtered);
        }

        function resetAuditFilters() {
            document.getElementById('audit-filter-action').value = '';
            document.getElementById('audit-filter-role').value = '';
            document.getElementById('audit-filter-from').value = '';
            document.getElementById('audit-filter-to').value = '';
            renderAuditGrid(allAuditLogs);
        }

        function exportAuditPDF() {
            window.open('/api/reports/activitylog/pdf', '_blank');
        }

        function exportAuditExcel() {
            window.open('/api/reports/activitylog/excel', '_blank');
        }

        // Report Type options that name a status ("Active Partnerships", etc.)
        // imply that status server-side even if the Status filter is left at
        // "All" (see computeCustomReportData's REPORT_TYPE_IMPLIED_STATUS) —
        // sync the Status filter to match so the builder never silently shows
        // a status the admin didn't ask for. An explicit Status filter choice
        // still always wins if the admin changes it afterward.
        var REPORT_TYPE_IMPLIED_STATUS = {
            'Active Partnerships': 'Active',
            'Active List': 'Active',
            'Inactive Partnerships': 'Inactive',
            'Expired Partnerships': 'Expired',
            'Expired List': 'Expired',
            'Expiring Soon': 'Expiring Soon'
        };
        function onReportTypeChange() {
            var reportType = document.getElementById('cr-type').value;
            var implied = REPORT_TYPE_IMPLIED_STATUS[reportType];
            if (implied) document.getElementById('cr-status').value = implied;
        }

        function buildReportQueryParams() {
            var reportType = document.getElementById('cr-type').value;
            var customTitle = document.getElementById('cr-title').value.trim();
            var cat = document.getElementById('cr-cat').value;
            var dateFrom = document.getElementById('cr-date-from').value;
            var dateTo = document.getElementById('cr-date-to').value;
            var agtype = document.getElementById('cr-agtype').value;
            var status = document.getElementById('cr-status').value;
            var country = document.getElementById('cr-country').value.trim();

            var params = new URLSearchParams();
            params.set('reportType', reportType);
            params.set('title', customTitle || (reportType + ' Report'));
            if (cat) params.set('cat', cat);
            if (dateFrom) params.set('dateFrom', dateFrom);
            if (dateTo) params.set('dateTo', dateTo);
            if (agtype) params.set('agtype', agtype);
            if (status) params.set('status', status);
            if (country) params.set('country', country);

            return params;
        }

        // Restores every Custom Report Builder field to its default/blank
        // state (Reset Filters button) — must clear all 8 remaining fields so
        // no stale value can silently affect the next generated report.
        function resetCustomReportFilters() {
            document.getElementById('cr-title').value = '';
            document.getElementById('cr-type').value = 'Summary';
            document.getElementById('cr-cat').value = '';
            document.getElementById('cr-agtype').value = '';
            document.getElementById('cr-status').value = '';
            document.getElementById('cr-country').value = '';
            document.getElementById('cr-date-from').value = '';
            document.getElementById('cr-date-to').value = '';
        }

        function exportReport(format, params) {
            var q = new URLSearchParams(params).toString();
            window.open('/api/reports/partnerships/' + format + '?' + q, '_blank');
        }

        function generateCustomReport(format) {
            var type = document.getElementById('cr-type').value;
            if (type === 'Audit') {
                window.open('/api/reports/activitylog/' + format, '_blank');
                return;
            }
            var params = buildReportQueryParams();
            window.open('/api/reports/partnerships/' + format + '?' + params.toString(), '_blank');
        }

        // ── Report Preview Modal — shared loading/error/view-switching helpers ──
        var _reportModalInstance = null;
        function getReportModal() {
            if (!_reportModalInstance) {
                _reportModalInstance = new bootstrap.Modal(document.getElementById('report-preview-modal'));
            }
            return _reportModalInstance;
        }

        function showRpmLoading() {
            document.getElementById('rpm-loading').style.display = '';
            document.getElementById('rpm-error').style.display = 'none';
            document.getElementById('rpm-view-preview').style.display = 'none';
            document.getElementById('rpm-view-compare-select').style.display = 'none';
            document.getElementById('rpm-view-compare-result').style.display = 'none';
            document.getElementById('rpm-footer-preview').style.display = 'none';
            document.getElementById('rpm-footer-compare-select').style.display = 'none';
            document.getElementById('rpm-footer-compare-result').style.display = 'none';
        }

        function showRpmError(message, retryFn) {
            document.getElementById('rpm-loading').style.display = 'none';
            document.getElementById('rpm-error').style.display = '';
            document.getElementById('rpm-error-text').textContent = message;
            document.getElementById('rpm-retry-btn').onclick = retryFn || previewCustomReport;
            // Mirror showRpmLoading()'s completeness: an error must always
            // fully replace whatever content view was showing, never sit
            // alongside it. Without this, a slower/stale request's error
            // handler firing after a newer request had already rendered
            // successfully left BOTH the error banner and the real report
            // visible at once ("Something went wrong" above a fully-populated
            // report).
            document.getElementById('rpm-view-preview').style.display = 'none';
            document.getElementById('rpm-view-compare-select').style.display = 'none';
            document.getElementById('rpm-view-compare-result').style.display = 'none';
            document.getElementById('rpm-footer-preview').style.display = 'none';
            document.getElementById('rpm-footer-compare-select').style.display = 'none';
            document.getElementById('rpm-footer-compare-result').style.display = 'none';
        }

        // view: 'preview' | 'compare-select' | 'compare-result'
        function switchRpmView(view) {
            document.getElementById('rpm-loading').style.display = 'none';
            document.getElementById('rpm-error').style.display = 'none';
            document.getElementById('rpm-view-preview').style.display = (view === 'preview') ? '' : 'none';
            document.getElementById('rpm-view-compare-select').style.display = (view === 'compare-select') ? '' : 'none';
            document.getElementById('rpm-view-compare-result').style.display = (view === 'compare-result') ? '' : 'none';
            document.getElementById('rpm-footer-preview').style.display = (view === 'preview') ? '' : 'none';
            document.getElementById('rpm-footer-compare-select').style.display = (view === 'compare-select') ? '' : 'none';
            document.getElementById('rpm-footer-compare-result').style.display = (view === 'compare-result') ? '' : 'none';
        }

        function closeReportModal() {
            getReportModal().hide();
        }

        var _lastCustomReportData = null;

        // Incremented on every previewCustomReport() call so an older,
        // slower request's eventual success/error can never overwrite what a
        // newer request already rendered (e.g. the admin double-clicking
        // Preview, or clicking it again after changing a filter before the
        // first request finished).
        var _previewRequestSeq = 0;

        function previewCustomReport() {
            getReportModal().show();
            showRpmLoading();
            var mySeq = ++_previewRequestSeq;
            var params = buildReportQueryParams();
            fetch('/api/reports/custom/preview?' + params.toString())
                .then(function (r) {
                    if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Server error while generating the preview.'); });
                    return r.json();
                })
                .then(function(data) {
                    if (mySeq !== _previewRequestSeq) return; // superseded by a newer preview request
                    if (data.error) throw new Error(data.error);
                    _lastCustomReportData = data;
                    renderReportPreview(data);
                    switchRpmView('preview');
                })
                .catch(function(err) {
                    if (mySeq !== _previewRequestSeq) return; // superseded by a newer preview request
                    console.error('Preview error:', err);
                    showRpmError('Failed to generate report preview: ' + err.message);
                });
        }

        function renderReportPreview(data) {
            document.getElementById('prev-title').textContent = data.title;
            document.getElementById('prev-meta').textContent = 'Generated ' + data.generatedDate + ' by ' + data.generatedBy + ' • Total Records: ' + data.totalRecords;

            // Applied filters badges
            var filtersEl = document.getElementById('prev-filters');
            var badgesHtml = '';
            if (data.filters) {
                Object.entries(data.filters).forEach(function(pair) {
                    badgesHtml += '<span class="badge bg-secondary-subtle text-secondary me-1 mb-1"><strong class="text-secondary-emphasis">' + escapeHtml(pair[0]) + ':</strong> ' + escapeHtml(pair[1]) + '</span>';
                });
            }
            filtersEl.innerHTML = badgesHtml;

            // Key metrics cards
            var cardsEl = document.getElementById('prev-summary-cards');
            var sum = data.summary || {};
            cardsEl.innerHTML = `
                <div class="col-md-3">
                    <div class="card card-animate mb-0 bg-primary-subtle border-0">
                        <div class="card-body p-3">
                            <h6 class="fs-12 text-uppercase text-primary fw-semibold mb-1">Total Partnerships</h6>
                            <h3 class="mb-0 text-primary fw-bold">${sum.totalCount || 0}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card card-animate mb-0 bg-success-subtle border-0">
                        <div class="card-body p-3">
                            <h6 class="fs-12 text-uppercase text-success fw-semibold mb-1">Active Agreements</h6>
                            <h3 class="mb-0 text-success fw-bold">${sum.activeCount || 0}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card card-animate mb-0 bg-warning-subtle border-0">
                        <div class="card-body p-3">
                            <h6 class="fs-12 text-uppercase text-warning fw-semibold mb-1">Expiring Soon</h6>
                            <h3 class="mb-0 text-warning fw-bold">${sum.expiringSoonCount || 0}</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card card-animate mb-0 bg-danger-subtle border-0">
                        <div class="card-body p-3">
                            <h6 class="fs-12 text-uppercase text-danger fw-semibold mb-1">Expired / Inactive</h6>
                            <h3 class="mb-0 text-danger fw-bold">${sum.inactiveCount || 0}</h3>
                        </div>
                    </div>
                </div>
            `;

            // Detailed Records Table
            var recCountEl = document.getElementById('prev-records-count');
            var recTbody = document.getElementById('prev-records-tbody');
            var records = data.records || [];
            recCountEl.textContent = records.length;

            var recHtml = '';
            if (records.length === 0) {
                recHtml = '<tr><td colspan="10" class="text-center text-muted py-3">No partnerships found matching the selected filters.</td></tr>';
            } else {
                records.forEach(function(p, i) {
                    var stBadge = p.status === 'Active' ? 'bg-success-subtle text-success' : p.status === 'Expiring Soon' ? 'bg-warning-subtle text-warning' : 'bg-danger-subtle text-danger';
                    recHtml += '<tr>'
                        + '<td>' + (i + 1) + '</td>'
                        + '<td class="fw-semibold">' + escapeHtml(p.inst) + '</td>'
                        + '<td>' + escapeHtml(p.country || '—') + '</td>'
                        + '<td>' + escapeHtml(p.region || '—') + '</td>'
                        + '<td><span class="badge bg-primary-subtle text-primary">' + escapeHtml(p.type || '—') + '</span></td>'
                        + '<td>' + escapeHtml(p.nature || '—') + '</td>'
                        + '<td><span class="badge bg-secondary-subtle text-secondary">' + escapeHtml(p.unit || '—') + '</span></td>'
                        + '<td>' + escapeHtml(p.start || '—') + '</td>'
                        + '<td>' + escapeHtml(p.end || '—') + '</td>'
                        + '<td><span class="badge ' + stBadge + '">' + escapeHtml(p.status || '—') + '</span></td>'
                        + '</tr>';
                });
            }
            recTbody.innerHTML = recHtml;
        }

        // Partnership fields (inst/country/type) are attacker-influenceable via
        // POST /api/partnerships (any Administrator/Personnel-entered value) with
        // no server-side sanitization — escape before building innerHTML strings
        // below (S17, Roadmap v2 Phase G7, docs/SYSTEM_AUDIT_2026-07-16.md).
        function escapeHtml(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
        }

        // ── Load DSS Insights from MongoDB ───────────────────────────────────────────
        function loadDssInsights() {
            fetch('/api/partnerships/stats')
                .then(r => r.json())
                .then(function (s) {
                    // Update DSS alert text
                    var dssAlert = document.getElementById('dss-alert');
                    if (dssAlert) dssAlert.innerHTML = '<strong><i class="ri-information-line me-1"></i> Decision Support System (DSS) Active:</strong> Analyzing <strong>' + s.active + '</strong> active and <strong>' + s.expired + '</strong> expired partnerships. <strong>' + s.expiring + '</strong> expiring soon.';

                    // Update health score based on real data
                    var score = Math.round(((s.active / (s.total || 1)) * 60) + ((1 - (s.expired / (s.total || 1))) * 40));
                    var scoreEl = document.getElementById('health-score');
                    if (scoreEl) { scoreEl.textContent = score; scoreEl.className = score >= 70 ? 'display-5 fw-bold text-success mb-2' : score >= 50 ? 'display-5 fw-bold text-warning mb-2' : 'display-5 fw-bold text-danger mb-2'; }

                    // Top region gap
                    var regionEl = document.getElementById('region-gap-text');
                    if (regionEl) {
                        var regions = Object.entries(s.byRegion || {}).sort((a, b) => a[1] - b[1]);
                        if (regions.length) { var weakest = regions[0]; regionEl.innerHTML = '<strong>' + weakest[0] + '</strong> has only ' + weakest[1] + ' partnership(s). <strong>Recommendation:</strong> Prioritize establishing MOAs in this region to improve global reach and QS Stars rating.'; }
                    }

                    // Report card counts
                    var activeEl = document.getElementById('stat-active-count');
                    var expiringEl = document.getElementById('stat-expiring-count');
                    var expiredEl = document.getElementById('stat-expired-count');
                    if (activeEl) activeEl.textContent = s.active + ' record' + (s.active === 1 ? '' : 's');
                    if (expiringEl) expiringEl.textContent = s.expiring + ' record' + (s.expiring === 1 ? '' : 's');
                    if (expiredEl) expiredEl.textContent = s.expired + ' record' + (s.expired === 1 ? '' : 's');
                })
                .catch(function (err) { console.error('Failed to load stats:', err); });

            // Nearest-expiring / longest-overdue blocks need the raw list, not just the aggregate stats
            fetch('/api/partnerships')
                .then(r => r.json())
                .then(function (all) {
                    var withDays = all.map(function (p) {
                        var d = Math.ceil((new Date(p.end) - new Date()) / 86400000);
                        return Object.assign({}, p, { days: d });
                    });

                    var expiringBlock = document.getElementById('dss-expiring-block');
                    if (expiringBlock) {
                        var soon = withDays.filter(function (p) { return p.status === 'Expiring Soon'; })
                            .sort(function (a, b) { return a.days - b.days; });
                        if (soon.length) {
                            var p = soon[0];
                            expiringBlock.innerHTML = '<h6 class="mb-1 text-dark">' + escapeHtml(p.inst) + (p.country ? ' (' + escapeHtml(p.country) + ')' : '') + '</h6>'
                                + '<p class="text-muted mb-2 fs-13">This ' + escapeHtml(p.type) + ' expires in <strong>' + p.days + ' day' + (p.days === 1 ? '' : 's') + '</strong>.'
                                + (soon.length > 1 ? ' ' + (soon.length - 1) + ' other agreement' + (soon.length > 2 ? 's are' : ' is') + ' also expiring within 90 days.' : '') + '</p>'
                                + '<a href="/lifecycle" class="btn btn-sm btn-warning">Review in Lifecycle Monitor</a>';
                        } else {
                            expiringBlock.innerHTML = '<p class="text-muted mb-0 fs-13">No partnerships are currently expiring within the next 90 days.</p>';
                        }
                    }

                    var expiredBlock = document.getElementById('dss-expired-block');
                    if (expiredBlock) {
                        var expired = withDays.filter(function (p) { return p.status === 'Expired'; })
                            .sort(function (a, b) { return a.days - b.days; });
                        if (expired.length) {
                            var e = expired[0];
                            var overdueDays = Math.abs(e.days);
                            expiredBlock.innerHTML = '<h6 class="mb-1 text-dark">' + escapeHtml(e.inst) + (e.country ? ' (' + escapeHtml(e.country) + ')' : '') + '</h6>'
                                + '<p class="text-muted mb-2 fs-13">This ' + escapeHtml(e.type) + ' expired <strong>' + overdueDays + ' day' + (overdueDays === 1 ? '' : 's') + '</strong> ago.'
                                + (expired.length > 1 ? ' ' + (expired.length - 1) + ' other expired agreement' + (expired.length > 2 ? 's remain' : ' remains') + ' unrenewed.' : '')
                                + ' <strong>Recommendation:</strong> Renew or archive this record.</p>';
                        } else {
                            expiredBlock.innerHTML = '<p class="text-muted mb-0 fs-13">No expired agreements currently require review.</p>';
                        }
                    }
                })
                .catch(function (err) { console.error('Failed to load partnerships for DSS blocks:', err); });
        }


        // ── COMPARE REPORTS (accessed from the Preview modal — reuses the ─────
        // existing /api/reports/comparison/* engine and export routes) ────────
        var _cmpChartInstance = null;
        var _lastComparisonData = null;
        var _lastComparisonQs = null;

        function statusBadgeClass(status) {
            if (status === 'Active') return 'bg-success-subtle text-success';
            if (status === 'Expired') return 'bg-danger-subtle text-danger';
            if (status === 'Expiring Soon') return 'bg-warning-subtle text-warning';
            if (status === 'Inactive') return 'bg-secondary-subtle text-secondary';
            return 'bg-light text-dark';
        }

        /**
         * Comparison dimension (from the Compare view) + the SAME filters
         * currently set in the Custom Report Builder — req: "Apply the same
         * filters selected by the Administrator to both reports."
         */
        /**
         * The comparison-against report (Group B / left column) reuses every
         * filter already set in the Custom Report Builder — Group A / right
         * column is the ORIGINAL report, untouched, computed server-side from
         * these SAME base filters with none of them overridden.
         */
        function buildComparisonQueryString() {
            var params = new URLSearchParams();
            params.append('compType', 'Compare Against');
            params.append('compareField', document.getElementById('cmp-field').value);
            params.append('compareValue', document.getElementById('cmp-value').value);
            params.append('title', (_lastCustomReportData && _lastCustomReportData.title) || 'Original Report');
            // Report Type (e.g. "Active Partnerships") implies a status server-side
            // even when the Status filter is left at "All" — forwarding it here is
            // what keeps Group A (the preserved original report) identical to what
            // Preview just showed, instead of reverting to every status.
            params.append('reportType', document.getElementById('cr-type').value);
            var cat = document.getElementById('cr-cat').value;
            var dateFrom = document.getElementById('cr-date-from').value;
            var dateTo = document.getElementById('cr-date-to').value;
            var agtype = document.getElementById('cr-agtype').value;
            var status = document.getElementById('cr-status').value;
            var country = document.getElementById('cr-country').value.trim();
            if (cat) params.append('cat', cat);
            if (dateFrom) params.append('dateFrom', dateFrom);
            if (dateTo) params.append('dateTo', dateTo);
            if (agtype) params.append('agtype', agtype);
            if (status) params.append('status', status);
            if (country) params.append('country', country);
            return params.toString();
        }

        function renderInheritedFilterBadges() {
            var el = document.getElementById('cmp-inherited-filters');
            var pairs = [
                ['Category', document.getElementById('cr-cat').value],
                ['Date From', document.getElementById('cr-date-from').value],
                ['Date To', document.getElementById('cr-date-to').value],
                ['Agreement Type', document.getElementById('cr-agtype').value],
                ['Status', document.getElementById('cr-status').value],
                ['Country', document.getElementById('cr-country').value]
            ].filter(function (p) { return p[1]; });
            el.innerHTML = pairs.length
                ? pairs.map(function (p) {
                    return '<span class="badge bg-secondary-subtle text-secondary me-1 mb-1"><strong class="text-secondary-emphasis">' + escapeHtml(p[0]) + ':</strong> ' + escapeHtml(p[1]) + '</span>';
                }).join('')
                : '<span class="text-muted fs-12">No filters applied — comparing across all partnerships.</span>';
        }

        function onCompareFieldChange() {
            var field = document.getElementById('cmp-field').value;
            var valSel = document.getElementById('cmp-value');
            valSel.innerHTML = '<option value="">Loading…</option>';
            fetch('/api/reports/dimension-values?field=' + encodeURIComponent(field))
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var values = data.values || [];
                    if (!values.length) {
                        valSel.innerHTML = '<option value="">No values available</option>';
                        return;
                    }
                    valSel.innerHTML = values.map(function (v) {
                        return '<option value="' + escapeHtml(v) + '">' + escapeHtml(v) + '</option>';
                    }).join('');
                })
                .catch(function () { valSel.innerHTML = '<option value="">Failed to load values</option>'; });
        }

        function openCompareSelect() {
            renderInheritedFilterBadges();
            onCompareFieldChange();
            switchRpmView('compare-select');
        }

        function backToPreview() {
            switchRpmView('preview');
        }

        // Same stale-response guard as _previewRequestSeq, for the exact same
        // race (e.g. clicking "Generate Comparison" again before a prior
        // request finished).
        var _comparisonRequestSeq = 0;

        function generateComparison() {
            var qs = buildComparisonQueryString();
            _lastComparisonQs = qs;
            var mySeq = ++_comparisonRequestSeq;
            var btn = document.getElementById('btn-generate-comparison');
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="ri-loader-4-line me-1"></i>Generating…'; }

            fetch('/api/reports/comparison/preview?' + qs)
                .then(function (r) {
                    if (!r.ok) return r.json().then(function (e) { throw new Error(e.error || 'Server error while generating the comparison.'); });
                    return r.json();
                })
                .then(function (data) {
                    if (mySeq !== _comparisonRequestSeq) return; // superseded by a newer comparison request
                    _lastComparisonData = data;
                    renderComparisonResult(data);
                    switchRpmView('compare-result');
                })
                .catch(function (err) {
                    if (mySeq !== _comparisonRequestSeq) return; // superseded by a newer comparison request
                    console.error('Comparison error:', err);
                    showRpmError('Failed to generate comparison: ' + err.message, function () { switchRpmView('compare-select'); });
                })
                .finally(function () {
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="ri-git-branch-line me-1"></i>Generate Comparison'; }
                });
        }

        function renderRecordsIntoTable(tbodyId, records) {
            var tbody = document.getElementById(tbodyId);
            if (!records || !records.length) {
                tbody.innerHTML = '<tr><td class="text-center text-muted py-3">No records in this group.</td></tr>';
                return;
            }
            tbody.innerHTML = records.map(function (p) {
                return '<tr>' +
                    '<td class="fw-semibold">' + escapeHtml(p.inst || '—') + '<div class="text-muted fs-11">' + escapeHtml(p.country || '—') + '</div></td>' +
                    '<td><span class="badge ' + statusBadgeClass(p.status) + '">' + escapeHtml(p.status || '—') + '</span></td>' +
                    '</tr>';
            }).join('');
        }

        /**
         * 3-column comparison result — Report 2 / Group B (left), Comparison
         * Result (center), Report 1 / Group A (right). Real data only, from
         * /api/reports/comparison/preview — nothing here is hardcoded.
         */
        function renderComparisonResult(data) {
            document.getElementById('cmp-title').textContent = data.title + ' — ' + data.periodLabel;
            document.getElementById('cmp-a-label').textContent = data.groupA;
            document.getElementById('cmp-b-label').textContent = data.groupB;
            document.getElementById('cmp-a-count').textContent = data.totalA;
            document.getElementById('cmp-b-count').textContent = data.totalB;

            var totalBoth = data.totalBoth || 0;
            var pctA = totalBoth > 0 ? ((data.totalA / totalBoth) * 100).toFixed(1) : '0.0';
            var pctB = totalBoth > 0 ? ((data.totalB / totalBoth) * 100).toFixed(1) : '0.0';
            document.getElementById('cmp-a-pct').textContent = pctA + '% of compared';
            document.getElementById('cmp-b-pct').textContent = pctB + '% of compared';

            renderRecordsIntoTable('cmp-a-tbody', data.groupARecords);
            renderRecordsIntoTable('cmp-b-tbody', data.groupBRecords);
            var aShown = (data.groupARecords || []).length;
            var bShown = (data.groupBRecords || []).length;
            document.getElementById('cmp-a-note').textContent = aShown < data.totalA ? ('Showing ' + aShown + ' of ' + data.totalA + '. Export to see all.') : '';
            document.getElementById('cmp-b-note').textContent = bShown < data.totalB ? ('Showing ' + bShown + ' of ' + data.totalB + '. Export to see all.') : '';

            var diff = data.diff || 0;
            var pctDiff = totalBoth > 0 ? ((diff / totalBoth) * 100).toFixed(1) : '0.0';
            var aLarger = data.totalA >= data.totalB;
            var trendIcon = diff === 0 ? 'ri-subtract-line text-muted' : (aLarger ? 'ri-arrow-up-line text-success' : 'ri-arrow-down-line text-danger');
            var trendText = diff === 0 ? 'Even — no difference' : ((aLarger ? data.groupA : data.groupB) + ' leads by ' + diff);

            var summaryEl = document.getElementById('cmp-summary-cards');
            var emptyEl = document.getElementById('cmp-empty');
            var chartCard = document.getElementById('cmp-chart-card');

            if (totalBoth === 0) {
                summaryEl.innerHTML = '';
                chartCard.style.display = 'none';
                emptyEl.style.display = '';
                if (_cmpChartInstance) { try { _cmpChartInstance.destroy(); } catch (e) {} _cmpChartInstance = null; }
                return;
            }
            emptyEl.style.display = 'none';
            chartCard.style.display = '';

            summaryEl.innerHTML =
                '<div class="col-6"><div class="card bg-warning-subtle border-0 text-center p-2 mb-0"><div class="fs-4 fw-bold text-warning">' + diff + '</div><div class="fs-11 text-warning fw-semibold">Difference</div></div></div>' +
                '<div class="col-6"><div class="card bg-light border-0 text-center p-2 mb-0"><div class="fs-4 fw-bold text-dark">' + totalBoth + '</div><div class="fs-11 text-dark fw-semibold">Total Compared</div></div></div>' +
                '<div class="col-12"><div class="card bg-body border p-2 mb-0 text-center"><i class="' + trendIcon + ' fs-4 d-block"></i><div class="fs-12 fw-semibold">' + escapeHtml(trendText) + '</div><div class="fs-11 text-muted">' + pctDiff + '% gap</div></div></div>';

            if (_cmpChartInstance) { try { _cmpChartInstance.destroy(); } catch (e) {} _cmpChartInstance = null; }
            document.getElementById('cmp-apex-chart').innerHTML = '';
            if (typeof ApexCharts !== 'undefined') {
                _cmpChartInstance = new ApexCharts(document.getElementById('cmp-apex-chart'), {
                    series: [{ name: data.groupA, data: [data.totalA] }, { name: data.groupB, data: [data.totalB] }],
                    chart: { type: 'bar', height: 180, toolbar: { show: false }, fontFamily: 'inherit' },
                    colors: ['#0a58ca', '#dc3545'],
                    plotOptions: { bar: { horizontal: true, barHeight: '45%', borderRadius: 4 } },
                    dataLabels: { enabled: true },
                    xaxis: { categories: ['Count'] },
                    legend: { position: 'top' }
                });
                _cmpChartInstance.render();
            }
        }

        function changeComparison() {
            switchRpmView('compare-select');
        }

        function clearComparison() {
            document.getElementById('cmp-field').value = 'country';
            onCompareFieldChange();
            _lastComparisonData = null;
            _lastComparisonQs = null;
            if (_cmpChartInstance) { try { _cmpChartInstance.destroy(); } catch (e) {} _cmpChartInstance = null; }
            switchRpmView('compare-select');
        }

        function exportComparison(format) {
            var qs = _lastComparisonQs || buildComparisonQueryString();
            window.open('/api/reports/comparison/' + format + '?' + qs, '_blank');
        }
        // ── END COMPARE REPORTS ─────────────────────────────────────────────────

        document.addEventListener('DOMContentLoaded', function () {
            // Load DSS stats quietly in background (elements are in the hidden insights tab)
            loadDssInsights();
        });
    </script>

    <script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
    <script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
    <script src="/velzon/assets/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="/velzon/assets/js/plugins.js"></script>
    <!-- apexcharts -->
    <script src="/velzon/assets/libs/apexcharts/apexcharts.min.js"></script>
    <!-- gridjs -->
    <script src="/velzon/assets/libs/gridjs/gridjs.umd.js"></script>
    <script src="/velzon/assets/js/app.js"></script>
</body>

