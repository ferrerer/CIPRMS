<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg"
  data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">

<head>
    <%- include('../partials/ui-state-init') %>
  <meta charset="utf-8" />
  <title>Requests | CIPRMS-CSPC-CIRL</title>
  <meta name="description" content="Manage Partnership Requests and Document Requests for CIPRMS CSPC-CIRL">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/images/cirl-logo.jpg">
  <script src="/velzon/assets/js/layout.js"></script>
  <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/app.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" />
  <link href="/velzon/assets/css/ciprms-bridge.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    /* ── Hero Banner ── */
    .pr-hero {
      background: linear-gradient(135deg, #405189 0%, #0ab39c 100%);
      border-radius: 12px;
      padding: 1.4rem 1.75rem;
      color: #fff;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      box-shadow: 0 4px 20px rgba(64, 81, 137, .25);
    }

    .pr-hero-icon {
      width: 54px;
      height: 54px;
      background: rgba(255, 255, 255, .18);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      flex-shrink: 0;
    }

    .pr-hero h4 {
      margin: 0;
      font-weight: 700;
      font-size: 1.2rem;
    }

    .pr-hero p {
      margin: .15rem 0 0;
      font-size: .82rem;
      opacity: .85;
    }

    /* ── Stat cards ── */
    .stat-card {
      border-radius: 12px;
      transition: transform .18s, box-shadow .18s;
    }

    .stat-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .1);
    }

    .stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      flex-shrink: 0;
    }

    /* ── Section Switcher Cards ── */
    .section-tabs {
      display: flex;
      gap: .75rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .section-tab {
      flex: 1 1 200px;
      min-width: 180px;
      max-width: 300px;
      padding: 1rem 1.2rem;
      border-radius: 12px;
      font-size: .84rem;
      font-weight: 600;
      cursor: pointer;
      border: 2px solid var(--vz-border-color);
      transition: all .2s ease;
      display: flex;
      align-items: center;
      gap: .75rem;
      text-decoration: none;
      color: var(--vz-body-color);
      background: var(--vz-card-bg);
      box-shadow: 0 1px 4px rgba(0,0,0,.05);
    }

    .section-tab:hover {
      border-color: #405189;
      background: var(--vz-primary-bg-subtle);
      color: #405189;
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(64,81,137,.12);
    }

    .section-tab.active {
      border-color: #405189;
      background: linear-gradient(135deg, #405189 0%, #5a72d4 100%);
      color: #fff;
      box-shadow: 0 4px 14px rgba(64,81,137,.3);
    }

    .section-tab-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: rgba(255,255,255,.2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      flex-shrink: 0;
      transition: background .2s;
    }

    .section-tab:not(.active) .section-tab-icon {
      background: var(--vz-primary-bg-subtle);
      color: #405189;
    }

    .section-tab.active .section-tab-icon {
      background: rgba(255,255,255,.18);
      color: #fff;
    }

    /* DR variant accent */
    .section-tab[id="tab-dr"]:not(.active):hover {
      border-color: #0ab39c;
      background: var(--vz-success-bg-subtle);
      color: #0ab39c;
    }
    .section-tab[id="tab-dr"]:not(.active):hover .section-tab-icon {
      background: var(--vz-success-bg-subtle);
      color: #0ab39c;
    }
    .section-tab[id="tab-dr"].active {
      background: linear-gradient(135deg, #0ab39c 0%, #17c653 100%);
      border-color: #0ab39c;
      box-shadow: 0 4px 14px rgba(10,179,156,.3);
    }

    .section-tab-body {
      display: flex;
      flex-direction: column;
    }
    .section-tab-title {
      font-size: .88rem;
      font-weight: 700;
      line-height: 1.2;
    }
    .section-tab-desc {
      font-size: .72rem;
      font-weight: 400;
      opacity: .75;
      margin-top: 1px;
    }
    .section-tab .tab-count {
      margin-left: auto;
      background: rgba(255,255,255,.25);
      border-radius: 20px;
      padding: 2px 9px;
      font-size: .75rem;
      font-weight: 700;
      flex-shrink: 0;
    }
    .section-tab:not(.active) .tab-count {
      background: var(--vz-primary-bg-subtle);
      color: #405189;
    }
    .section-tab[id="tab-dr"]:not(.active) .tab-count {
      background: var(--vz-success-bg-subtle);
      color: #0ab39c;
    }

    /* ── Filter row ── */
    .filter-row {
      display: flex;
      align-items: center;
      gap: .6rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .filter-row .form-control,
    .filter-row .form-select {
      border-radius: 8px;
      font-size: .82rem;
    }

    /* ── Table ── */
    .table th {
      font-size: .73rem;
      letter-spacing: .04em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .table td {
      font-size: .84rem;
      vertical-align: middle;
    }

    .badge-type {
      font-size: .73rem;
      border-radius: 6px;
      padding: 3px 9px;
      font-weight: 600;
    }

    /* ── Empty state ── */
    .empty-state {
      padding: 3rem 1rem;
      text-align: center;
      color: #adb5bd;
    }

    .empty-state i {
      font-size: 3rem;
      display: block;
      margin-bottom: .75rem;
    }

    /* ── Modal detail labels ── */
    .detail-label {
      font-size: .72rem;
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: .05em;
      color: #8496af;
      margin-bottom: 3px;
    }

    .detail-value {
      font-weight: 600;
      font-size: .9rem;
      color: var(--vz-body-color);
    }

    .detail-box {
      background: var(--vz-light-bg-subtle);
      border-radius: 8px;
      padding: 1rem;
    }

    /* ── Status ribbon ── */
    .status-ribbon {
      display: flex;
      align-items: center;
      gap: .8rem;
      padding: .85rem 1rem;
      border-radius: 10px;
      margin-top: 1rem;
    }

    .status-ribbon i {
      font-size: 1.6rem;
    }

    /* ── Toast ── */
    #pr-toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      color: #fff;
      padding: .65rem 1.1rem;
      border-radius: .6rem;
      font-size: .82rem;
      font-weight: 600;
      box-shadow: 0 4px 18px rgba(0, 0, 0, .2);
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s;
      display: flex;
      align-items: center;
      gap: .4rem;
    }
  </style>
</head>

<body>
  <div id="layout-wrapper">
    <%- include('../partials/header') %>
      <%- include('../partials/' + (typeof sidebarPartial !== 'undefined' ? sidebarPartial : 'sidebar')) %>

        <div class="main-content">
          <div class="page-content">
            <div class="container-fluid">

              <!-- Page Title -->
              <% var isStaffRole = typeof user !== 'undefined' && user && user.role === 'Staff'; %>
              <div class="row">
                <div class="col-12">
                  <div
                    class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                    <h4 class="mb-sm-0">
                      <i class="ri-handshake-line me-2 text-primary"></i>Requests
                    </h4>
                    <div class="page-title-right d-flex align-items-center gap-2">
                      <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="<%= isStaffRole ? '/staff/dashboard' : '/dashboard' %>">CIPRMS</a></li>
                        <li class="breadcrumb-item active">Requests</li>
                      </ol>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Hero Banner -->
              <div class="pr-hero">
                <div class="pr-hero-icon"><i class="ri-handshake-line"></i></div>
                <div>
                  <h4>Request Management Center</h4>
                  <p>View, review, and manage Partnership Requests (MOU/MOA) and Document Requests
                    in one unified workspace.</p>
                </div>
              </div>

              <!-- Stat Cards -->
              <div class="row g-3 mb-3">
                <div class="col-xl col-md-4 col-6">
                  <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <p class="text-muted fw-medium mb-1 fs-13">Partnership Requests</p>
                          <h3 class="ff-secondary fw-bold mb-0" id="cnt-pr-total">—</h3>
                        </div>
                        <div class="stat-icon bg-primary-subtle">
                          <i class="ri-building-4-line text-primary fs-4"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-xl col-md-4 col-6">
                  <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <p class="text-muted fw-medium mb-1 fs-13">Document Requests</p>
                          <h3 class="ff-secondary fw-bold mb-0" id="cnt-dr-total">—</h3>
                        </div>
                        <div class="stat-icon bg-secondary-subtle">
                          <i class="ri-file-shield-2-line text-secondary fs-4"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-xl col-md-4 col-6">
                  <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <p class="text-muted fw-medium mb-1 fs-13">Pending Review</p>
                          <h3 class="ff-secondary fw-bold mb-0 text-warning" id="cnt-pending-all">—</h3>
                        </div>
                        <div class="stat-icon bg-warning-subtle">
                          <i class="ri-time-line text-warning fs-4"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-xl col-md-4 col-6">
                  <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <p class="text-muted fw-medium mb-1 fs-13">Approved</p>
                          <h3 class="ff-secondary fw-bold mb-0 text-success" id="cnt-approved-all">—</h3>
                        </div>
                        <div class="stat-icon bg-success-subtle">
                          <i class="ri-checkbox-circle-line text-success fs-4"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-xl col-md-4 col-6">
                  <div class="card stat-card border-0 shadow-sm">
                    <div class="card-body">
                      <div class="d-flex justify-content-between align-items-center">
                        <div>
                          <p class="text-muted fw-medium mb-1 fs-13">Rejected</p>
                          <h3 class="ff-secondary fw-bold mb-0 text-danger" id="cnt-rejected-all">—</h3>
                        </div>
                        <div class="stat-icon bg-danger-subtle">
                          <i class="ri-close-circle-line text-danger fs-4"></i>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Main Card -->
              <div class="row">
                <div class="col-12">
                  <div class="card border-0 shadow-sm">
                    <div class="card-header border-bottom bg-transparent pt-3 pb-0">
                      <!-- Section switcher cards -->
                      <div class="section-tabs">
                        <a class="section-tab active" id="tab-pr" href="#" onclick="switchSection('pr');return false;">
                          <div class="section-tab-icon"><i class="ri-building-4-line"></i></div>
                          <div class="section-tab-body">
                            <span class="section-tab-title">Partnership Requests</span>
                            <span class="section-tab-desc">MOU / MOA / LOI / JVA</span>
                          </div>
                          <span class="tab-count" id="tab-cnt-pr">0</span>
                        </a>
                        <a class="section-tab" id="tab-dr" href="#" onclick="switchSection('dr');return false;">
                          <div class="section-tab-icon"><i class="ri-file-shield-2-line"></i></div>
                          <div class="section-tab-body">
                            <span class="section-tab-title">Document Requests</span>
                            <span class="section-tab-desc">Official document processing</span>
                          </div>
                          <span class="tab-count" id="tab-cnt-dr">0</span>
                        </a>
                      </div>
                    </div>

                    <div class="card-body pt-3">

                      <!-- Partnership Requests Panel -->
                      <div id="panel-pr">
                        <div class="filter-row">
                          <input class="form-control form-control-sm" id="pr-search" style="width:210px;"
                            placeholder="Search ID, requestor, institution…" oninput="renderPR()">
                          <select class="form-select form-select-sm" id="pr-status" style="width:145px;"
                            onchange="renderPR()">
                            <option value="">All Status</option>
                            <option>Pending</option>
                            <option>Under Review</option>
                            <option>Approved</option>
                            <option>Rejected</option>
                            <option>Withdrawn</option>
                          </select>
                          <select class="form-select form-select-sm" id="pr-type" style="width:120px;"
                            onchange="renderPR()">
                            <option value="">All Types</option>
                            <option>MOU</option>
                            <option>MOA</option>
                            <option>LOI</option>
                            <option>JVA</option>
                          </select>
                          <span class="text-muted fs-12 ms-auto" id="pr-count"></span>
                        </div>

                        <!-- Status quick-filter pills -->
                        <div class="d-flex gap-2 flex-wrap mb-3" id="pr-filter-tabs">
                          <button class="btn btn-sm btn-soft-primary active"
                            onclick="setPRStatusFilter('',this)">All</button>
                          <button class="btn btn-sm btn-soft-warning"
                            onclick="setPRStatusFilter('Pending',this)">Pending</button>
                          <button class="btn btn-sm btn-soft-info"
                            onclick="setPRStatusFilter('Under Review',this)">Under Review</button>
                          <button class="btn btn-sm btn-soft-success"
                            onclick="setPRStatusFilter('Approved',this)">Approved</button>
                          <button class="btn btn-sm btn-soft-danger"
                            onclick="setPRStatusFilter('Rejected',this)">Rejected</button>
                          <button class="btn btn-sm btn-soft-secondary"
                            onclick="setPRStatusFilter('Withdrawn',this)">Withdrawn</button>
                        </div>

                        <div class="table-responsive">
                          <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                              <tr>
                                <th>#</th>
                                <th>Request ID</th>
                                <th>Submitted By</th>
                                <th>Institution</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                              </tr>
                            </thead>
                            <tbody id="pr-tbody"></tbody>
                          </table>
                        </div>
                      </div>

                      <!-- Document Requests Panel -->
                      <div id="panel-dr" style="display:none;">
                        <div class="filter-row">
                          <input class="form-control form-control-sm" id="dr-search" style="width:210px;"
                            placeholder="Search institution, requestor…" oninput="renderDR()">
                          <select class="form-select form-select-sm" id="dr-status" style="width:170px;"
                            onchange="renderDR()">
                            <option value="">All Status</option>
                            <option>Received</option>
                            <option>Preparing</option>
                            <option>Awaiting for Approval</option>
                            <option>Approved</option>
                            <option>Release</option>
                            <option>Completed</option>
                            <option>Rejected</option>
                          </select>
                          <select class="form-select form-select-sm" id="dr-type" style="width:130px;"
                            onchange="renderDR()">
                            <option value="">All Types</option>
                            <option>MOA</option>
                            <option>MOU</option>
                            <option>Accreditation</option>
                          </select>
                          <span class="text-muted fs-12 ms-auto" id="dr-count"></span>
                        </div>

                        <div class="table-responsive">
                          <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                              <tr>
                                <th>#</th>
                                <th>Institution</th>
                                <th>Document Type</th>
                                <th>Requested By</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                              </tr>
                            </thead>
                            <tbody id="dr-tbody"></tbody>
                          </table>
                        </div>
                      </div>

                    </div><!-- /card-body -->
                  </div><!-- /card -->
                </div>
              </div>

            </div><!-- /container-fluid -->
          </div><!-- /page-content -->

          <footer class="footer">
            <div class="container-fluid">
              <div class="row">
                <div class="col-sm-6">
                  <script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL
                </div>
                <div class="col-sm-6">
                  <div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div>
                </div>
              </div>
            </div>
          </footer>
        </div><!-- /main-content -->
  </div><!-- /layout-wrapper -->

  <!-- Partnership Request Detail Modal -->
  <div class="modal fade zoomIn" id="pr-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light-subtle p-3">
          <h5 class="modal-title" id="pr-modal-title">
            <i class="ri-building-4-line me-2 text-primary"></i>Partnership Request Details
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="pr-modal-body"></div>
        <div class="modal-footer" id="pr-modal-footer"></div>
      </div>
    </div>
  </div>

  <!-- Partnership Request Draft Collaboration Modal -->
  <div class="modal fade zoomIn" id="pr-draft-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light-subtle p-3">
          <h5 class="modal-title" id="pr-draft-modal-title">
            <i class="ri-file-list-3-line me-2 text-primary"></i>Draft Collaboration
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="pr-draft-timeline" class="mb-3"></div>
          <div id="pr-draft-upload-wrap" class="border-top pt-3">
            <p class="detail-label mb-2">Upload a New Version</p>
            <div class="mb-2">
              <input type="file" class="form-control form-control-sm" id="pr-draft-file" accept=".pdf,.jpg,.jpeg,.png">
            </div>
            <div class="mb-2">
              <textarea class="form-control form-control-sm" id="pr-draft-note" rows="2" placeholder="Add a note about this version (optional)…"></textarea>
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="pr-draft-upload-btn" onclick="uploadDraftDocument()">
              <i class="ri-upload-2-line me-1"></i>Upload New Draft
            </button>
            <small class="text-muted d-block mt-2">PDF, JPG, or PNG — max 10MB. Saved to the Document Library and the other side is notified.</small>
          </div>
          <div id="pr-draft-closed-note" class="alert alert-secondary fs-13 mb-0" style="display:none;">
            <i class="ri-lock-line me-1"></i>This request has already been decided — no further documents can be added.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Document Request Detail Modal -->
  <div class="modal fade zoomIn" id="dr-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header bg-light-subtle p-3">
          <h5 class="modal-title">
            <i class="ri-file-shield-2-line me-2 text-secondary"></i>Document Request Details
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3 mb-3">
            <div class="col-6">
              <p class="detail-label">Institution</p>
              <p class="detail-value mb-0" id="dr-v-inst">—</p>
            </div>
            <div class="col-6">
              <p class="detail-label">Document Type</p>
              <p class="detail-value mb-0" id="dr-v-type">—</p>
            </div>
            <div class="col-6">
              <p class="detail-label">Requested By</p>
              <p class="detail-value mb-0" id="dr-v-by">—</p>
            </div>
            <div class="col-6">
              <p class="detail-label">Date Requested</p>
              <p class="detail-value mb-0" id="dr-v-date">—</p>
            </div>
            <div class="col-6">
              <p class="detail-label">Status</p>
              <div id="dr-v-status">—</div>
            </div>
            <div class="col-12" id="dr-status-update-wrap">
              <label class="form-label detail-label" for="dr-status-update">Update Status</label>
              <select class="form-select form-select-sm" id="dr-status-update" style="max-width:280px;" onchange="updateDrStatus(currentDRId, this.value)">
              </select>
              <small class="text-muted d-block mt-1">Only the next step in the workflow can be selected here — use Reject below to decline the request outright instead.</small>
            </div>
            <div class="col-12">
              <p class="detail-label">Notes</p>
              <div class="detail-box">
                <p class="mb-0 fs-13" id="dr-v-notes">—</p>
              </div>
            </div>
            <div class="col-12">
              <div class="d-flex align-items-center justify-content-between border rounded p-3">
                <div>
                  <p class="detail-label mb-1">Draft & Supporting Documents</p>
                  <p class="text-muted fs-12 mb-0" id="dr-draft-count">0 version(s) on file</p>
                </div>
                <button type="button" class="btn btn-soft-primary btn-sm" onclick="openDRDraftModal()">
                  <i class="ri-file-list-3-line me-1"></i>View Draft
                </button>
              </div>
            </div>
            <div class="col-12" id="dr-remark-wrap">
              <div class="row g-2">
                <div class="col-6">
                  <label class="form-label detail-label">Released By</label>
                  <div class="form-control form-control-sm bg-light-subtle text-muted" id="dr-released-by-display">Recorded automatically as you when the status moves to Release</div>
                </div>
                <div class="col-6">
                  <label class="form-label detail-label">Received By</label>
                  <input type="text" class="form-control form-control-sm" id="dr-received-by" placeholder="Requester's name">
                </div>
              </div>
            </div>
            <div class="col-12" id="dr-signoff-wrap" style="display:none">
              <p class="detail-label mb-1">Sign-off on Record</p>
              <p class="mb-0 fs-13" id="dr-signoff-summary">—</p>
            </div>
            <div class="col-12">
              <p class="detail-label mb-1">Status History</p>
              <div class="detail-box" id="dr-history-list">
                <p class="mb-0 fs-13 text-muted">No status changes recorded yet.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer" id="dr-modal-footer"></div>
      </div>
    </div>
  </div>

  <!-- Document Request Draft Collaboration Modal -->
  <div class="modal fade zoomIn" id="dr-draft-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light-subtle p-3">
          <h5 class="modal-title" id="dr-draft-modal-title">
            <i class="ri-file-list-3-line me-2 text-primary"></i>Draft Collaboration
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="dr-draft-timeline" class="mb-3"></div>
          <div id="dr-draft-upload-wrap" class="border-top pt-3">
            <p class="detail-label mb-2">Upload a New Version</p>
            <div class="mb-2">
              <input type="file" class="form-control form-control-sm" id="dr-draft-file" accept=".pdf,.jpg,.jpeg,.png">
            </div>
            <div class="mb-2">
              <textarea class="form-control form-control-sm" id="dr-draft-note" rows="2" placeholder="Add a note about this version (optional)…"></textarea>
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="dr-draft-upload-btn" onclick="uploadDRDraftDocument()">
              <i class="ri-upload-2-line me-1"></i>Upload New Draft
            </button>
            <small class="text-muted d-block mt-2">PDF, JPG, or PNG — max 10MB. Saved to the Document Library and the other side is notified.</small>
          </div>
          <div id="dr-draft-closed-note" class="alert alert-secondary fs-13 mb-0" style="display:none;">
            <i class="ri-lock-line me-1"></i>This document request has already been decided — no further documents can be added.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Draft Preview Modal — shared by both the Partnership Request and
       Document Request draft timelines above; opens on top of whichever
       draft-collaboration modal triggered it. -->
  <div class="modal fade zoomIn" id="draft-preview-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header bg-light-subtle p-3">
          <h5 class="modal-title"><i class="ri-eye-line me-2 text-primary"></i>Draft Preview</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="draft-preview-body" class="mb-3"></div>
          <div class="border-top pt-3">
            <p class="fs-13 fw-medium mb-1" id="draft-preview-filename">—</p>
            <p class="fs-13 text-muted mb-1">Uploaded by: <span id="draft-preview-uploader">—</span></p>
            <p class="fs-13 text-muted mb-1">Date: <span id="draft-preview-when">—</span></p>
            <p class="fs-13 text-muted mb-0">Note: <span id="draft-preview-note">—</span></p>
          </div>
        </div>
        <div class="modal-footer">
          <a href="#" id="draft-preview-download-btn" class="btn btn-success btn-sm"><i class="ri-download-2-line me-1"></i>Download</a>
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="pr-toast"></div>

  <script>
    // Review/Approve/Reject/Request-More-Info and the Administrator document
    // upload widget are Administrator-only — PATCH /api/requests/:id, POST
    // /api/requests/:id/documents, PATCH /api/document-requests/:id, and POST
    // /api/document-requests/:id/documents are all requireStaffAccess
    // server-side (2026-08-27 full-parity revision) — Administrator and
    // Staff share identical Approve/Reject/Fulfill authority over every
    // request, so this flag (kept as IS_ADMIN for minimal diff) is true for
    // both roles; every other role gets the read-only "View" mode.
    var IS_ADMIN = <%- JSON.stringify(typeof user !== 'undefined' && user && ['Administrator', 'Staff'].includes(user.role)) %>;

    // Document Request workflow (2026-09-04) — mirrors the server-side
    // DR_WORKFLOW_STATUSES/DR_TERMINAL_STATUSES/drNextStatus in cirl.js so the
    // dropdown/UI never disagrees with what the PATCH endpoint will actually
    // accept. Every request from the API already carries a normalized
    // `canonicalStatus` field, so this file never needs its own legacy-name
    // mapping.
    var DR_WORKFLOW_STATUSES = ['Received', 'Preparing', 'Awaiting for Approval', 'Approved', 'Release', 'Completed'];
    var DR_TERMINAL_STATUSES = ['Completed', 'Rejected'];
    function drNextStatus(canonicalStatus) {
      var idx = DR_WORKFLOW_STATUSES.indexOf(canonicalStatus);
      return (idx === -1 || idx === DR_WORKFLOW_STATUSES.length - 1) ? null : DR_WORKFLOW_STATUSES[idx + 1];
    }
    // Staff and Administrator render this same partnership_requests.ejs
    // template from two different routes (/partnership-requests vs.
    // /staff/requests) that carry two different sidebars — Monitoring (the
    // consolidated Registry + Overview + DSS page, 2026-09-05) mirrors that
    // split (/lifecycle vs. /staff/lifecycle, both role-gated). "Approve"
    // must redirect into whichever one the current reviewer can actually open.
    var REGISTRY_BASE_PATH = <%- JSON.stringify(typeof user !== 'undefined' && user && user.role === 'Staff' ? '/staff/lifecycle' : '/lifecycle') %>;

    function escapeHtml(str) {
      return String(str == null ? '' : str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    // 2026-09-06 security hardening: escapeHtml() alone does NOT neutralize a
    // dangerous URL scheme (javascript:/data:/vbscript:) placed into an href
    // or src attribute — item.link can be a submitter's free-text
    // attachmentLink, not just a server-generated upload path. Only allow
    // absolute http(s) URLs or the app's own relative paths; refuse anything
    // else rather than guess (same pattern as registry-gridjs.init.js's
    // sanitizeUrl()).
    function sanitizeUrl(url) {
      const s = String(url == null ? '' : url).trim();
      if (!s) return '';
      if (/^https?:\/\//i.test(s)) return s;
      if (s.charAt(0) === '/' && s.charAt(1) !== '/') return s;
      return '';
    }

    /* ─── STATE ─── */
    var prData = [], drData = [];
    var prFiltered = [], drFiltered = [];
    var currentPRId = null;
    var currentDRId = null;
    var activeSection = 'pr';

    /* ─── HELPERS ─── */
    // Document Request workflow statuses (Received/Preparing/Awaiting for
    // Approval/Release/Completed, 2026-09-04) share this map with Partnership
    // Request statuses — safe since each table only ever renders its own
    // vocabulary, so there's no collision in practice.
    function statusBadge(s) {
      const m = {
        'Pending': 'bg-warning-subtle text-warning',
        'Under Review': 'bg-info-subtle text-info',
        'Approved': 'bg-success-subtle text-success',
        'Accepted': 'bg-success-subtle text-success',
        'Fulfilled': 'bg-success-subtle text-success',
        'Rejected': 'bg-danger-subtle text-danger',
        'Withdrawn': 'bg-secondary-subtle text-secondary',
        'Received': 'bg-warning-subtle text-warning',
        'Preparing': 'bg-info-subtle text-info',
        'Awaiting for Approval': 'bg-primary-subtle text-primary',
        'Release': 'bg-dark-subtle text-dark-emphasis',
        'Completed': 'bg-success-subtle text-success'
      };
      return `<span class="badge ${m[s] || 'bg-secondary-subtle text-secondary'}">${s}</span>`;
    }

    // Document Request "Document(s) Requested" is a free-form multi-item
    // list (documentTypes array on new records; documentType joined string
    // as a fallback for records created before 2026-09-02's combobox).
    function drDocTypeItems(r) {
      if (Array.isArray(r.documentTypes) && r.documentTypes.length) return r.documentTypes;
      return r.documentType ? [r.documentType] : [];
    }
    function drDocTypeBadges(r) {
      const items = drDocTypeItems(r);
      if (!items.length) return '<span class="badge badge-type bg-secondary-subtle text-secondary border border-secondary-subtle">—</span>';
      const first = `<span class="badge badge-type bg-secondary-subtle text-secondary border border-secondary-subtle" title="${escapeHtml(items.join(', '))}">${escapeHtml(items[0])}</span>`;
      const more = items.length > 1 ? ` <span class="badge bg-light-subtle text-muted border">+${items.length - 1} more</span>` : '';
      return first + more;
    }
    function drDocTypeList(r) {
      const items = drDocTypeItems(r);
      if (!items.length) return '—';
      if (items.length === 1) return escapeHtml(items[0]);
      return '<ol class="ps-3 mb-0">' + items.map(i => `<li>${escapeHtml(i)}</li>`).join('') + '</ol>';
    }

    function showToast(msg, bg) {
      const t = document.getElementById('pr-toast');
      t.style.background = bg || '#405189';
      t.innerHTML = msg;
      t.style.opacity = '1';
      clearTimeout(t._to);
      t._to = setTimeout(() => t.style.opacity = '0', 3500);
    }

    /* ─── SECTION SWITCHER ─── */
    function switchSection(sec) {
      activeSection = sec;
      document.getElementById('panel-pr').style.display = sec === 'pr' ? '' : 'none';
      document.getElementById('panel-dr').style.display = sec === 'dr' ? '' : 'none';
      document.getElementById('tab-pr').classList.toggle('active', sec === 'pr');
      document.getElementById('tab-dr').classList.toggle('active', sec === 'dr');
    }

    /* ─── STATS ─── */
    function updateStats() {
      document.getElementById('cnt-pr-total').textContent = prData.length;
      document.getElementById('cnt-dr-total').textContent = drData.length;
      document.getElementById('tab-cnt-pr').textContent = prData.length;
      document.getElementById('tab-cnt-dr').textContent = drData.length;

      let pending = 0, approved = 0, rejected = 0;
      prData.forEach(r => {
        const s = (r.status || '').toLowerCase();
        if (s === 'pending' || s === 'under review') pending++;
        else if (s === 'approved' || s === 'accepted') approved++;
        else if (s === 'rejected') rejected++;
      });
      // Document Requests use the 6-stage workflow (canonicalStatus) —
      // 'Completed' is the only genuinely-resolved-positive terminal state;
      // every other non-Rejected stage (Received/Preparing/Awaiting for
      // Approval/Approved/Release) is still "in progress" for this combined
      // pending/approved/rejected KPI.
      drData.forEach(r => {
        const cs = r.canonicalStatus || r.status;
        if (cs === 'Rejected') rejected++;
        else if (cs === 'Completed') approved++;
        else pending++;
      });
      document.getElementById('cnt-pending-all').textContent = pending;
      document.getElementById('cnt-approved-all').textContent = approved;
      document.getElementById('cnt-rejected-all').textContent = rejected;
    }

    /* ═══════════════════════════════════════════════════════
       PARTNERSHIP REQUESTS
    ═══════════════════════════════════════════════════════ */
    var _prStatusFilter = '';

    function setPRStatusFilter(val, btn) {
      _prStatusFilter = val;
      document.querySelectorAll('#pr-filter-tabs .btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      document.getElementById('pr-status').value = val;
      renderPR();
    }

    async function loadPR() {
      try {
        const res = await fetch('/api/requests');
        prData = await res.json();
        if (!Array.isArray(prData)) prData = [];
        // Drafts are still being edited by the submitter and were never
        // actually submitted — they don't belong in the admin review queue.
        prData = prData.filter(r => r.status !== 'Draft');
      } catch (e) { prData = []; }
      renderPR();
    }

    function renderPR() {
      const s = (document.getElementById('pr-search').value || '').toLowerCase();
      const st = document.getElementById('pr-status').value;
      const ty = document.getElementById('pr-type').value;

      prFiltered = prData.filter(r => {
        const id = String(r.id || '');
        const by = String(r.requestedBy || r.by || r.requestor || '');
        const inst = String(r.institution || r.inst || '');
        const country = String(r.country || '');
        const hay = [id, by, inst, country].join(' ').toLowerCase();
        return (!s || hay.includes(s))
          && (!st || r.status === st)
          && (!ty || r.type === ty);
      });

      const tbody = document.getElementById('pr-tbody');
      document.getElementById('pr-count').textContent =
        `${prFiltered.length} of ${prData.length} request${prData.length !== 1 ? 's' : ''}`;

      if (!prFiltered.length) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted">
          <i class="ri-inbox-line d-block fs-1 mb-2"></i>No partnership requests found.</td></tr>`;
        return;
      }

      tbody.innerHTML = prFiltered.map((r, i) => {
        const uid = String(r.id || i);
        // Institution/requester/country/notes are free-form fields any
        // potential_partner or Auth. Personnel can submit — escape before
        // interpolating into innerHTML (2026-09-06 security hardening).
        const by = escapeHtml(r.requestedBy || r.by || '—');
        const inst = escapeHtml(r.institution || r.inst || '—');
        const country = escapeHtml(r.country || '—');
        const type = r.type || '—';
        const date = r.date || '—';
        const status = r.status || 'Pending';
        const canAct = IS_ADMIN && (status === 'Pending' || status === 'Under Review');

        return `<tr>
          <td class="text-muted fw-semibold fs-13">${i + 1}</td>
          <td><span class="fw-semibold text-primary fs-13">#REQ-${String(r.id).padStart(3, '0')}</span></td>
          <td class="fw-medium fs-13">${by}</td>
          <td><span class="fw-semibold fs-13">${inst}</span></td>
          <td class="text-muted fs-13">${country}</td>
          <td><span class="badge badge-type bg-primary-subtle text-primary border border-primary-subtle">${type}</span>${r.isRenewal ? ' <span class="badge bg-info-subtle text-info">Renewal</span>' : ''}</td>
          <td class="text-muted fs-13">${date}</td>
          <td>${statusBadge(status)}</td>
          <td>
            <div class="hstack gap-1">
              <button class="btn btn-sm btn-soft-primary" onclick="openPRDetail('${uid}')">
                <i class="ri-${canAct ? 'search-eye' : 'eye'}-line me-1"></i>${canAct ? 'Review' : 'View'}
              </button>
              ${canAct ? `
              <button class="btn btn-sm btn-soft-danger" title="Reject" onclick="quickPR('${uid}','Rejected')">
                <i class="ri-close-line"></i></button>
              ` : ''}
            </div>
          </td>
        </tr>`;
      }).join('');
    }

    function openPRDetail(uid) {
      const r = prData.find(x => String(x.id) === uid);
      if (!r) return;
      currentPRId = uid;

      // Free-form fields — escape before interpolating into innerHTML
      // (2026-09-06 security hardening).
      const by = escapeHtml(r.requestedBy || r.by || '—');
      const inst = escapeHtml(r.institution || r.inst || '—');
      const country = escapeHtml(r.country || '—');
      const type = r.type || '—';
      const nature = r.nature || '—';
      const category = r.category || '—';
      const region = r.region || '—';
      const unit = r.unit || '—';
      const startDate = r.startDate || '—';
      const endDate = r.endDate || '—';
      const date = r.date || '—';
      const notes = escapeHtml(r.notes || '—');
      const isReview = IS_ADMIN && (r.status === 'Pending' || r.status === 'Under Review');

      // Uses Velzon's own theme variables (already Dark-Mode-aware — same
      // ones the -subtle badge classes resolve to) instead of hardcoded
      // pastel hex, so this ribbon isn't a light patch in Dark Mode.
      const scMap = {
        'Pending': { bg: 'var(--vz-warning-bg-subtle)', border: 'var(--vz-warning-border-subtle)', icon: 'ri-time-line', color: 'var(--vz-warning)' },
        'Under Review': { bg: 'var(--vz-info-bg-subtle)', border: 'var(--vz-info-border-subtle)', icon: 'ri-search-eye-line', color: 'var(--vz-info)' },
        'Approved': { bg: 'var(--vz-success-bg-subtle)', border: 'var(--vz-success-border-subtle)', icon: 'ri-checkbox-circle-line', color: 'var(--vz-success)' },
        'Rejected': { bg: 'var(--vz-danger-bg-subtle)', border: 'var(--vz-danger-border-subtle)', icon: 'ri-close-circle-line', color: 'var(--vz-danger)' }
      };
      const sc = scMap[r.status] || scMap['Pending'];

      document.getElementById('pr-modal-title').innerHTML =
        `<i class="ri-building-4-line me-2 text-primary"></i>#REQ-${String(r.id).padStart(3, '0')} — ${inst}` +
        (r.isRenewal ? ' <span class="badge bg-info-subtle text-info fs-12 align-middle ms-1">Renewal Request</span>' : '');

      document.getElementById('pr-modal-body').innerHTML = `
        <div class="row g-3 mb-3">
          <div class="col-sm-6">
            <p class="detail-label">Request ID</p>
            <p class="detail-value mb-0">#REQ-${String(r.id).padStart(3, '0')}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Request Type</p>
            <p class="detail-value mb-0">${r.isRenewal ? 'Renewal of Existing Partnership' : 'New Partnership'}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Requested By</p>
            <p class="detail-value mb-0">${by}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Institution</p>
            <p class="detail-value mb-0">${inst}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Country</p>
            <p class="detail-value mb-0">${country}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Agreement Type</p>
            <div><span class="badge badge-type bg-primary-subtle text-primary border border-primary-subtle">${type}</span></div>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Nature</p>
            <p class="detail-value mb-0">${nature}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Category</p>
            <p class="detail-value mb-0">${category}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Region</p>
            <p class="detail-value mb-0">${region}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Responsible CSPC Unit</p>
            <p class="detail-value mb-0">${unit}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Proposed Start Date</p>
            <p class="detail-value mb-0">${startDate}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Proposed End Date</p>
            <p class="detail-value mb-0">${endDate}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Date Submitted</p>
            <p class="detail-value mb-0">${date}</p>
          </div>
          <div class="col-sm-6">
            <p class="detail-label">Status</p>
            <div>${statusBadge(r.status || 'Pending')}</div>
          </div>
        </div>
        ${notes !== '—' ? `
          <p class="detail-label">Notes</p>
          <div class="detail-box mb-3 fs-13 lh-lg">${notes}</div>
        ` : ''}
        <div class="d-flex align-items-center justify-content-between border rounded p-3 mb-3">
          <div>
            <p class="detail-label mb-1">Draft & Supporting Documents</p>
            <p class="text-muted fs-12 mb-0">${(r.attachmentLink ? 1 : 0) + (r.supportingDocuments || []).length} version(s) on file</p>
          </div>
          <button type="button" class="btn btn-soft-primary btn-sm" onclick="openDraftModal('${uid}')">
            <i class="ri-file-list-3-line me-1"></i>View Draft
          </button>
        </div>
        ${!isReview ? `
          <div class="status-ribbon"
            style="background:${sc.bg};border:1.5px solid ${sc.border};">
            <i class="${sc.icon} fs-3" style="color:${sc.color}"></i>
            <div>
              <div class="fw-semibold" style="color:${sc.color}">Request ${r.status}</div>
              <div class="fs-12 text-muted">This request has been processed and is now read-only.</div>
            </div>
          </div>
        ` : ''}`;

      document.getElementById('pr-modal-footer').innerHTML = `
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
          <i class="ri-close-line me-1"></i>Close</button>
        ${isReview ? `
          <button class="btn btn-danger" onclick="resolvePR('${uid}','Rejected')">
            <i class="ri-forbid-line me-1"></i>Reject</button>
          <button class="btn btn-success" onclick="resolvePR('${uid}','Approved')">
            <i class="ri-check-line me-1"></i>Approve</button>
        ` : ''}`;

      new bootstrap.Modal(document.getElementById('pr-modal')).show();
    }

    /* ─── DRAFT / DOCUMENT COLLABORATION TIMELINE ───
       Combines the requester's original attachmentLink (if any, always the
       earliest version) with every entry in supportingDocuments (pushed —
       never replaced — by cirl.js, so this is already a real version
       history) into one chronological timeline. Both Administrator and
       Staff can add a new version here; the request's own submitter can
       too from their Monitoring page's own "Draft" modal (same backend
       route, same timeline renderer). */
    var ROLE_LABEL = {
      'Administrator': 'Administrator', 'Staff': 'Staff',
      'Auth. Personnel': 'Auth. Personnel', 'potential_partner': 'Partner',
      'Requester': 'Requester'
    };

    function fileKind(filename, mime) {
      const ext = String(filename || '').split('.').pop().toLowerCase();
      if ((mime && mime.includes('pdf')) || ext === 'pdf') return 'pdf';
      if ((mime && mime.startsWith('image/')) || ['jpg', 'jpeg', 'png'].includes(ext)) return 'image';
      return 'other';
    }

    function fmtFileSize(bytes) {
      if (!bytes) return '';
      return bytes > 1e6 ? (bytes / 1e6).toFixed(1) + ' MB' : Math.round(bytes / 1024) + ' KB';
    }

    // Every draft/version gets its own dedicated "Draft Preview" modal —
    // same-screen, never navigates away, carries uploader/date/note context
    // alongside the file. Bootstrap 5 doesn't reliably support two modals
    // open at once (the second one's backdrop can render behind the first,
    // eating clicks), so instead of stacking, this SWAPS: hide whichever
    // draft-collaboration modal triggered it, show the preview modal, then
    // restore the original one when the preview is closed.
    // DRAFT_TIMELINE_ITEMS keeps the last-rendered item list per timeline
    // (prefix 'pr'/'dr') so the modal can look an item up by index without
    // re-parsing anything out of the DOM or fighting HTML-attribute escaping
    // for arbitrary filenames/notes.
    var DRAFT_TIMELINE_ITEMS = {};
    var draftPreviewReturnTo = null;

    document.getElementById('draft-preview-modal').addEventListener('hidden.bs.modal', function () {
      if (draftPreviewReturnTo) {
        const returnEl = document.getElementById(draftPreviewReturnTo);
        draftPreviewReturnTo = null;
        if (returnEl) new bootstrap.Modal(returnEl).show();
      }
    });

    function openDraftPreviewModal(prefix, idx) {
      const item = (DRAFT_TIMELINE_ITEMS[prefix] || [])[idx];
      if (!item || !item.link) return;
      const kind = fileKind(item.filename, item.fileType);
      const body = document.getElementById('draft-preview-body');
      const safeLink = sanitizeUrl(item.link);
      if (!safeLink) {
        body.innerHTML = `<div class="text-center text-muted py-5"><i class="ri-error-warning-line fs-1 d-block mb-2"></i>This link cannot be previewed (unrecognized or unsafe URL).</div>`;
      } else if (kind === 'pdf') {
        body.innerHTML = `<iframe src="${safeLink}" style="width:100%;height:60vh;border:1px solid var(--vz-border-color, #e9ebec);border-radius:.25rem;"></iframe>`;
      } else if (kind === 'image') {
        body.innerHTML = `<div class="text-center"><img src="${safeLink}" style="max-width:100%;max-height:60vh;border:1px solid var(--vz-border-color, #e9ebec);border-radius:.25rem;"></div>`;
      } else {
        body.innerHTML = `<div class="text-center text-muted py-5"><i class="ri-file-3-line fs-1 d-block mb-2"></i>Preview not available for this file type.</div>`;
      }
      document.getElementById('draft-preview-filename').textContent = item.filename;
      document.getElementById('draft-preview-uploader').textContent = item.uploadedBy + ' (' + (ROLE_LABEL[item.role] || item.role) + ')';
      document.getElementById('draft-preview-when').textContent = item.when;
      document.getElementById('draft-preview-note').textContent = item.note || '—';
      const downloadBtn = document.getElementById('draft-preview-download-btn');
      downloadBtn.href = safeLink || '#';
      downloadBtn.setAttribute('download', item.filename);

      // Hide whichever draft-collaboration modal called this (there's only
      // ever one on screen at a time) and remember it, so closing the
      // preview restores it — a swap, not a stack.
      const sourceEl = document.getElementById((prefix || 'pr') + '-draft-modal');
      const sourceInstance = sourceEl && bootstrap.Modal.getInstance(sourceEl);
      draftPreviewReturnTo = sourceInstance ? sourceEl.id : null;
      if (sourceInstance) sourceInstance.hide();

      new bootstrap.Modal(document.getElementById('draft-preview-modal')).show();
    }

    // prefix namespaces DRAFT_TIMELINE_ITEMS/preview lookups so a Partnership
    // Request timeline and a Document Request timeline never collide if both
    // happen to render on the page (each tab keeps its own prefix: 'pr'/'dr').
    function draftItemHtml(item, idx, prefix) {
      const roleLabel = ROLE_LABEL[item.role] || item.role || 'Reviewer';
      const isReviewerRole = item.role === 'Administrator' || item.role === 'Staff';
      const avatar = `<div class="flex-shrink-0">
        <span class="avatar-title ${isReviewerRole ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success'} rounded-circle" style="width:36px;height:36px;">
          <i class="ri-${isReviewerRole ? 'shield-star-line' : 'user-line'}"></i>
        </span>
      </div>`;
      const header = `<div class="d-flex justify-content-between flex-wrap gap-1">
        <div>
          <span class="fw-semibold fs-13">${escapeHtml(item.uploadedBy)}</span>
          <span class="badge ${isReviewerRole ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success'} fs-10 ms-1">${escapeHtml(roleLabel)}</span>
        </div>
        <span class="text-muted fs-12">${escapeHtml(item.when)}</span>
      </div>`;

      // A link-less item is a system/status entry (e.g. "Request submitted")
      // rather than an uploaded file — no filename, preview, or download row.
      if (!item.link) {
        return `<div class="d-flex gap-3 mb-3">
          ${avatar}
          <div class="flex-grow-1 border rounded p-3">
            ${header}
            ${item.note ? `<div class="fs-13 text-muted mt-1">${escapeHtml(item.note)}</div>` : ''}
          </div>
        </div>`;
      }

      const kind = fileKind(item.filename, item.fileType);
      const sizeStr = fmtFileSize(item.fileSize);
      // Every item (not just the latest) gets both actions — Preview opens
      // the shared modal above; Download sets the browser's suggested save
      // name to the ORIGINAL filename (the file on disk is stored under a
      // generated name to avoid collisions, so without this attribute the
      // browser would save it as that generated name instead).
      const previewBtn = (kind === 'pdf' || kind === 'image')
        ? `<button type="button" class="btn btn-sm btn-soft-primary" onclick="openDraftPreviewModal('${prefix || 'pr'}', ${idx})"><i class="ri-eye-line me-1"></i>Preview</button>`
        : `<span class="text-muted fs-12 align-self-center">Preview not available for this file type</span>`;
      const safeItemLink = sanitizeUrl(item.link);
      const downloadBtnHtml = safeItemLink
        ? `<a href="${safeItemLink}" download="${escapeHtml(item.filename)}" class="btn btn-sm btn-soft-success"><i class="ri-download-2-line me-1"></i>Download</a>`
        : `<span class="text-muted fs-12 align-self-center">Link unavailable</span>`;
      return `<div class="d-flex gap-3 mb-3">
        ${avatar}
        <div class="flex-grow-1 border rounded p-3">
          ${header}
          <div class="fs-13 fw-medium mt-1">${escapeHtml(item.filename)}${sizeStr ? ` <span class="text-muted fs-12">(${sizeStr})</span>` : ''}</div>
          ${item.note ? `<div class="fs-13 text-muted mt-1 fst-italic">"${escapeHtml(item.note)}"</div>` : ''}
          <div class="d-flex align-items-center gap-2 mt-2">
            ${previewBtn}
            ${downloadBtnHtml}
          </div>
        </div>
      </div>`;
    }

    function buildDraftTimelineItems(r) {
      const items = [];
      if (r.attachmentLink) {
        items.push({
          uploadedBy: r.requestedBy || 'Requester', role: 'Requester',
          when: r.date || '—', filename: String(r.attachmentLink).split('/').pop(),
          link: r.attachmentLink, note: 'Initial submission', fileType: '', fileSize: 0
        });
      }
      (r.supportingDocuments || []).forEach(d => {
        items.push({
          uploadedBy: d.uploadedBy || 'Unknown',
          role: d.uploaderRole || 'Reviewer',
          when: d.uploadedAt
            ? new Date(d.uploadedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
            : '—',
          filename: d.originalFilename || 'Document', link: d.fileLink,
          note: d.note || '', fileType: d.fileType, fileSize: d.fileSize
        });
      });
      return items;
    }

    function renderDraftTimeline(r) {
      const items = buildDraftTimelineItems(r);
      DRAFT_TIMELINE_ITEMS.pr = items;
      const wrap = document.getElementById('pr-draft-timeline');
      wrap.innerHTML = items.length
        ? items.map((it, idx) => draftItemHtml(it, idx, 'pr')).join('')
        : '<p class="text-muted fs-13 mb-0">No draft documents yet.</p>';
    }

    /* ═══════════════════════════════════════════════════════
       DOCUMENT REQUEST DRAFT / DOCUMENT COLLABORATION TIMELINE
       Mirrors the Partnership Request timeline above, sharing every helper
       (fileKind, fmtFileSize, togglePreview, draftItemHtml, ROLE_LABEL) —
       only the data source (drData/currentDRId) and the synthetic first
       entry (a "Request submitted" system event, since Document Requests
       have no attachmentLink-style original file) differ.
    ═══════════════════════════════════════════════════════ */
    function buildDRDraftTimelineItems(r) {
      const items = [{
        uploadedBy: r.requestedBy || 'Requester', role: 'Requester',
        when: r.submittedAt
          ? new Date(r.submittedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
          : (r.date || '—'),
        note: 'Request submitted'
      }];
      (r.supportingDocuments || []).forEach(d => {
        items.push({
          uploadedBy: d.uploadedBy || 'Unknown',
          role: d.uploaderRole || 'Reviewer',
          when: d.uploadedAt
            ? new Date(d.uploadedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
            : '—',
          filename: d.originalFilename || 'Document', link: d.fileLink,
          note: d.note || '', fileType: d.fileType, fileSize: d.fileSize
        });
      });
      return items;
    }

    function renderDRDraftTimeline(r) {
      const items = buildDRDraftTimelineItems(r);
      DRAFT_TIMELINE_ITEMS.dr = items;
      const wrap = document.getElementById('dr-draft-timeline');
      wrap.innerHTML = items.map((it, idx) => draftItemHtml(it, idx, 'dr')).join('');
    }

    function openDRDraftModal() {
      const r = drData.find(x => x.id === currentDRId);
      if (!r) return;
      document.getElementById('dr-draft-modal-title').innerHTML =
        `<i class="ri-file-list-3-line me-2 text-primary"></i>Draft Collaboration — ${escapeHtml(r.documentType || 'Document Request')} #${r.id}`;
      renderDRDraftTimeline(r);
      const closed = DR_TERMINAL_STATUSES.includes(r.canonicalStatus || r.status);
      document.getElementById('dr-draft-upload-wrap').style.display = closed ? 'none' : '';
      document.getElementById('dr-draft-closed-note').style.display = closed ? '' : 'none';
      document.getElementById('dr-draft-file').value = '';
      document.getElementById('dr-draft-note').value = '';
      new bootstrap.Modal(document.getElementById('dr-draft-modal')).show();
    }

    async function uploadDRDraftDocument() {
      const fileInput = document.getElementById('dr-draft-file');
      const noteInput = document.getElementById('dr-draft-note');
      const file = fileInput.files[0];
      if (!file || !currentDRId) return showToast('<i class="ri-error-warning-line me-1"></i>Choose a file first.', '#f06548');
      const btn = document.getElementById('dr-draft-upload-btn');
      const originalBtnHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Uploading…';
      const formData = new FormData();
      formData.append('document', file);
      formData.append('note', noteInput.value.trim());
      try {
        const res = await fetch('/api/document-requests/' + currentDRId + '/documents', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed.');
        const idx = drData.findIndex(x => x.id === currentDRId);
        if (idx !== -1 && data.request) drData[idx] = data.request;
        renderDRDraftTimeline(drData.find(x => x.id === currentDRId));
        renderDR();
        updateStats();
        fileInput.value = '';
        noteInput.value = '';
        showToast('<i class="ri-checkbox-circle-line me-1"></i>New draft version uploaded.', '#0ab39c');
      } catch (e) {
        showToast('<i class="ri-error-warning-line me-1"></i>' + e.message, '#f06548');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalBtnHtml;
      }
    }

    function openDraftModal(uid) {
      const r = prData.find(x => String(x.id) === uid);
      if (!r) return;
      currentPRId = uid;
      document.getElementById('pr-draft-modal-title').innerHTML =
        `<i class="ri-file-list-3-line me-2 text-primary"></i>Draft Collaboration — #REQ-${String(r.id).padStart(3, '0')}`;
      renderDraftTimeline(r);
      const closed = ['Approved', 'Rejected', 'Withdrawn'].includes(r.status);
      document.getElementById('pr-draft-upload-wrap').style.display = closed ? 'none' : '';
      document.getElementById('pr-draft-closed-note').style.display = closed ? '' : 'none';
      document.getElementById('pr-draft-file').value = '';
      document.getElementById('pr-draft-note').value = '';
      new bootstrap.Modal(document.getElementById('pr-draft-modal')).show();
    }

    async function uploadDraftDocument() {
      const fileInput = document.getElementById('pr-draft-file');
      const noteInput = document.getElementById('pr-draft-note');
      const file = fileInput.files[0];
      if (!file || !currentPRId) return showToast('<i class="ri-error-warning-line me-1"></i>Choose a file first.', '#f06548');
      const btn = document.getElementById('pr-draft-upload-btn');
      const originalBtnHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Uploading…';
      const formData = new FormData();
      formData.append('document', file);
      formData.append('note', noteInput.value.trim());
      try {
        const res = await fetch('/api/requests/' + currentPRId + '/documents', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed.');
        const idx = prData.findIndex(x => String(x.id) === currentPRId);
        if (idx !== -1 && data.request) prData[idx] = data.request;
        renderDraftTimeline(prData.find(x => String(x.id) === currentPRId));
        renderPR();
        updateStats();
        fileInput.value = '';
        noteInput.value = '';
        showToast('<i class="ri-checkbox-circle-line me-1"></i>New draft version uploaded.', '#0ab39c');
      } catch (e) {
        showToast('<i class="ri-error-warning-line me-1"></i>' + e.message, '#f06548');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalBtnHtml;
      }
    }

    async function resolvePR(uid, decision) {
      const r = prData.find(x => String(x.id) === uid);
      if (!r) return;
      // Approving a NEW partnership request (not a renewal) no longer flips
      // the status directly — it hands off to Registry → Add New Partnership,
      // pre-filled from this request, so the reviewer can review/edit before
      // anything is saved. The request is only marked Approved once that
      // partnership is actually saved (see POST /api/partnerships,
      // sourceRequestId). Renewal requests are unaffected — approving one
      // still directly extends the already-linked partnership as before.
      if (decision === 'Approved' && !r.isRenewal) {
        bootstrap.Modal.getInstance(document.getElementById('pr-modal'))?.hide();
        window.location.href = REGISTRY_BASE_PATH + '?fromRequest=' + r.id;
        return;
      }
      try {
        await fetch('/api/requests/' + r.id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: decision })
        });
        bootstrap.Modal.getInstance(document.getElementById('pr-modal'))?.hide();
        r.status = decision;
        renderPR();
        updateStats();
        const verbLabel = decision === 'Approved' ? 'approved' : 'rejected';
        showToast(
          `<i class="ri-${decision === 'Approved' ? 'checkbox-circle' : 'close-circle'}-line me-1"></i>
           Partnership request ${verbLabel}.`,
          decision === 'Approved' ? '#0ab39c' : '#f06548'
        );
      } catch (e) {
        showToast('<i class="ri-error-warning-line me-1"></i>Action failed. Please try again.', '#f06548');
      }
    }

    async function quickPR(uid, decision) {
      const r = prData.find(x => String(x.id) === uid);
      if (!r) return;
      const verb = decision === 'Approved' ? 'Approve' : 'Reject';
      if (!confirm(`${verb} this partnership request?`)) return;
      await resolvePR(uid, decision);
    }

    /* ═══════════════════════════════════════════════════════
       DOCUMENT REQUESTS
    ═══════════════════════════════════════════════════════ */
    async function loadDR() {
      try {
        const res = await fetch('/api/document-requests');
        drData = await res.json();
        if (!Array.isArray(drData)) drData = [];
      } catch (e) { drData = []; }
      renderDR();
    }

    function renderDR() {
      const s = (document.getElementById('dr-search').value || '').toLowerCase();
      const st = document.getElementById('dr-status').value;
      const ty = document.getElementById('dr-type').value;

      drFiltered = drData.filter(r =>
        (!s || [(r.institution || ''), (r.requestedBy || '')].join(' ').toLowerCase().includes(s))
        && (!st || (r.canonicalStatus || r.status) === st)
        // documentType is now a free-form, possibly multi-item joined string
        // (e.g. "Universitas Airlangga - MOA, MOUs"), so the fixed-option
        // type filter matches as a substring rather than requiring equality.
        && (!ty || (r.documentType || '').toLowerCase().includes(ty.toLowerCase()))
      );

      const tbody = document.getElementById('dr-tbody');
      document.getElementById('dr-count').textContent =
        `${drFiltered.length} of ${drData.length} request${drData.length !== 1 ? 's' : ''}`;

      if (!drFiltered.length) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center py-5 text-muted">
          <i class="ri-inbox-line d-block fs-1 mb-2"></i>No document requests found.</td></tr>`;
        return;
      }

      tbody.innerHTML = drFiltered.map((r, i) => {
        const cs = r.canonicalStatus || r.status;
        const canAct = IS_ADMIN && !DR_TERMINAL_STATUSES.includes(cs);
        return `<tr>
          <td class="text-muted fw-semibold fs-13">${i + 1}</td>
          <td><span class="fw-semibold fs-13">${escapeHtml(r.institution || '—')}</span></td>
          <td>${drDocTypeBadges(r)}</td>
          <td class="fw-medium fs-13">${escapeHtml(r.requestedBy || '—')}</td>
          <td class="text-muted fs-13">${r.date || '—'}</td>
          <td>${statusBadge(cs || 'Received')}</td>
          <td>
            <div class="hstack gap-1">
              <button class="btn btn-sm btn-soft-secondary" onclick="openDRDetail(${r.id})">
                <i class="ri-eye-line me-1"></i>${canAct ? 'Review' : 'View'}
              </button>
            </div>
          </td>
        </tr>`;
      }).join('');
    }

    function fmtHistoryWhen(iso) {
      if (!iso) return '—';
      const d = new Date(iso);
      return isNaN(d) ? '—' : d.toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
    }

    // Renders every recorded transition (never overwritten server-side) —
    // previous status, new status, who changed it, and when — oldest first.
    function drHistoryListHtml(r) {
      const hist = Array.isArray(r.statusHistory) ? r.statusHistory : [];
      if (!hist.length) return '<p class="mb-0 fs-13 text-muted">No status changes recorded yet.</p>';
      return '<ol class="mb-0 ps-3">' + hist.map(h =>
        `<li class="fs-13 mb-1"><strong>${escapeHtml(h.from || '—')}</strong> &rarr; <strong>${escapeHtml(h.to || '—')}</strong>` +
        ` <span class="text-muted">by ${escapeHtml(h.by || '—')} on ${fmtHistoryWhen(h.at)}</span>` +
        (h.remark ? `<div class="text-muted fs-12">Remark: ${escapeHtml(h.remark)}</div>` : '') +
        '</li>'
      ).join('') + '</ol>';
    }

    // Populates the Update Status dropdown so ONLY the current stage and the
    // one legitimate next stage are selectable — every other option is
    // rendered (for context) but disabled, which is what actually prevents
    // an invalid skip/backward pick in the UI (the PATCH endpoint enforces
    // the same rule server-side regardless).
    function populateDrStatusSelect(cs) {
      const sel = document.getElementById('dr-status-update');
      const next = drNextStatus(cs);
      const terminal = DR_TERMINAL_STATUSES.includes(cs);
      sel.innerHTML = DR_WORKFLOW_STATUSES.map(s => {
        const isCurrent = s === cs;
        const disabled = !isCurrent && s !== next;
        return `<option value="${s}" ${isCurrent ? 'selected' : ''} ${disabled ? 'disabled' : ''}>${s}${isCurrent ? ' (current)' : ''}</option>`;
      }).join('');
      sel.disabled = terminal || !next;
    }

    function openDRDetail(id) {
      const r = drData.find(x => x.id === id);
      if (!r) return;
      currentDRId = id;
      const cs = r.canonicalStatus || r.status || 'Received';

      document.getElementById('dr-v-inst').textContent = r.institution || '—';
      document.getElementById('dr-v-type').innerHTML = drDocTypeList(r);
      document.getElementById('dr-v-by').textContent = r.requestedBy || '—';
      document.getElementById('dr-v-date').textContent = r.date || '—';
      document.getElementById('dr-v-status').innerHTML = statusBadge(cs);
      document.getElementById('dr-v-notes').textContent = r.notes || '—';
      document.getElementById('dr-received-by').value = r.receivedBy || r.requestedBy || '';
      document.getElementById('dr-draft-count').textContent = (r.supportingDocuments || []).length + ' version(s) on file';
      document.getElementById('dr-history-list').innerHTML = drHistoryListHtml(r);

      const canAct = IS_ADMIN && !DR_TERMINAL_STATUSES.includes(cs);
      document.getElementById('dr-remark-wrap').style.display = canAct ? '' : 'none';
      document.getElementById('dr-status-update-wrap').style.display = IS_ADMIN ? '' : 'none';
      if (IS_ADMIN) populateDrStatusSelect(cs);

      const signoffWrap = document.getElementById('dr-signoff-wrap');
      if (r.decidedBy) {
        signoffWrap.style.display = '';
        // Internal note only — the printed CSPC-F-CIRL-04 form's "Approved
        // By" line always shows the fixed CIRL Head signatory, never this
        // record's decidedBy (who merely clicked a status transition in-app).
        document.getElementById('dr-signoff-summary').innerHTML =
          `Last Updated By: <strong>${escapeHtml(r.decidedBy)}</strong>` +
          (r.releasedBy ? ` &nbsp;·&nbsp; Released By: <strong>${escapeHtml(r.releasedBy)}</strong>` : '') +
          (r.receivedBy ? ` &nbsp;·&nbsp; Received By: <strong>${escapeHtml(r.receivedBy)}</strong>` : '');
      } else {
        signoffWrap.style.display = 'none';
      }

      document.getElementById('dr-modal-footer').innerHTML = `
        <a href="/api/document-requests/${id}/pdf" class="btn btn-soft-info btn-sm btn-icon" title="Download PDF">
          <i class="ri-file-download-line"></i></a>
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
          <i class="ri-close-line me-1"></i>Close</button>
        ${canAct ? `
          <button class="btn btn-danger" onclick="resolveDR(${id},'Rejected')">
            <i class="ri-close-line me-1"></i>Reject</button>
        ` : ''}`;

      new bootstrap.Modal(document.getElementById('dr-modal')).show();
    }

    // Shared by both the Update Status dropdown (any workflow stage) and the
    // Reject button — a single PATCH call, the same server-side
    // transition/RBAC validation either way.
    async function submitDrStatusChange(id, newStatus) {
      const r = drData.find(x => x.id === id);
      if (!r) return;
      const body = { status: newStatus };
      if (newStatus === 'Completed') {
        const receivedByEl = document.getElementById('dr-received-by');
        if (receivedByEl && receivedByEl.value.trim()) body.receivedBy = receivedByEl.value.trim();
      }
      try {
        const res = await fetch('/api/document-requests/' + id, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (!res.ok) {
          showToast('<i class="ri-error-warning-line me-1"></i>' + (data.error || 'Action failed. Please try again.'), '#f06548');
          if (r.canonicalStatus) populateDrStatusSelect(r.canonicalStatus); // reset the dropdown to the real current value
          return;
        }
        // Refresh the in-memory row from the server's own response — the
        // PATCH handler computes canonicalStatus/releasedBy/receivedBy/
        // statusHistory server-side, so trust that over reconstructing it.
        Object.assign(r, data.request, { canonicalStatus: newStatus === 'Rejected' ? 'Rejected' : newStatus });
        renderDR();
        updateStats();
        if (document.getElementById('dr-modal').classList.contains('show')) openDRDetail(id);
        const verbLabel = newStatus === 'Rejected' ? 'rejected' : `moved to "${newStatus}"`;
        showToast(
          `<i class="ri-${newStatus === 'Rejected' ? 'close-circle' : 'checkbox-circle'}-line me-1"></i>
           Document request ${verbLabel} for ${r.institution}.`,
          newStatus === 'Rejected' ? '#f06548' : '#0ab39c'
        );
      } catch (e) {
        showToast('<i class="ri-error-warning-line me-1"></i>Action failed. Please try again.', '#f06548');
      }
    }

    function updateDrStatus(id, newStatus) {
      if (!newStatus) return;
      submitDrStatusChange(id, newStatus);
    }

    function resolveDR(id, decision) {
      submitDrStatusChange(id, decision);
    }

    /* ─── INIT ─── */
    // Deep-link support so a notification ("New request submitted",
    // "Additional documents requested", etc.) can jump straight to the
    // relevant request's detail modal: /partnership-requests?open=pr&id=5
    function openFromQuery() {
      const params = new URLSearchParams(window.location.search);
      const open = params.get('open');
      const id = params.get('id');
      if (!open || !id) return;
      if (open === 'pr') {
        switchSection('pr');
        openPRDetail(id);
      } else if (open === 'dr') {
        switchSection('dr');
        openDRDetail(parseInt(id));
      }
    }

    async function init() {
      await Promise.all([loadPR(), loadDR()]);
      updateStats();
      openFromQuery();
    }

    document.addEventListener('DOMContentLoaded', init);
  </script>

