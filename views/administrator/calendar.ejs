<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <%- include('../partials/ui-state-init') %>
    <title>Calendar | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <script src="/velzon/assets/js/layout.js"></script>
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet"/>
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet"/>
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet"/>
    <link href="/velzon/assets/css/ciprms-bridge.css" rel="stylesheet"/>
    <link href="/velzon/assets/libs/dragula/dragula.min.css" rel="stylesheet"/>
    <style>
        /* ── Calendar page layout ──
           The calendar card used to be stretched (.card-h-100 = height:100%) to the height of
           the left column, and the left column's height came from a FIXED 400px "Upcoming
           Events" box even when it held a single event. The month grid is only ~650px tall, so
           the card kept ~300px of empty space under it.
           Now the calendar card is exactly as tall as its calendar, and on wide screens the left
           column is a flex column that FILLS that height: the Upcoming Events list takes
           whatever is left and scrolls inside it when there are more events than fit. The list's
           minimum height is kept small on purpose: the left column can never be taller than the
           calendar, or it would set the row height and bring the empty space back.
           The short List view is the one view that is shorter than the left column, so there the
           card is stretched to match it (.cal-card-fill, toggled from datesSet below) rather than
           leaving the page ending under a half-empty card. */
        .cal-card { height: auto; }
        .cal-upcoming-scroll { max-height: 320px; overflow-y: auto; }     /* stacked (narrow) layout */
        @media (min-width: 1200px) {
            .cal-side { display: flex; flex-direction: column; }
            .cal-side > .cal-upcoming { flex: 1 1 0; min-height: 130px; display: flex; flex-direction: column; margin-bottom: 1.5rem; }
            .cal-side > .cal-upcoming .cal-upcoming-scroll { flex: 1 1 0; min-height: 0; max-height: none; }
            .cal-card.cal-card-fill { height: calc(100% - 1.5rem); }
        }
    </style>
</head>
<body>
<div id="layout-wrapper">
    <%- include('../partials/header') %>
    <%- include('../partials/' + (typeof sidebarPartial !== 'undefined' ? sidebarPartial : 'sidebar')) %>

    <div class="main-content">
        <div class="page-content">
            <div class="container-fluid">

                <div class="row">
                    <div class="col-12">
                        <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                            <h4 class="mb-sm-0">Calendar</h4>
                            <div class="page-title-right">
                                <ol class="breadcrumb m-0">
                                    <li class="breadcrumb-item"><a href="<%= (typeof user !== 'undefined' && user && user.role === 'Auth. Personnel') ? '/personnel/monitoring' : '/dashboard' %>">CIPRMS</a></li>
                                    <li class="breadcrumb-item active">Calendar</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="row">

                            <!-- col-xl-3 sidebar â€” exact from apps-calendar.html -->
                            <% var canManageCalendar = typeof user !== 'undefined' && user && (user.role === 'Administrator' || user.role === 'Staff'); %>
                            <div class="col-xl-3 cal-side">
                                <% if (canManageCalendar) { %>
                                <div class="card">
                                    <div class="card-body">
                                        <button class="btn btn-primary w-100" id="btn-new-event">
                                            <i class="mdi mdi-plus"></i> Create New Event
                                        </button>
                                        <div id="external-events">
                                            <br>
                                            <p class="text-muted">Drag and drop your event or click in the calendar</p>
                                            <div class="external-event fc-event bg-success-subtle text-success" data-class="bg-success-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Renewal</div>
                                            <div class="external-event fc-event bg-danger-subtle text-danger" data-class="bg-danger-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Expiry / Deadline</div>
                                            <div class="external-event fc-event bg-primary-subtle text-primary" data-class="bg-primary-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Meeting</div>
                                            <div class="external-event fc-event bg-warning-subtle text-warning" data-class="bg-warning-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Mobility / Exchange</div>
                                            <div class="external-event fc-event bg-info-subtle text-info" data-class="bg-info-subtle"><i class="mdi mdi-checkbox-blank-circle me-2"></i>Partnership Review</div>
                                        </div>
                                    </div>
                                </div>
                                <% } %>

                                <div class="cal-upcoming">
                                    <h5 class="mb-1">Upcoming Events</h5>
                                    <p class="text-muted">Don't miss scheduled events</p>
                                    <div class="cal-upcoming-scroll pe-2 me-n1">
                                        <div id="upcoming-event-list"></div>
                                    </div>
                                </div>

                                <div class="card">
                                    <div class="card-body bg-info-subtle">
                                        <div class="d-flex">
                                            <div class="flex-shrink-0">
                                                <i data-feather="calendar" class="text-info icon-dual-info"></i>
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <h6 class="fs-15">Partnership Calendar</h6>
                                                <% if (canManageCalendar) { %>
                                                <p class="text-muted mb-0">Click a date or drag an event type onto the calendar. Click events to view, edit, or delete.</p>
                                                <% } else { %>
                                                <p class="text-muted mb-0">Click an event to view its details.</p>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><!-- end col-xl-3 -->

                            <!-- col-xl-9 main calendar â€” exact from apps-calendar.html -->
                            <div class="col-xl-9">
                                <div id="cal-notice"></div>
                                <div class="card cal-card">
                                    <div class="card-body">
                                        <div id="calendar"></div>
                                    </div>
                                </div>
                            </div><!-- end col-xl-9 -->
                        </div><!-- end row -->

                        <div style="clear:both"></div>

                        <!-- Event Modal â€” same structure as apps-calendar.html -->
                        <div class="modal fade" id="event-modal" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0">
                                    <div class="modal-header p-3 bg-info-subtle">
                                        <h5 class="modal-title" id="modal-title">Event</h5>
                                        <span class="badge bg-success-subtle text-success ms-2 d-none" id="v-gcal-badge" title="Recipients were invited via Google Calendar"><i class="ri-google-fill me-1"></i>Synced to Google Calendar</span>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                        <!-- View mode -->
                                        <div id="view-mode">
                                            <div class="d-flex mb-2">
                                                <div class="flex-shrink-0 me-3"><i class="ri-calendar-event-line text-muted fs-16"></i></div>
                                                <div class="flex-grow-1"><h6 class="fw-semibold mb-0" id="v-date"></h6></div>
                                            </div>
                                            <div class="d-flex align-items-center mb-2">
                                                <div class="flex-shrink-0 me-3"><i class="ri-time-line text-muted fs-16"></i></div>
                                                <div class="flex-grow-1"><h6 class="fw-semibold mb-0" id="v-time"></h6></div>
                                            </div>
                                            <div class="d-flex align-items-center mb-2">
                                                <div class="flex-shrink-0 me-3"><i class="ri-map-pin-line text-muted fs-16"></i></div>
                                                <div class="flex-grow-1"><h6 class="fw-semibold mb-0" id="v-location"></h6></div>
                                            </div>
                                            <div class="d-flex mb-3">
                                                <div class="flex-shrink-0 me-3"><i class="ri-discuss-line text-muted fs-16"></i></div>
                                                <div class="flex-grow-1"><p class="text-muted mb-0" id="v-desc"></p></div>
                                            </div>
                                            <%- include('../partials/meeting_join') %>
                                            <div class="d-none mb-3" id="v-invites">
                                                <div class="d-flex align-items-start">
                                                    <div class="flex-shrink-0 me-3"><i class="ri-team-line text-muted fs-16"></i></div>
                                                    <div class="flex-grow-1">
                                                        <h6 class="fw-semibold mb-1" id="v-invite-summary"></h6>
                                                        <div class="alert alert-warning py-2 px-3 fs-12 mb-2 d-none" id="v-invite-warning"></div>
                                                        <button type="button" class="btn btn-sm btn-soft-primary" id="btn-attendance"><i class="ri-list-check-2 align-bottom me-1"></i>View attendance</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Edit/Add form -->
                                        <div id="edit-mode" class="d-none">
                                            <div class="mb-3">
                                                <label class="form-label">Event Type</label>
                                                <select class="form-select" id="f-type">
                                                    <option value="bg-primary-subtle">Meeting</option>
                                                    <option value="bg-danger-subtle">Expiry / Deadline</option>
                                                    <option value="bg-success-subtle">Renewal</option>
                                                    <option value="bg-warning-subtle">Mobility / Exchange</option>
                                                    <option value="bg-info-subtle">Partnership Review</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Event Name <span class="text-danger">*</span></label>
                                                <input type="text" class="form-control" id="f-title" placeholder="e.g. MOA Renewal â€“ Osaka University">
                                                <div class="invalid-feedback">Please provide an event name.</div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Date <span class="text-danger">*</span></label>
                                                <input type="date" class="form-control" id="f-date">
                                            </div>
                                            <div class="row mb-3">
                                                <div class="col-6">
                                                    <label class="form-label">Start Time</label>
                                                    <input type="time" class="form-control" id="f-start">
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label">End Time</label>
                                                    <input type="time" class="form-control" id="f-end">
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Institution / Location</label>
                                                <input type="text" class="form-control" id="f-location" placeholder="e.g. Osaka University">
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label">Notes</label>
                                                <textarea class="form-control" id="f-desc" rows="2" placeholder="Additional notes..."></textarea>
                                            </div>
                                            <div class="mb-3" id="f-recipients-wrap">
                                                <label class="form-label" id="f-recipients-label">Notify Recipients <span class="text-muted fw-normal">(Optional)</span></label>
                                                <select class="form-select" id="f-recipients" multiple size="6">
                                                    <optgroup label="Roles">
                                                        <option value="all">All Users</option>
                                                        <option value="Administrator">Administrators</option>
                                                        <option value="Auth. Personnel">College Staff</option>
                                                        <option value="potential_partner">Partner</option>
                                                        <option value="Staff">CIRL Staff</option>
                                                    </optgroup>
                                                    <optgroup label="Individual Users" id="f-recipients-individuals"></optgroup>
                                                </select>
                                                <div class="form-text" id="f-recipients-help">Ctrl/Cmd-click to select multiple. Only the users selected here will be notified and e-mailed a Google Calendar invitation. Leave blank to create the event without notifying anyone.</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-soft-danger d-none" id="btn-delete"><i class="ri-close-line"></i> Delete</button>
                                        <button type="button" class="btn btn-soft-primary d-none" id="btn-edit-toggle"><i class="ri-edit-line"></i> Edit</button>
                                        <button type="button" class="btn btn-success d-none" id="btn-save"><i class="ri-save-line"></i> Save</button>
                                    </div>
                                </div>
                            </div>
                        </div><!-- end modal -->

                        <!-- Attendance modal: who was invited and who actually joined (server-recorded time) -->
                        <div class="modal fade" id="attendance-modal" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                <div class="modal-content border-0">
                                    <div class="modal-header p-3 bg-info-subtle">
                                        <h5 class="modal-title" id="attendance-title">Attendance</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                        <p class="text-muted fs-13 mb-3" id="attendance-meta"></p>
                                        <div class="alert alert-warning py-2 px-3 fs-12 d-none" id="attendance-warning"></div>
                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle mb-0">
                                                <thead class="table-light"><tr><th>Name</th><th>Role</th><th>Email</th><th>Invitation</th><th>Status</th><th>Time Joined</th></tr></thead>
                                                <tbody id="attendance-body"></tbody>
                                            </table>
                                        </div>
                                        <p class="text-muted fs-12 mt-3 mb-0">Invited means the user was added to the meeting; Joined means they clicked Join once the meeting started. The join time is recorded by the server.</p>
                                    </div>
                                </div>
                            </div>
                        </div><!-- end attendance modal -->

                    </div>
                </div>
            </div>
        </div>

        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6"><script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL</div>
                    <div class="col-sm-6"><div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div></div>
                </div>
            </div>
        </footer>
    </div>
</div>

<script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
<script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
<script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
<script src="/velzon/assets/js/app.js"></script>
<script src="/velzon/assets/libs/fullcalendar/index.global.min.js"></script>
<script src="/velzon/assets/libs/dragula/dragula.min.js"></script>

<script>
(function(){

// Auth. Personnel lost calendar create/edit/delete 2026-07-23 — view-only
// unless another existing permission explicitly grants editing (currently
// none does). Administrator keeps full management, unchanged. Staff gained
// the same full management as Administrator 2026-09-14 (requireStaffAccess
// now gates the create/edit/delete API routes too — see cirl.js).
var CAN_MANAGE = <%- JSON.stringify(canManageCalendar) %>;

var cal, bsModal, attendanceModal, currentEv = null, isAdding = false, saving = false, dropBusy = false, pendingRequestId = null;

// â”€â”€ Helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function str_dt(dt){
  if(!dt) return '';
  return dt.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
}
function str_tm(dt){
  if(!dt) return '';
  return dt.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'});
}
function str_tm_input(dt){
  if(!dt) return '';
  return String(dt.getHours()).padStart(2,'0')+':'+String(dt.getMinutes()).padStart(2,'0');
}
// Local calendar date for a date <input>. (toISOString().slice(0,10) gave the
// UTC date, which is the PREVIOUS day for any event before 08:00 Manila time —
// editing such an event silently moved it a day earlier.)
function str_date_input(dt){
  if(!dt) return '';
  return dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0')+'-'+String(dt.getDate()).padStart(2,'0');
}
// The month grid's height comes from FullCalendar's aspectRatio (width / height), so it shrinks
// with the window while the sidebar next to it keeps a fixed minimum height. From 1366px up the
// default (1.35) already matches that height; on narrower desktop widths (1200-1365px, where the
// two-column layout is still used) a lower ratio keeps the grid as tall as the sidebar instead
// of leaving the page ending under a short calendar.
function calendarAspect(w){ return w >= 1366 ? 1.35 : w >= 1280 ? 1.15 : w >= 1200 ? 0.95 : 1.35; }

// Wall-clock string in the SAME shape the Add/Edit form saves ("2026-09-29T21:44"
// or "2026-09-29" for all-day). Drag-and-drop used to save toISOString() (a UTC
// instant) instead, so one event could end up stored in two different formats.
function fc_wall(dt, allDay){
  var date = str_date_input(dt);
  return allDay ? date : date + 'T' + str_tm_input(dt);
}
function esc(str){ return String(str==null?'':str).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
// One token per Save / palette drop, so a repeated request for the same action
// is recognised by the server and cannot create a second event.
function newRequestId(){
  if(window.crypto && crypto.randomUUID) return crypto.randomUUID();
  return 'r' + Date.now().toString(36) + Math.random().toString(36).slice(2, 12);
}

// Result of a create/update: what Google Calendar did, and anyone who could not be e-mailed.
function reportInvitations(inv, doneText){
  var toast = doneText;
  var lines = [];
  if(inv && inv.invited){
    if(inv.google === 'sent') toast += ' Google Calendar is e-mailing the invitation to ' + inv.googleAttendees + ' attendee' + (inv.googleAttendees === 1 ? '' : 's') + '.';
    else if(inv.google === 'not_connected') lines.push('Google Calendar is not connected, so no invitation e-mails were sent. Connect it under Settings \u2192 Integrations.');
    else if(inv.google === 'failed') lines.push('Google Calendar did not send the invitation: ' + esc(inv.error || 'unknown error'));
    else if(inv.google === 'no_valid_attendees') lines.push('None of the invited users has a valid e-mail address, so no Google Calendar invitation was sent.');
  }
  ((inv && inv.skipped) || []).forEach(function(s){
    lines.push('Not e-mailed: <strong>' + esc(s.name || s.email || 'Unknown user') + '</strong>' + (s.name && s.email ? ' (' + esc(s.email) + ')' : '') + ' \u2014 ' + esc(s.reason));
  });
  showToast('<i class="ri-checkbox-circle-line me-1"></i>' + esc(toast));
  var box = document.getElementById('cal-notice');
  if(!box) return;
  box.innerHTML = lines.length
    ? '<div class="alert alert-warning alert-dismissible fade show" role="alert"><strong>' + esc(doneText.replace(/\.$/, '')) + ', but:</strong><br>' + lines.join('<br>') + '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>'
    : '';
}

function renderInvitationPanel(ev){
  var ep = ev.extendedProps, box = document.getElementById('v-invites');
  var count = CAN_MANAGE ? (ep.participantCount || 0) : 0;
  box.classList.toggle('d-none', !count);
  if(!count) return;
  document.getElementById('v-invite-summary').textContent = count + ' invited' + (ep.joinedCount ? ' \u00b7 ' + ep.joinedCount + ' joined' : '');
  var warn = [];
  if(!ep.googleEventId){
    var st = ep.googleSyncStatus;
    warn.push(st === 'not_connected' ? 'Google Calendar is not connected \u2014 no invitation e-mails were sent.'
      : st === 'failed' ? 'Google Calendar did not send the invitation: ' + esc(ep.googleSyncError || 'unknown error')
      : st === 'no_valid_attendees' ? 'No invited user has a valid e-mail address \u2014 no Google Calendar invitation was sent.'
      : 'No Google Calendar invitation was sent for this event.');
  }
  (ep.inviteSkipped || []).forEach(function(s){
    warn.push('Not e-mailed: ' + esc(s.name || s.email || 'Unknown user') + (s.name && s.email ? ' (' + esc(s.email) + ')' : '') + ' \u2014 ' + esc(s.reason));
  });
  var w = document.getElementById('v-invite-warning');
  w.innerHTML = warn.join('<br>');
  w.classList.toggle('d-none', !warn.length);
}

function saveMove(dbId, updates, info){
  apiPatch(dbId, updates).then(function(data){
    if(!data.success){ info.revert(); showToast(data.error || 'Could not move the event.', '#f06548'); return; }
    syncFromServer(info.event, data.event);
    reportInvitations(data.invitations, 'Event updated.');
    upcomingEvent();
  }).catch(function(){ info.revert(); showToast('Error saving event.', '#f06548'); });
}

function openAttendance(){
  if(!currentEv) return;
  var id = currentEv.extendedProps.dbId || currentEv.id;
  fetch('/api/calendarevents/' + id + '/attendance').then(function(r){ return r.json(); }).then(function(d){
    if(d.error){ showToast(d.error, '#f06548'); return; }
    document.getElementById('attendance-title').textContent = d.event.title + ' \u2014 Attendance';
    document.getElementById('attendance-meta').textContent = (d.event.startsAtDisplay ? 'Starts ' + d.event.startsAtDisplay + ' (' + d.timeZone + '). ' : '') + d.summary.joined + ' of ' + d.summary.invited + ' invited participant' + (d.summary.invited === 1 ? '' : 's') + ' joined.';
    var warn = [];
    if(d.google.status !== 'sent') warn.push(d.google.status === 'not_connected' ? 'Google Calendar is not connected \u2014 no invitation e-mails were sent.' : d.google.status === 'failed' ? 'Google Calendar did not send the invitation: ' + esc(d.google.error || 'unknown error') : 'No Google Calendar invitation was sent for this event.');
    (d.skipped || []).forEach(function(s){ warn.push('Not e-mailed: ' + esc(s.name || s.email || 'Unknown user') + (s.name && s.email ? ' (' + esc(s.email) + ')' : '') + ' \u2014 ' + esc(s.reason)); });
    var w = document.getElementById('attendance-warning'); w.innerHTML = warn.join('<br>'); w.classList.toggle('d-none', !warn.length);
    document.getElementById('attendance-body').innerHTML = d.participants.length ? d.participants.map(function(p){
      var joined = p.status === 'Joined';
      return '<tr><td>' + esc(p.name) + '</td><td>' + esc(p.role) + '</td><td class="text-break">' + esc(p.email) + '</td><td>' + esc(p.invitation) + '</td>'
        + '<td><span class="badge ' + (joined ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary') + '">' + esc(p.status) + '</span></td>'
        + '<td' + (joined ? ' title="' + esc(p.joinedDateDisplay) + ' (' + esc(d.timeZone) + ')"' : '') + '>' + (joined ? esc(p.joinedAtDisplay) : '\u2014') + '</td></tr>';
    }).join('') : '<tr><td colspan="6" class="text-muted text-center">Nobody was invited to this event.</td></tr>';
    bsModal.hide();
    attendanceModal.show();
  }).catch(function(){ showToast('Could not load the attendance list.', '#f06548'); });
}

// After the server answers a move/edit, keep the calendar's copy of the event in step.
function syncFromServer(fcEvent, doc){
  if(!doc) return;
  fcEvent.setExtendedProp('googleEventId', doc.googleEventId || null);
  fcEvent.setExtendedProp('googleSyncStatus', doc.googleSyncStatus || null);
  fcEvent.setExtendedProp('googleSyncError', doc.googleSyncError || null);
  fcEvent.setExtendedProp('inviteSkipped', doc.inviteSkipped || []);
  fcEvent.setExtendedProp('participantCount', (doc.participantEmails || []).length || fcEvent.extendedProps.participantCount || 0);
}

// â”€â”€ Upcoming events sidebar â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function upcomingEvent(){
  if(!cal) return;
  var now = new Date();
  var evs = cal.getEvents().filter(function(e){ return e.start && e.start >= now; })
              .sort(function(a,b){ return a.start - b.start; }).slice(0,10);
  var html = '';
  evs.forEach(function(e){
    var cls = e.classNames[0] || 'bg-primary-subtle';
    var tc  = cls.replace('-subtle','').replace('bg-','text-');
    html += '<div class="card mb-2"><div class="card-body p-3">'
      + '<div class="d-flex mb-1"><div class="flex-grow-1"><i class="mdi mdi-checkbox-blank-circle me-2 '+tc+'"></i>'
      + '<span class="fw-medium">'+str_dt(e.start)+'</span></div>'
      + '<div class="flex-shrink-0"><small class="badge bg-primary-subtle text-primary ms-auto">'+str_tm(e.start)+'</small></div></div>'
      + '<h6 class="card-title fs-14 mb-1">'+e.title+'</h6>'
      + '<p class="text-muted text-truncate mb-0 fs-12">'+(e.extendedProps.description||'')+'</p>'
      + '</div></div>';
  });
  document.getElementById('upcoming-event-list').innerHTML = html || '<p class="text-muted fs-12">No upcoming events.</p>';
}

// â”€â”€ API helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function apiPost(payload){ return fetch('/api/calendarevents',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).then(function(r){return r.json();}); }
function apiPatch(id,payload){ return fetch('/api/calendarevents/'+id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}).then(function(r){return r.json();}); }
function apiDelete(id){ return fetch('/api/calendarevents/'+id,{method:'DELETE'}).then(function(r){return r.json();}); }

// â”€â”€ Modal helpers â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function showView(ev){
  currentEv = ev; isAdding = false;
  document.getElementById('modal-title').textContent = ev.title;
  document.getElementById('view-mode').classList.remove('d-none');
  document.getElementById('edit-mode').classList.add('d-none');
  document.getElementById('v-date').textContent = str_dt(ev.start);
  document.getElementById('v-time').textContent = ev.allDay ? 'All day' : (str_tm(ev.start)+(ev.end?' â€“ '+str_tm(ev.end):''));
  document.getElementById('v-location').textContent = ev.extendedProps.location || 'â€”';
  document.getElementById('v-desc').textContent     = ev.extendedProps.description || 'â€”';
  document.getElementById('v-gcal-badge').classList.toggle('d-none', !ev.extendedProps.googleEventId);
  MeetingJoin.render(ev.extendedProps.dbId || ev.id, ev.extendedProps.myInvite);
  renderInvitationPanel(ev);
  document.getElementById('btn-delete').classList.toggle('d-none', !CAN_MANAGE);
  document.getElementById('btn-edit-toggle').classList.toggle('d-none', !CAN_MANAGE);
  document.getElementById('btn-save').classList.add('d-none');
  bsModal.show();
}

function showAdd(dateStr){
  currentEv = null; isAdding = true; pendingRequestId = newRequestId();
  document.getElementById('f-recipients-label').innerHTML = 'Notify Recipients <span class="text-muted fw-normal">(Optional)</span>';
  document.getElementById('f-recipients-help').textContent = 'Ctrl/Cmd-click to select multiple. Only the users selected here will be notified and e-mailed a Google Calendar invitation. Leave blank to create the event without notifying anyone.';
  document.getElementById('modal-title').textContent = 'Add Event';
  document.getElementById('view-mode').classList.add('d-none');
  document.getElementById('edit-mode').classList.remove('d-none');
  document.getElementById('f-title').value    = '';
  document.getElementById('f-date').value     = dateStr || '';
  document.getElementById('f-start').value    = '';
  document.getElementById('f-end').value      = '';
  document.getElementById('f-location').value = '';
  document.getElementById('f-desc').value     = '';
  document.getElementById('f-type').value     = 'bg-primary-subtle';
  document.getElementById('v-gcal-badge').classList.add('d-none');
  document.getElementById('f-recipients-wrap').classList.remove('d-none');
  Array.from(document.getElementById('f-recipients').options).forEach(function(o){ o.selected = false; });
  document.getElementById('btn-delete').classList.add('d-none');
  document.getElementById('btn-edit-toggle').classList.add('d-none');
  document.getElementById('btn-save').classList.remove('d-none');
  bsModal.show();
}

function showEdit(){
  if(!currentEv) return;
  document.getElementById('modal-title').textContent = 'Edit Event';
  document.getElementById('view-mode').classList.add('d-none');
  document.getElementById('edit-mode').classList.remove('d-none');
  document.getElementById('f-title').value    = currentEv.title;
  document.getElementById('f-date').value     = str_date_input(currentEv.start);
  document.getElementById('f-start').value    = currentEv.allDay ? '' : str_tm_input(currentEv.start);
  document.getElementById('f-end').value      = currentEv.end && !currentEv.allDay ? str_tm_input(currentEv.end) : '';
  document.getElementById('f-location').value = currentEv.extendedProps.location    || '';
  document.getElementById('f-desc').value     = currentEv.extendedProps.description || '';
  document.getElementById('f-type').value     = currentEv.classNames[0] || 'bg-primary-subtle';
  // Editing never re-notifies the people already invited; anyone selected here is ADDED
  // (notified, added to the Google event, and e-mailed the invitation).
  document.getElementById('f-recipients-wrap').classList.remove('d-none');
  Array.from(document.getElementById('f-recipients').options).forEach(function(o){ o.selected = false; });
  document.getElementById('f-recipients-label').innerHTML = 'Add attendees <span class="text-muted fw-normal">(Optional)</span>';
  document.getElementById('f-recipients-help').textContent = 'Already-invited people are kept. Anyone selected here is added and sent a Google Calendar invitation. Leave blank to change nothing.';
  document.getElementById('btn-delete').classList.remove('d-none');
  document.getElementById('btn-edit-toggle').classList.add('d-none');
  document.getElementById('btn-save').classList.remove('d-none');
}

// â”€â”€ Build FullCalendar event object from DB doc â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function docToFcEvent(doc){
  return {
    id:        doc.id,
    title:     doc.title,
    start:     doc.start,
    end:       doc.end || undefined,
    allDay:    doc.allDay || false,
    className: doc.className || 'bg-primary-subtle',
    extendedProps: {
      location:    doc.location    || '',
      description: doc.description || '',
      dbId:        doc.id,
      googleEventId: doc.googleEventId || null,
      googleSyncStatus: doc.googleSyncStatus || null,
      googleSyncError:  doc.googleSyncError || null,
      inviteSkipped:    doc.inviteSkipped || [],
      participantCount: doc.participantCount || 0,
      joinedCount:      doc.joinedCount || 0,
      myInvite:         doc.myInvite || null
    }
  };
}

// â”€â”€ DOMContentLoaded â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
document.addEventListener('DOMContentLoaded', function(){
  bsModal = new bootstrap.Modal(document.getElementById('event-modal'));
  attendanceModal = new bootstrap.Modal(document.getElementById('attendance-modal'));
  document.getElementById('event-modal').addEventListener('hidden.bs.modal', MeetingJoin.stop);
  document.getElementById('btn-attendance').addEventListener('click', openAttendance);
  // If this user joins from the modal, keep the calendar's copy of the event current.
  MeetingJoin.onJoined(function(invite){ if(currentEv) currentEv.setExtendedProp('myInvite', invite); });
  var calEl = document.getElementById('calendar');

  // Deep-link support so a "New event" notification can jump straight to that
  // event's detail modal: /calendar?id=5. FullCalendar loads its events feed
  // asynchronously, so this only runs once the feed finishes loading.
  var deepLinkOpened = false;
  function openFromQuery(){
    if (deepLinkOpened) return;
    var id = new URLSearchParams(window.location.search).get('id');
    if (!id) { deepLinkOpened = true; return; }
    var ev = cal.getEventById(id);
    if (ev) { deepLinkOpened = true; showView(ev); }
  }

  // Individual-user recipient options — /api/users is Administrator/Staff-only
  // (requireStaffAccess), so Auth. Personnel (who can also reach this page)
  // simply won't see this group populated; the role-based options above
  // still work for them.
  function escapeHtml(str){ return String(str==null?'':str).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  fetch('/api/users').then(function(r){ return r.ok ? r.json() : []; }).then(function(users){
    var group = document.getElementById('f-recipients-individuals');
    group.innerHTML = users.map(function(u){ return '<option value="'+escapeHtml(u.email)+'">'+escapeHtml(u.name)+' ('+escapeHtml(u.email)+')</option>'; }).join('');
  }).catch(function(){ /* Auth. Personnel: no individual-user list, role options still work */ });

  cal = new FullCalendar.Calendar(calEl, {
    timeZone:    'local',
    headerToolbar: { left:'prev,next today', center:'title', right:'dayGridMonth,timeGridWeek,timeGridDay,listMonth' },
    initialView: 'dayGridMonth',
    aspectRatio: calendarAspect(window.innerWidth),
    editable:    CAN_MANAGE,
    droppable:   CAN_MANAGE,
    selectable:  CAN_MANAGE,
    navLinks:    true,
    events:      '/api/calendarevents',   // FullCalendar fetches & maps automatically
    dayMaxEvents: 3,

    // FullCalendar JSON feed: map raw docs to FC event objects
    eventDataTransform: function(doc){ return docToFcEvent(doc); },

    windowResize: function(){
      var w = window.innerWidth;
      cal.setOption('aspectRatio', calendarAspect(w));
      cal.changeView(w < 768 ? 'listMonth' : w < 1200 ? 'timeGridWeek' : 'dayGridMonth');
    },
    select:      function(info){ showAdd(info.startStr.slice(0,10)); },
    eventClick:  function(info){ showView(info.event); },

    // Drag-drop moves the event: exactly one PATCH per gesture, in the same
    // wall-clock format the Add/Edit form saves. The server patches the SAME
    // Google Calendar event (never inserts a new one) and Google e-mails the
    // attendees the change.
    eventDrop: function(info){
      var ev = info.event, dbId = ev.extendedProps.dbId || ev.id;
      saveMove(dbId, { start: fc_wall(ev.start, ev.allDay), end: ev.end ? fc_wall(ev.end, ev.allDay) : null, allDay: ev.allDay }, info);
    },

    // Resize updates end time in DB
    eventResize: function(info){
      var ev = info.event, dbId = ev.extendedProps.dbId || ev.id;
      saveMove(dbId, { end: ev.end ? fc_wall(ev.end, ev.allDay) : null }, info);
    },

    // Drag an external event tile onto the calendar. The tile's Draggable is
    // configured with create:false (below), so FullCalendar does NOT add its own
    // event on drop — this handler saves it once and adds the saved event once.
    // (Before, FullCalendar added a phantom event AND this handler added the real
    // one, so every palette drop showed two events, only one of them saved.)
    drop: function(info){
      if(dropBusy) return;
      dropBusy = true;
      var cls   = info.draggedEl.dataset.class || 'bg-primary-subtle';
      var title = info.draggedEl.innerText.trim();
      var payload = { title: title, start: info.dateStr, allDay: true, className: cls, location: '', description: '', clientRequestId: newRequestId() };
      apiPost(payload).then(function(data){
        if(data.success){
          if(!cal.getEventById(String(data.event.id))) cal.addEvent(docToFcEvent(data.event));
          upcomingEvent();
        } else { showToast(data.error || 'Could not create the event.', '#f06548'); }
      }).catch(function(e){ console.error(e); showToast('Error saving event.', '#f06548'); })
        .then(function(){ dropBusy = false; });
    },

    // List view is much shorter than the sidebar next to it: let its card fill the row.
    datesSet: function(info){
      var card = document.querySelector('.cal-card');
      if (card) card.classList.toggle('cal-card-fill', info.view.type === 'listMonth');
    },
    eventDidMount: function(){ upcomingEvent(); },
    loading: function(isLoading){ if (!isLoading) openFromQuery(); }
  });

  cal.render();

  // Draggable external events (Administrator/Staff only — the palette isn't rendered otherwise)
  if(CAN_MANAGE && typeof FullCalendar.Draggable !== 'undefined'){
    new FullCalendar.Draggable(document.getElementById('external-events'),{
      itemSelector: '.external-event',
      eventData: function(el){ return { title: el.innerText.trim(), className: el.dataset.class, create: false }; }
    });
  }

  var btnNewEvent = document.getElementById('btn-new-event');
  if (btnNewEvent) btnNewEvent.addEventListener('click', function(){ showAdd(''); });
  document.getElementById('btn-edit-toggle').addEventListener('click', showEdit);

  // â”€â”€ Save (add or edit) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document.getElementById('btn-save').addEventListener('click', function(){
    if(saving) return; // a second click while the first request is in flight would be a second Save
    var title  = document.getElementById('f-title').value.trim();
    var date   = document.getElementById('f-date').value;
    var tinput = document.getElementById('f-title');
    if(!title || !date){ tinput.classList.add('is-invalid'); return; }
    tinput.classList.remove('is-invalid');

    var st    = document.getElementById('f-start').value;
    var et    = document.getElementById('f-end').value;
    var start = st ? date + 'T' + st : date;
    var end   = et ? date + 'T' + et : null;
    if(st && et && et < st){ showToast('The end time cannot be before the start time.', '#f06548'); return; }
    var cls   = document.getElementById('f-type').value;
    var loc   = document.getElementById('f-location').value.trim();
    var desc  = document.getElementById('f-desc').value.trim();
    var recipients = Array.from(document.getElementById('f-recipients').selectedOptions).map(function(o){ return o.value; });
    var saveBtn = document.getElementById('btn-save');
    function finish(){ saving = false; saveBtn.disabled = false; }
    saving = true; saveBtn.disabled = true;

    if(currentEv && !isAdding){
      // EDIT — persist to MongoDB then update FC event (the same event; never a new one)
      var dbId   = currentEv.extendedProps.dbId || currentEv.id;
      var updates = { title:title, start:start, end:end, allDay:!st, className:cls, location:loc, description:desc };
      if(recipients.length) updates.recipients = recipients;
      apiPatch(dbId, updates).then(function(data){
        if(data.success){
          currentEv.setProp('title', title);
          currentEv.setProp('classNames', [cls]);
          currentEv.setStart(start);
          currentEv.setEnd(end);
          currentEv.setExtendedProp('location', loc);
          currentEv.setExtendedProp('description', desc);
          syncFromServer(currentEv, data.event);
          bsModal.hide(); upcomingEvent();
          reportInvitations(data.invitations, 'Event updated.');
        } else { showToast(data.error || 'Could not save the event.', '#f06548'); }
      }).catch(function(e){ console.error(e); showToast('Error saving event.', '#f06548'); }).then(finish);
    } else {
      // ADD — persist to MongoDB then add to FC
      var payload = { title:title, start:start, end:end, allDay:!st, className:cls, location:loc, description:desc, recipients:recipients, clientRequestId: pendingRequestId };
      apiPost(payload).then(function(data){
        if(data.success){
          if(!cal.getEventById(String(data.event.id))) cal.addEvent(docToFcEvent(data.event));
          pendingRequestId = newRequestId();
          bsModal.hide(); upcomingEvent();
          reportInvitations(data.invitations, data.duplicate ? 'Event already created.' : 'Event created.');
        } else { showToast(data.error || 'Could not create the event.', '#f06548'); }
      }).catch(function(e){ console.error(e); showToast('Error saving event.', '#f06548'); }).then(finish);
    }
  });

  // â”€â”€ Delete â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document.getElementById('btn-delete').addEventListener('click', function(){
    if(!currentEv) return;
    if(!confirm('Delete "' + currentEv.title + '"?')) return;
    var dbId = currentEv.extendedProps.dbId || currentEv.id;
    apiDelete(dbId).then(function(data){
      if(data.success){ currentEv.remove(); bsModal.hide(); upcomingEvent(); showToast('<i class="ri-checkbox-circle-line me-1"></i>Event deleted.'); }
      else { showToast(data.error || 'Could not delete the event.', '#f06548'); }
    }).catch(function(e){ console.error(e); showToast('Error deleting event.', '#f06548'); });
  });
});

function showToast(msg, bg) {
  const t = document.getElementById('cal-toast');
  if (!t) return;
  t.innerHTML = msg; t.style.background = bg || '#405189';
  t.style.opacity = '1'; t.style.pointerEvents = 'auto';
  setTimeout(() => { t.style.opacity = '0'; t.style.pointerEvents = 'none'; }, 3500);
}

})();
</script>

<!-- Toast -->
<div id="cal-toast" style="
    position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;
    color:#fff;padding:.65rem 1.1rem;border-radius:.5rem;
    font-size:.8125rem;font-weight:600;
    box-shadow:0 4px 16px rgba(0,0,0,.18);
    opacity:0;pointer-events:none;transition:opacity .3s;
    display:flex;align-items:center;gap:.4rem;
"></div>

