<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg"
    data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <title>Dashboard | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <script src="/velzon/assets/js/layout.js"></script>
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" />
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet" />
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" />
    <link href="/velzon/assets/css/ciprms-bridge.css" rel="stylesheet" />
    <link href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" rel="stylesheet">
</head>

<body>

    <div id="layout-wrapper">

        <%- include('../partials/header') %>
            <%- include('../partials/sidebar_personnel') %>

                <div class="main-content">
                    <div class="page-content">
                        <div class="container-fluid">

                            <!-- Page Title -->
                            <div class="row">
                                <div class="col-12">
                                    <div
                                        class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                                        <h4 class="mb-sm-0">Institutional Decision Support System (DSS)</h4>
                                        <div class="page-title-right">
                                            <ol class="breadcrumb m-0">
                                                <li class="breadcrumb-item"><a href="/personnel/dashboard">CIPRMS</a></li>
                                                <li class="breadcrumb-item active">Dashboard</li>
                                            </ol>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- end page title -->

                            <!-- Row 1: Stat Cards -->
                            <div class="row">
                                <div class="col-xl-3 col-md-6">
                                    <div class="card card-animate">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <p class="fw-medium text-muted mb-0">Active MOA/MOU</p>
                                                    <h2 class="mt-4 ff-secondary fw-semibold"><span
                                                            class="counter-value"
                                                            data-target="<%= typeof stats !== 'undefined' ? stats.active : 37 %>">0</span>
                                                    </h2>
                                                    <p class="mb-0 text-muted"><span
                                                            class="badge bg-success-subtle text-success mb-0"><i
                                                                class="ri-checkbox-circle-line align-middle"></i>
                                                            Currently active</span></p>
                                                </div>
                                                <div>
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span
                                                            class="avatar-title bg-success-subtle rounded-circle fs-2">
                                                            <i class="ri-shake-hands-line text-success"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-3 col-md-6">
                                    <div class="card card-animate">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <p class="fw-medium text-muted mb-0">Expiring Soon</p>
                                                    <h2 class="mt-4 ff-secondary fw-semibold"><span
                                                            class="counter-value"
                                                            data-target="<%= typeof stats !== 'undefined' ? stats.expiring : 9 %>">0</span>
                                                    </h2>
                                                    <p class="mb-0 text-muted"><span
                                                            class="badge bg-warning-subtle text-warning mb-0"><i
                                                                class="ri-time-line align-middle"></i> Within 90
                                                            days</span></p>
                                                </div>
                                                <div>
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span
                                                            class="avatar-title bg-warning-subtle rounded-circle fs-2">
                                                            <i class="ri-time-line text-warning"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-3 col-md-6">
                                    <div class="card card-animate">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <p class="fw-medium text-muted mb-0">Expired MOA/MOU</p>
                                                    <h2 class="mt-4 ff-secondary fw-semibold"><span
                                                            class="counter-value"
                                                            data-target="<%= typeof stats !== 'undefined' ? stats.expired : 5 %>">0</span>
                                                    </h2>
                                                    <p class="mb-0 text-muted"><span
                                                            class="badge bg-danger-subtle text-danger mb-0"><i
                                                                class="ri-close-circle-line align-middle"></i> Require
                                                            renewal</span></p>
                                                </div>
                                                <div>
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span class="avatar-title bg-danger-subtle rounded-circle fs-2">
                                                            <i class="ri-close-circle-line text-danger"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-3 col-md-6">
                                    <div class="card card-animate">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <p class="fw-medium text-muted mb-0">Total Partnerships</p>
                                                    <h2 class="mt-4 ff-secondary fw-semibold"><span
                                                            class="counter-value"
                                                            data-target="<%= typeof stats !== 'undefined' ? stats.total : 51 %>">0</span>
                                                    </h2>
                                                    <p class="mb-0 text-muted"><span
                                                            class="badge bg-primary-subtle text-primary mb-0"><i
                                                                class="ri-file-list-3-line align-middle"></i> All
                                                            registered</span></p>
                                                </div>
                                                <div>
                                                    <div class="avatar-sm flex-shrink-0">
                                                        <span
                                                            class="avatar-title bg-primary-subtle rounded-circle fs-2">
                                                            <i class="ri-file-list-3-line text-primary"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- end row -->

                            <!-- Decision Support / AI Insights -->
                            <!-- Row 1.5: AI Insights -->
                            <div class="row">
                                <div class="col-xl-12">
                                    <div class="card bg-light-subtle shadow-none border-0 mb-4">
                                        <div class="card-header align-items-center d-flex bg-transparent border-0 pb-0">
                                            <h4 class="card-title mb-0 flex-grow-1">
                                                <i class="ri-lightbulb-flash-line me-2 text-primary"></i>Decision
                                                Support & Insights
                                            </h4>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-3">
                                                <!-- Insight 1 -->
                                                <div class="col-md-4">
                                                    <div class="alert alert-warning border-0 mb-0 d-flex flex-column h-100 shadow-sm"
                                                        style="background-color: #fff9eb;">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="ri-alert-line fs-20 me-2 text-warning"></i>
                                                            <h6 class="alert-heading fw-bold mb-0 text-warning">High
                                                                Renewal Priority</h6>
                                                        </div>
                                                        <p class="mb-3 fs-13 flex-grow-1 text-body">5 key MOAs
                                                            (including Tohoku University) are expiring within 90 days.
                                                            Immediate action is recommended to maintain program
                                                            continuity.</p>
                                                        <div>
                                                            <a href="/lifecycle"
                                                                class="btn btn-sm btn-soft-warning w-100 fw-medium">Initiate
                                                                Renewals <i
                                                                    class="ri-arrow-right-line align-middle ms-1"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- Insight 2 -->
                                                <div class="col-md-4">
                                                    <div class="alert alert-info border-0 mb-0 d-flex flex-column h-100 shadow-sm"
                                                        style="background-color: #e8f7fa;">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="ri-global-line fs-20 me-2 text-info"></i>
                                                            <h6 class="alert-heading fw-bold mb-0 text-info">Expansion
                                                                Opportunity</h6>
                                                        </div>
                                                        <p class="mb-3 fs-13 flex-grow-1 text-body">Data shows a 30%
                                                            increase in Student Exchange requests for South Korea.
                                                            Consider establishing new partnerships in this region.</p>
                                                        <div>
                                                            <a href="/personnel/lifecycle"
                                                                class="btn btn-sm btn-soft-info w-100 fw-medium">View
                                                                Region Data <i
                                                                    class="ri-arrow-right-line align-middle ms-1"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- Insight 3 -->
                                                <div class="col-md-4">
                                                    <div class="alert alert-success border-0 mb-0 d-flex flex-column h-100 shadow-sm"
                                                        style="background-color: #ecf9f0;">
                                                        <div class="d-flex align-items-center mb-2">
                                                            <i class="ri-pie-chart-2-line fs-20 me-2 text-success"></i>
                                                            <h6 class="alert-heading fw-bold mb-0 text-success">Resource
                                                                Optimization</h6>
                                                        </div>
                                                        <p class="mb-3 fs-13 flex-grow-1 text-body">3 partnerships have
                                                            zero recorded activities this year. Consider re-evaluating
                                                            these agreements to optimize resource allocation.</p>
                                                        <div>
                                                            <a href="/personnel/lifecycle"
                                                                class="btn btn-sm btn-soft-success w-100 fw-medium">Review
                                                                Inactive Partners <i
                                                                    class="ri-arrow-right-line align-middle ms-1"></i></a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- end row -->

                            <!-- Row 2: Charts -->
                            <div class="row">
                                <!-- By Type Chart -->
                                <div class="col-xl-6">
                                    <div class="card card-height-100">
                                        <div class="card-header align-items-center d-flex">
                                            <h4 class="card-title mb-0 flex-grow-1">Partnerships by Type & Status</h4>
                                        </div>
                                        <div class="card-body">
                                            <div id="type-status-chart" class="apex-charts" dir="ltr"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- By Institution Chart -->
                                <div class="col-xl-6">
                                    <div class="card card-height-100">
                                        <div class="card-header align-items-center d-flex">
                                            <h4 class="card-title mb-0 flex-grow-1">Partnerships by Institution</h4>
                                        </div>
                                        <div class="card-body">
                                            <div id="institution-chart" class="apex-charts" dir="ltr"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- end row -->

                            <!-- Row 3: Map + Partner Countries + Recent Activity -->
                            <div class="row">
                                <!-- Map -->
                                <div class="col-xl-8">
                                    <div class="card card-height-100">
                                        <div class="card-header align-items-center d-flex">
                                            <h4 class="card-title mb-0 flex-grow-1"><i
                                                    class="ri-map-2-line me-2 text-primary"></i>Partnerships
                                                Geographical Map</h4>
                                            <div class="flex-shrink-0 d-flex gap-1">
                                                <button
                                                    class="btn btn-soft-secondary btn-sm material-shadow-none continent-tab"
                                                    onclick="flyToContinent(this,34,100,4)">Asia</button>
                                                <button
                                                    class="btn btn-soft-secondary btn-sm material-shadow-none continent-tab"
                                                    onclick="flyToContinent(this,54,15,4)">Europe</button>
                                                <button
                                                    class="btn btn-soft-secondary btn-sm material-shadow-none continent-tab"
                                                    onclick="flyToContinent(this,38,-97,4)">Americas</button>
                                                <button
                                                    class="btn btn-soft-secondary btn-sm material-shadow-none continent-tab"
                                                    onclick="flyToContinent(this,-25,135,4)">Oceania</button>
                                                <button
                                                    class="btn btn-soft-primary btn-sm material-shadow-none continent-tab active"
                                                    onclick="flyToContinent(this,20,0,2)">World</button>
                                            </div>
                                        </div>
                                        <div class="card-body p-0">
                                            <div id="partnership-map" style="height:360px;border-radius:0 0 8px 8px;">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Top Partner Countries -->
                                <div class="col-xl-4">
                                    <div class="card card-height-100">
                                        <div class="card-header align-items-center d-flex">
                                            <h4 class="card-title mb-0 flex-grow-1">Top Partner Countries</h4>
                                            <span class="badge bg-primary-subtle text-primary">By Agreements</span>
                                        </div>
                                        <div class="card-body">
                                            <% var topPartners=[
                                                {country:'Japan',code:'jp',count:12,pct:100,lat:36,lng:138},
                                                {country:'United States',code:'us',count:9,pct:75,lat:38,lng:-97},
                                                {country:'South Korea',code:'kr',count:7,pct:58,lat:37,lng:127},
                                                {country:'Philippines',code:'ph',count:6,pct:50,lat:13,lng:122},
                                                {country:'China',code:'cn',count:5,pct:42,lat:35,lng:104},
                                                {country:'Australia',code:'au',count:4,pct:33,lat:-25,lng:133},
                                                {country:'Germany',code:'de',count:3,pct:25,lat:51,lng:10} ]; %>
                                                <% topPartners.forEach(function(p){ %>
                                                    <div class="d-flex align-items-center mb-3"
                                                        onclick="flyToContinent(null,<%=p.lat%>,<%=p.lng%>,5)"
                                                        style="cursor:pointer;">
                                                        <div class="flex-shrink-0 me-3">
                                                            <img src="https://flagcdn.com/w40/<%=p.code%>.png"
                                                                alt="<%=p.country%>" class="rounded"
                                                                style="width:32px;height:20px;object-fit:cover;">
                                                        </div>
                                                        <div class="flex-grow-1">
                                                            <div class="d-flex justify-content-between mb-1">
                                                                <span class="fs-13 fw-medium">
                                                                    <%=p.country%>
                                                                </span>
                                                                <span class="fs-12 text-muted">
                                                                    <%=p.count%>
                                                                </span>
                                                            </div>
                                                            <div class="progress" style="height:4px;">
                                                                <div class="progress-bar bg-primary"
                                                                    style="width:<%=p.pct%>%"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- end row -->

                            <!-- Row 4: Lifecycle Alerts -->
                            <div class="row">
                                <!-- Expiring Soon Table -->
                                <div class="col-xl-12">
                                    <div class="card">
                                        <div class="card-header align-items-center d-flex">
                                            <h4 class="card-title mb-0 flex-grow-1"><i
                                                    class="ri-alarm-warning-line me-2 text-warning"></i>Expiring
                                                Partnerships</h4>
                                        </div>
                                        <div class="card-body">
                                            <div class="table-responsive table-card align-items-center d-flex">
                                                <table
                                                    class="table table-borderless table-hover table-centered align-middle table-nowrap mb-0">
                                                    <thead class="text-muted bg-light-subtle">
                                                        <tr>
                                                            <th>Institution</th>
                                                            <th>Type</th>
                                                            <th>Country</th>
                                                            <th>Expires</th>
                                                            <th>Status</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td><span class="fw-medium">Bicol University</span></td>
                                                            <td><span
                                                                    class="badge bg-primary-subtle text-primary">MOA</span>
                                                            </td>
                                                            <td>Philippines</td>
                                                            <td>Jun 15, 2026</td>
                                                            <td><span
                                                                    class="badge bg-warning-subtle text-warning">Expiring
                                                                    Soon</span></td>
                                                        </tr>
                                                        <tr>
                                                            <td><span class="fw-medium">Tohoku University</span></td>
                                                            <td><span
                                                                    class="badge bg-primary-subtle text-primary">MOA</span>
                                                            </td>
                                                            <td>Japan</td>
                                                            <td>Jul 2, 2026</td>
                                                            <td><span
                                                                    class="badge bg-warning-subtle text-warning">Expiring
                                                                    Soon</span></td>
                                                        </tr>
                                                        <tr>
                                                            <td><span class="fw-medium">Yonsei University</span></td>
                                                            <td><span class="badge bg-info-subtle text-info">MOU</span>
                                                            </td>
                                                            <td>South Korea</td>
                                                            <td>Jul 30, 2026</td>
                                                            <td><span
                                                                    class="badge bg-warning-subtle text-warning">Expiring
                                                                    Soon</span></td>
                                                        </tr>
                                                        <tr>
                                                            <td><span class="fw-medium">University of Melbourne</span>
                                                            </td>
                                                            <td><span class="badge bg-info-subtle text-info">MOU</span>
                                                            </td>
                                                            <td>Australia</td>
                                                            <td>Aug 10, 2026</td>
                                                            <td><span
                                                                    class="badge bg-warning-subtle text-warning">Expiring
                                                                    Soon</span></td>
                                                        </tr>
                                                        <tr>
                                                            <td><span class="fw-medium">Harvard University</span></td>
                                                            <td><span
                                                                    class="badge bg-primary-subtle text-primary">MOA</span>
                                                            </td>
                                                            <td>USA</td>
                                                            <td>Jan 5, 2026</td>
                                                            <td><span
                                                                    class="badge bg-danger-subtle text-danger">Expired</span>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- end row -->

                        </div><!-- container-fluid -->
                    </div><!-- page-content -->

                    <footer class="footer">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-sm-6">
                                    <script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash;
                                    CSPC-CIRL
                                </div>
                                <div class="col-sm-6">
                                    <div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div>
                                </div>
                            </div>
                        </div>
                    </footer>
                </div><!-- end main content -->

    </div><!-- END layout-wrapper -->

    <!-- JAVASCRIPT -->
    <script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
    <script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
    <script src="/velzon/assets/js/pages/plugins/lord-icon-2.1.0.js"></script>
    <script src="/velzon/assets/js/plugins.js"></script>
    <script src="/velzon/assets/js/app.js"></script>
    <script src="/velzon/assets/libs/apexcharts/apexcharts.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        // ── Type & Status Bar Chart ─────────────────────────────────
        var typeChart = new ApexCharts(document.getElementById('type-status-chart'), {
            chart: { type: 'bar', height: 300, toolbar: { show: false } },
            plotOptions: { bar: { horizontal: false, columnWidth: '45%', borderRadius: 4 } },
            dataLabels: { enabled: false },
            series: [
                { name: 'MOA', data: [32] },
                { name: 'MOU', data: [19] },
                { name: 'Active', data: [37] },
                { name: 'Expiring', data: [9] },
                { name: 'Expired', data: [5] }
            ],
            xaxis: { categories: ['Agreements'] },
            colors: ['#405189', '#0ab39c', '#17c653', '#f7b84b', '#f06548'],
            legend: { position: 'bottom' },
            grid: { borderColor: '#f1f1f1' }
        });
        typeChart.render();

        // ── By Institution Horizontal Bar Chart — real data only ────
        var institutionChart = new ApexCharts(document.getElementById('institution-chart'), {
            chart: { type: 'bar', height: 300, toolbar: { show: false } },
            plotOptions: { bar: { horizontal: true, borderRadius: 4 } },
            dataLabels: { enabled: true },
            series: [{ name: 'Partnerships', data: [] }],
            xaxis: { categories: [] },
            colors: ['#405189'],
            grid: { borderColor: '#f1f1f1' }
        });
        institutionChart.render();
        fetch('/api/partnerships/stats').then(function (r) { return r.json(); }).then(function (stats) {
            var entries = Object.entries(stats.byInstitution || {}).sort(function (a, b) { return b[1] - a[1]; });
            institutionChart.updateOptions({
                series: [{ name: 'Partnerships', data: entries.map(function (e) { return e[1]; }) }],
                xaxis: { categories: entries.map(function (e) { return e[0]; }) }
            });
        }).catch(function (err) { console.error('Failed to load institution stats:', err); });

        // ── Leaflet Map ─────────────────────────────────────────────
        const map = L.map('partnership-map', { center: [20, 15], zoom: 2, zoomControl: true });
        L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap contributors &copy; CARTO', subdomains: 'abcd', maxZoom: 19
        }).addTo(map);

        const STATUS_COLOR = { active: '#17c653', expiring: '#f7b84b', expired: '#f06548' };
        const STATUS_RING = { active: '#d1fae5', expiring: '#fef3c7', expired: '#fee2e2' };

        const PARTNERSHIPS = [
            { name: 'De La Salle University', lat: 14.5627, lng: 120.9930, country: 'Philippines', type: 'MOA', status: 'active' },
            { name: 'Ateneo de Manila', lat: 14.6407, lng: 121.0778, country: 'Philippines', type: 'MOA', status: 'active' },
            { name: 'Bicol University', lat: 13.1391, lng: 123.7438, country: 'Philippines', type: 'MOA', status: 'expiring' },
            { name: 'Osaka University', lat: 34.8219, lng: 135.5235, country: 'Japan', type: 'MOA', status: 'active' },
            { name: 'University of Tokyo', lat: 35.7127, lng: 139.7613, country: 'Japan', type: 'MOU', status: 'active' },
            { name: 'Tohoku University', lat: 38.2558, lng: 140.8421, country: 'Japan', type: 'MOA', status: 'expiring' },
            { name: 'Seoul National University', lat: 37.4601, lng: 126.9522, country: 'South Korea', type: 'MOU', status: 'active' },
            { name: 'Yonsei University', lat: 37.5641, lng: 126.9381, country: 'South Korea', type: 'MOA', status: 'expiring' },
            { name: 'MIT', lat: 42.3601, lng: -71.0942, country: 'USA', type: 'MOA', status: 'active' },
            { name: 'Harvard University', lat: 42.3770, lng: -71.1167, country: 'USA', type: 'MOA', status: 'expired' },
            { name: 'Stanford University', lat: 37.4275, lng: -122.1697, country: 'USA', type: 'MOU', status: 'active' },
            { name: 'University of Melbourne', lat: -37.7963, lng: 144.9614, country: 'Australia', type: 'MOU', status: 'expiring' },
            { name: 'Tsinghua University', lat: 40.0022, lng: 116.3260, country: 'China', type: 'MOU', status: 'active' },
            { name: 'Fudan University', lat: 31.2986, lng: 121.5032, country: 'China', type: 'MOU', status: 'expired' },
            { name: 'Technical Univ. Munich', lat: 48.1499, lng: 11.5680, country: 'Germany', type: 'MOU', status: 'active' },
        ];

        function makeIcon(status) {
            const c = STATUS_COLOR[status], r = STATUS_RING[status];
            const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="32" viewBox="0 0 26 32">
        <ellipse cx="13" cy="30" rx="5" ry="2.5" fill="rgba(0,0,0,.18)"/>
        <circle cx="13" cy="13" r="12" fill="${r}" stroke="${c}" stroke-width="2.5"/>
        <circle cx="13" cy="13" r="6" fill="${c}"/>
    </svg>`;
            return L.divIcon({ className: '', html: svg, iconSize: [26, 32], iconAnchor: [13, 30], popupAnchor: [0, -28] });
        }

        PARTNERSHIPS.forEach(function (p) {
            const label = p.status.charAt(0).toUpperCase() + p.status.slice(1);
            const popup = `<div style="font-family:Inter,sans-serif;min-width:180px;">
        <div style="font-weight:700;font-size:13px;color:#0d1b3e;margin-bottom:4px;">${p.name}</div>
        <div style="font-size:11.5px;color:#64748b;margin-bottom:6px;">${p.country}</div>
        <div style="display:flex;gap:6px;">
            <span style="font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px;background:#e8f0fe;color:#405189;">${p.type}</span>
            <span style="font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px;background:${STATUS_RING[p.status]};color:${STATUS_COLOR[p.status]};">${label}</span>
        </div>
    </div>`;
            L.marker([p.lat, p.lng], { icon: makeIcon(p.status) }).addTo(map).bindPopup(popup, { maxWidth: 240 });
        });

        function flyToContinent(btn, lat, lng, zoom) {
            document.querySelectorAll('.continent-tab').forEach(function (t) { t.classList.remove('active', 'btn-soft-primary'); t.classList.add('btn-soft-secondary'); });
            if (btn) { btn.classList.remove('btn-soft-secondary'); btn.classList.add('active', 'btn-soft-primary'); }
            map.flyTo([lat, lng], zoom, { duration: 1.2 });
        }
        setTimeout(function () { map.invalidateSize(); }, 300);
    </script>

</body>

</html>