<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <%- include('../partials/ui-state-init') %>
    <title>Monitoring | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
</head>
<body>

<div id="layout-wrapper">
    <%- include('../partials/header') %>
    <%- include('../partials/sidebar_personnel') %>

    <div class="main-content">
        <div class="page-content">
            <div class="container-fluid">

                <div class="row">
                  <div class="col-12">
                    <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
                      <h4 class="mb-sm-0"><i class="ri-refresh-line me-2 text-primary"></i>Monitoring</h4>
                      <div class="page-title-right">
                        <ol class="breadcrumb m-0" id="page-breadcrumb">
                          <li class="breadcrumb-item"><a href="/personnel/monitoring">CIPRMS</a></li>
                          <li class="breadcrumb-item active">Monitoring</li>
                        </ol>
                      </div>
                    </div>
                  </div>
                </div>
                <p class="text-muted mb-3"><i class="ri-shield-check-line me-1"></i>This page tracks only your own submitted requests, documents, and partnership record.</p>

                <!-- Stat Cards — each one jumps to (and, where relevant, highlights)
                     the matching section below. -->
                <div class="row">
                    <div class="col-xl-3 col-md-6">
                        <div class="card card-animate" style="cursor:pointer" onclick="goToTotal()" role="button" title="Go to your document requests">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="fw-medium text-muted mb-0">Total Document Requests</p>
                                        <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-total">0</span></h2>
                                        <p class="mb-0 text-muted"><span class="badge bg-primary-subtle text-primary mb-0"><i class="ri-file-list-3-line align-middle"></i> Submitted</span></p>
                                    </div>
                                    <div class="avatar-sm flex-shrink-0">
                                        <span class="avatar-title bg-primary-subtle rounded-circle fs-2"><i class="ri-file-list-3-line text-primary"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="card card-animate" style="cursor:pointer" onclick="goToInProgress()" role="button" title="Go to your in-progress document requests">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="fw-medium text-muted mb-0">In Progress</p>
                                        <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-progress">0</span></h2>
                                        <p class="mb-0 text-muted"><span class="badge bg-warning-subtle text-warning mb-0"><i class="ri-time-line align-middle"></i> Awaiting review</span></p>
                                    </div>
                                    <div class="avatar-sm flex-shrink-0">
                                        <span class="avatar-title bg-warning-subtle rounded-circle fs-2"><i class="ri-time-line text-warning"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="card card-animate" style="cursor:pointer" onclick="goToApproved()" role="button" title="Go to your approved document requests">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="fw-medium text-muted mb-0">Approved</p>
                                        <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-approved">0</span></h2>
                                        <p class="mb-0 text-muted"><span class="badge bg-success-subtle text-success mb-0"><i class="ri-checkbox-circle-line align-middle"></i> Confirmed</span></p>
                                    </div>
                                    <div class="avatar-sm flex-shrink-0">
                                        <span class="avatar-title bg-success-subtle rounded-circle fs-2"><i class="ri-checkbox-circle-line text-success"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="card card-animate" style="cursor:pointer" onclick="goToDocuments()" role="button" title="Go to Document Verification Status">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <p class="fw-medium text-muted mb-0">Documents on File</p>
                                        <h2 class="mt-4 ff-secondary fw-semibold"><span class="counter-value" id="cnt-docs">0</span></h2>
                                        <p class="mb-0 text-muted"><span class="badge bg-info-subtle text-info mb-0"><i class="ri-file-shield-2-line align-middle"></i> Uploaded</span></p>
                                    </div>
                                    <div class="avatar-sm flex-shrink-0">
                                        <span class="avatar-title bg-info-subtle rounded-circle fs-2"><i class="ri-file-shield-2-line text-info"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end stat cards -->

                <!-- My Document Requests -->
                <div class="row">
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-header d-flex align-items-center">
                                <h4 class="card-title mb-0 flex-grow-1"><i class="ri-file-shield-2-line me-2"></i>My Document Requests</h4>
                                <a href="/personnel/requests" class="btn btn-soft-primary btn-sm"><i class="ri-add-line me-1"></i>New Request</a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Request #</th><th>Institution</th><th>Document Type</th><th>Status</th>
                                                <th>Date Submitted</th><th>Last Updated</th><th>Current Stage</th>
                                                <th>Administrator</th><th>Remarks</th><th class="text-end">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="dr-monitor-body">
                                            <tr><td colspan="10" class="text-center text-muted py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Approval Progress -->
                    <div class="col-xl-6">
                        <div class="card">
                            <div class="card-header"><h4 class="card-title mb-0"><i class="ri-progress-4-line me-2"></i>Approval Progress</h4></div>
                            <div class="card-body" id="approval-progress-body">
                                <div class="text-center text-muted py-4"><div class="spinner-border text-primary" role="status"></div></div>
                            </div>
                        </div>
                    </div>

                    <!-- Document Verification Status -->
                    <div class="col-xl-6">
                        <div class="card">
                            <div class="card-header"><h4 class="card-title mb-0"><i class="ri-file-shield-2-line me-2"></i>Document Verification Status</h4></div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead class="table-light"><tr><th>Document</th><th>Status</th></tr></thead>
                                        <tbody id="doc-verification-body">
                                            <tr><td colspan="2" class="text-center text-muted py-4">Loading…</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Document Request Draft Collaboration Modal -->
        <div class="modal fade" id="dr-draft-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="dr-draft-modal-title"><i class="ri-file-list-3-line me-2 text-primary"></i>Draft Collaboration</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="dr-draft-timeline" class="mb-3"></div>
                        <div class="alert alert-secondary fs-13 mb-0 border-top pt-3">
                            <i class="ri-information-line me-1"></i>Draft versions are uploaded by CIRL — track every version above as they come in.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Draft Preview Modal — shared by both the Partnership Request and
             Document Request draft timelines; opens on top of whichever
             draft-collaboration modal triggered it. -->
        <div class="modal fade" id="draft-preview-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="ri-eye-line me-2 text-primary"></i>Draft Preview</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="draft-preview-body" class="mb-3"></div>
                        <div class="border-top pt-3">
                            <p class="fs-13 fw-medium mb-1" id="draft-preview-filename">—</p>
                            <p class="fs-13 text-muted mb-1">Uploaded by: <span id="draft-preview-uploader">—</span></p>
                            <p class="fs-13 text-muted mb-1">Date: <span id="draft-preview-when">—</span></p>
                            <p class="fs-13 text-muted mb-0">Note: <span id="draft-preview-note">—</span></p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="#" id="draft-preview-download-btn" class="btn btn-success btn-sm"><i class="ri-download-2-line me-1"></i>Download</a>
                        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Document Request Details Modal -->
        <div class="modal fade" id="dr-detail-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="ri-file-shield-2-line me-2 text-primary"></i>Document Request Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-6"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Request #</label><div class="fw-bold fs-13" id="drd-id">—</div></div>
                            <div class="col-6"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Document Type</label><div class="fw-bold fs-13" id="drd-type">—</div></div>
                            <div class="col-6"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Institution</label><div class="fw-bold fs-13" id="drd-inst">—</div></div>
                            <div class="col-6"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Status</label><div id="drd-status">—</div></div>
                            <div class="col-6"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Date Submitted</label><div class="fw-bold fs-13" id="drd-date">—</div></div>
                            <div class="col-6"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Last Updated</label><div class="fw-bold fs-13" id="drd-updated">—</div></div>
                            <div class="col-6"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Current Stage</label><div class="fw-bold fs-13" id="drd-stage">—</div></div>
                            <div class="col-6"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Administrator</label><div class="fw-bold fs-13" id="drd-admin">—</div></div>
                            <div class="col-12"><label class="input-label text-muted fs-10 fw-bold text-uppercase d-block mb-1">Workflow Progress</label><div id="drd-progress" class="d-flex flex-wrap gap-3">—</div></div>
                            <div class="col-12"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Purpose</label><div class="text-muted fs-13" id="drd-purpose">—</div></div>
                            <div class="col-12"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Remarks (CIRL)</label><div class="text-muted fs-13" id="drd-remark">—</div></div>
                            <div class="col-12"><label class="input-label text-muted fs-10 fw-bold text-uppercase">Attached Documents</label><div id="drd-docs">—</div></div>
                        </div>
                    </div>
                    <div class="modal-footer" id="drd-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6"><script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL</div>
                    <div class="col-sm-6"><div class="text-sm-end d-none d-sm-block">Camarines Sur Polytechnic Colleges</div></div>
                </div>
            </div>
        </footer>
    </div>
</div>

<div id="mon-toast" style="position:fixed;bottom:1.5rem;right:1.5rem;z-index:9999;color:#fff;padding:.65rem 1.1rem;border-radius:.5rem;font-size:.8125rem;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,.18);opacity:0;pointer-events:none;transition:opacity .3s;"></div>

<script src="/velzon/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/velzon/assets/libs/simplebar/simplebar.min.js"></script>
<script src="/velzon/assets/libs/node-waves/waves.min.js"></script>
<script src="/velzon/assets/libs/feather-icons/feather.min.js"></script>
<script src="/velzon/assets/js/app.js"></script>
<script>
    function showToast(msg, bg) {
        var t = document.getElementById('mon-toast');
        t.style.background = bg || '#405189'; t.textContent = msg; t.style.opacity = '1';
        clearTimeout(t._to); t._to = setTimeout(function () { t.style.opacity = '0'; }, 3000);
    }

    function escapeHtml(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    // ── Inline "See more / See less" for long table cell text (Remarks,
    // Document Type). Renders both the truncated and full text into the DOM
    // up front and toggles which is visible — the complete original value is
    // never discarded, only visually collapsed. ────────────────────────────
    function renderExpandable(text, limit) {
        var raw = text == null ? '' : String(text);
        if (!raw) return '—';
        var safeFull = escapeHtml(raw);
        if (raw.length <= limit) return safeFull;
        var safeShort = escapeHtml(raw.slice(0, limit)) + '…';
        return '<span class="text-expandable">' +
            '<span class="text-expandable-short">' + safeShort + '</span>' +
            '<span class="text-expandable-full d-none">' + safeFull + '</span>' +
            ' <button type="button" class="btn btn-link btn-sm p-0 align-baseline text-expandable-toggle" onclick="toggleExpandable(this)" aria-expanded="false">See more</button>' +
            '</span>';
    }

    function toggleExpandable(btn) {
        var wrap = btn.closest('.text-expandable');
        if (!wrap) return;
        var shortEl = wrap.querySelector('.text-expandable-short');
        var fullEl = wrap.querySelector('.text-expandable-full');
        var expanded = !fullEl.classList.contains('d-none');
        fullEl.classList.toggle('d-none', expanded);
        shortEl.classList.toggle('d-none', !expanded);
        btn.textContent = expanded ? 'See more' : 'See less';
        btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
    }

    // ── Breadcrumb — reflects whichever Document Request modal is currently
    // open on top of Monitoring, e.g. CIPRMS > Monitoring > Document Request >
    // <institution> [> Draft Collaboration]. `labels` is everything after
    // "CIPRMS"; the last one renders as the active (non-link) crumb. ────────
    function setBreadcrumb(labels) {
        var ol = document.getElementById('page-breadcrumb');
        if (!ol) return;
        var html = '<li class="breadcrumb-item"><a href="/personnel/monitoring">CIPRMS</a></li>';
        labels.forEach(function (label, i) {
            var isLast = i === labels.length - 1;
            html += isLast
                ? '<li class="breadcrumb-item active">' + escapeHtml(label) + '</li>'
                : '<li class="breadcrumb-item"><a href="/personnel/monitoring">' + escapeHtml(label) + '</a></li>';
        });
        ol.innerHTML = html;
    }
    function resetBreadcrumb() { setBreadcrumb(['Monitoring']); }

    function drRequestLabel(r) {
        return (r.institution || ('Document Request #' + r.id)) + ' — #' + r.id;
    }

    // 2026-09-06 security hardening: escapeHtml() alone does NOT neutralize a
    // dangerous URL scheme (javascript:/data:/vbscript:) in an href/src —
    // item.link can be a submitter's free-text attachmentLink. Only allow
    // absolute http(s) URLs or the app's own relative paths.
    function sanitizeUrl(url) {
        var s = String(url == null ? '' : url).trim();
        if (!s) return '';
        if (/^https?:\/\//i.test(s)) return s;
        if (s.charAt(0) === '/' && s.charAt(1) !== '/') return s;
        return '';
    }

    function statusBadgeClass(status) {
        if (status === 'Approved' || status === 'Fulfilled' || status === 'Completed') return 'bg-success-subtle text-success';
        if (status === 'Rejected') return 'bg-danger-subtle text-danger';
        if (status === 'Withdrawn') return 'bg-secondary-subtle text-secondary';
        if (status === 'Draft') return 'bg-light text-dark';
        if (status === 'Preparing') return 'bg-info-subtle text-info';
        if (status === 'Awaiting for Approval') return 'bg-primary-subtle text-primary';
        if (status === 'Release') return 'bg-dark-subtle text-dark';
        return 'bg-warning-subtle text-warning'; // Pending / Received and any other undecided state
    }

    // Document Request workflow (2026-09-04): a 6-stage pipeline
    // (Received/Preparing/Awaiting for Approval/Approved/Release/Completed)
    // plus a separate Rejected outcome. Keyed off each request's
    // `canonicalStatus` (added server-side by GET /api/document-requests* so
    // a pre-2026-09-04 record's legacy status name — Pending/Under
    // Review/Fulfilled — is already normalized before it ever reaches this
    // page).
    var DR_WORKFLOW_STATUSES = ['Received', 'Preparing', 'Awaiting for Approval', 'Approved', 'Release', 'Completed'];
    var DR_STAGE_LABEL = {
        'Received': 'Received — Awaiting Processing',
        'Preparing': 'Preparing Documents',
        'Awaiting for Approval': 'Awaiting for Approval',
        'Approved': 'Approved',
        'Release': 'Ready for Release',
        'Completed': 'Completed',
        'Rejected': 'Rejected'
    };
    // Requester-facing progress checklist (✓ done / ● current / ○ upcoming),
    // matching the "existing progress/timeline UI" convention this page
    // already uses for draft collaboration timelines — a compact read-only
    // view of the same 6-stage pipeline the reviewer's Update Status dropdown
    // drives, so the requester always sees exactly where their request is.
    function drProgressChecklistHtml(canonicalStatus) {
        if (canonicalStatus === 'Rejected') {
            return '<div class="text-danger fs-13"><i class="ri-close-circle-line me-1"></i>This request was rejected — it will not continue through the workflow.</div>';
        }
        var idx = DR_WORKFLOW_STATUSES.indexOf(canonicalStatus);
        // 'Completed' is the pipeline's final resting state — every stage
        // including it is fully done, so nothing should render as merely
        // "current" (in progress) the way an intermediate stage does.
        var isFinal = canonicalStatus === 'Completed';
        return DR_WORKFLOW_STATUSES.map(function (s, i) {
            var done = isFinal ? true : i < idx;
            var current = !isFinal && i === idx;
            var icon = done ? '<i class="ri-checkbox-circle-fill text-success me-1"></i>'
                : current ? '<i class="ri-record-circle-fill text-primary me-1"></i>'
                : '<i class="ri-checkbox-blank-circle-line text-muted me-1"></i>';
            var cls = current ? 'fw-semibold text-primary' : (done ? 'text-success' : 'text-muted');
            return '<div class="fs-13 ' + cls + '">' + icon + escapeHtml(s) + '</div>';
        }).join('');
    }

    function fmtWhen(iso, fallback) {
        if (!iso) return fallback || '—';
        var d = new Date(iso);
        return isNaN(d) ? (fallback || '—') : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    // Attached Documents = any supporting documents CIRL staff uploaded while
    // processing a Document Request (already-archived Document Library
    // entries). Used by the "View Details" modal's own docs list. Reuses the
    // "View Draft" collaboration timeline's item builder
    // (buildDRDraftTimelineItems, defined further down this file) so every
    // file gets the same real Preview (via the shared draft-preview-modal)
    // and Download (original filename preserved) actions, not just a single
    // bare icon-link. Items are cached under a key unique to this request
    // (not the shared 'dr' slot the draft modal uses) since the detail modals
    // for different rows can be opened one after another without colliding.
    function renderAttachedDocs(r) {
        var allItems = buildDRDraftTimelineItems(r);
        var items = allItems.filter(function (it) { return it.link; });
        if (!items.length) return '<span class="text-muted fs-12">—</span>';
        var key = 'attach-dr-' + r.id;
        DRAFT_TIMELINE_ITEMS[key] = items;
        return items.map(function (it, idx) {
            var kind = fileKind(it.filename, it.fileType);
            var previewBtn = (kind === 'pdf' || kind === 'image')
                ? '<button type="button" class="btn btn-sm btn-soft-primary" title="Preview: ' + escapeHtml(it.filename) + '" onclick="openDraftPreviewModal(\'' + key + '\', ' + idx + ')"><i class="ri-eye-line"></i></button>'
                : '';
            return '<div class="d-flex align-items-center gap-1 mb-1">' +
                '<span class="text-truncate fs-12" style="max-width:100px;" title="' + escapeHtml(it.filename) + '">' + escapeHtml(it.filename) + '</span>' +
                previewBtn +
                '<a href="' + escapeHtml(it.link) + '" download="' + escapeHtml(it.filename) + '" class="btn btn-sm btn-soft-success" title="Download: ' + escapeHtml(it.filename) + '"><i class="ri-download-2-line"></i></a>' +
                '</div>';
        }).join('');
    }

    function setCount(id, n) {
        var el = document.getElementById(id);
        if (el) el.textContent = n;
    }

    /* ─── DOCUMENT COLLABORATION (own requests only — the request's own
       submittedByEmail is the ownership boundary, enforced server-side on
       POST /api/document-requests/:id/documents; myDocRequests itself is
       already scoped to "mine" by GET /api/document-requests/mine, so there
       is no way to reach another user's request id from this page). ─── */
    var ROLE_LABEL = {
        'Administrator': 'Administrator', 'Staff': 'CIRL Staff',
        'Auth. Personnel': 'College Dean', 'potential_partner': 'Partner',
        'Requester': 'You'
    };

    function fileKind(filename, mime) {
        var ext = String(filename || '').split('.').pop().toLowerCase();
        if ((mime && mime.indexOf('pdf') !== -1) || ext === 'pdf') return 'pdf';
        if ((mime && mime.indexOf('image/') === 0) || ['jpg', 'jpeg', 'png'].indexOf(ext) !== -1) return 'image';
        return 'other';
    }

    function fmtFileSize(bytes) {
        if (!bytes) return '';
        return bytes > 1e6 ? (bytes / 1e6).toFixed(1) + ' MB' : Math.round(bytes / 1024) + ' KB';
    }

    // Every draft/version gets its own dedicated "Draft Preview" modal
    // (opened on top of the dr-draft-modal that's already
    // showing) rather than an inline expand — same-screen, never navigates
    // away, and carries uploader/date/note context alongside the file.
    var DRAFT_TIMELINE_ITEMS = {};

    // Bootstrap 5 doesn't reliably support two modals open at once (the
    // second one's backdrop can render behind the first, eating clicks), so
    // instead of stacking, this SWAPS: hide whichever draft-collaboration
    // modal triggered it, show the preview modal, then restore the
    // original one when the preview is closed.
    var draftPreviewReturnTo = null;
    document.getElementById('draft-preview-modal').addEventListener('hidden.bs.modal', function () {
        if (draftPreviewReturnTo) {
            var returnEl = document.getElementById(draftPreviewReturnTo);
            draftPreviewReturnTo = null;
            if (returnEl) bootstrap.Modal.getOrCreateInstance(returnEl).show();
        }
    });

    // Same stacking problem, one level up: "View Draft" in the Partnership/
    // Document Request Details modal opens the draft-collaboration modal on
    // top of it. Swap instead — hide the details modal, restore it once the
    // draft modal closes for real (not the temporary hide-for-preview above,
    // which is why this checks draftPreviewReturnTo first).
    var draftDetailReturnTo = null;
    function wireDraftModalReturn(draftModalId, detailModalId, onReturn) {
        document.getElementById(draftModalId).addEventListener('hidden.bs.modal', function () {
            if (draftPreviewReturnTo === draftModalId) return;
            if (draftDetailReturnTo === detailModalId) {
                draftDetailReturnTo = null;
                new bootstrap.Modal(document.getElementById(detailModalId)).show();
                if (onReturn) onReturn();
            } else {
                resetBreadcrumb();   // opened without a detail modal to return to — nothing left on top of Monitoring
            }
        });
    }
    // Restore the Document Request-level breadcrumb (drops "Draft Collaboration") when swapping back to Details.
    wireDraftModalReturn('dr-draft-modal', 'dr-detail-modal', function () {
        var r = myDocRequests.find(function (x) { return x.id === currentDraftDRId; });
        if (r) setBreadcrumb(['Monitoring', 'Document Request', drRequestLabel(r)]);
    });

    function openDraftPreviewModal(prefix, idx) {
        var item = (DRAFT_TIMELINE_ITEMS[prefix] || [])[idx];
        if (!item || !item.link) return;
        var kind = fileKind(item.filename, item.fileType);
        var body = document.getElementById('draft-preview-body');
        var safeLink = sanitizeUrl(item.link);
        if (!safeLink) {
            body.innerHTML = '<div class="text-center text-muted py-5"><i class="ri-error-warning-line fs-1 d-block mb-2"></i>This link cannot be previewed (unrecognized or unsafe URL).</div>';
        } else if (kind === 'pdf') {
            body.innerHTML = '<iframe src="' + safeLink + '" style="width:100%;height:60vh;border:1px solid #e9ebec;border-radius:.25rem;"></iframe>';
        } else if (kind === 'image') {
            body.innerHTML = '<div class="text-center"><img src="' + safeLink + '" style="max-width:100%;max-height:60vh;border:1px solid #e9ebec;border-radius:.25rem;"></div>';
        } else {
            body.innerHTML = '<div class="text-center text-muted py-5"><i class="ri-file-3-line fs-1 d-block mb-2"></i>Preview not available for this file type.</div>';
        }
        document.getElementById('draft-preview-filename').textContent = item.filename;
        document.getElementById('draft-preview-uploader').textContent = item.uploadedBy + ' (' + (ROLE_LABEL[item.role] || item.role) + ')';
        document.getElementById('draft-preview-when').textContent = item.when;
        document.getElementById('draft-preview-note').textContent = item.note || '—';
        var downloadBtn = document.getElementById('draft-preview-download-btn');
        downloadBtn.href = safeLink || '#';
        downloadBtn.setAttribute('download', item.filename);

        var sourceEl = document.getElementById((prefix || 'dr') + '-draft-modal');
        var sourceInstance = sourceEl && bootstrap.Modal.getInstance(sourceEl);
        draftPreviewReturnTo = sourceInstance ? sourceEl.id : null;
        if (sourceInstance) sourceInstance.hide();

        bootstrap.Modal.getOrCreateInstance(document.getElementById('draft-preview-modal')).show();
    }

    function draftItemHtml(item, idx, prefix) {
        var roleLabel = ROLE_LABEL[item.role] || item.role || 'Reviewer';
        var isReviewerRole = item.role === 'Administrator' || item.role === 'Staff';
        var avatar = '<div class="flex-shrink-0"><span class="avatar-title ' + (isReviewerRole ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success') + ' rounded-circle" style="width:36px;height:36px;"><i class="ri-' + (isReviewerRole ? 'shield-star-line' : 'user-line') + '"></i></span></div>';
        var header = '<div class="d-flex justify-content-between flex-wrap gap-1">' +
            '<div><span class="fw-semibold fs-13">' + escapeHtml(item.uploadedBy) + '</span> <span class="badge ' + (isReviewerRole ? 'bg-primary-subtle text-primary' : 'bg-success-subtle text-success') + ' fs-10 ms-1">' + escapeHtml(roleLabel) + '</span></div>' +
            '<span class="text-muted fs-12">' + escapeHtml(item.when) + '</span>' +
            '</div>';
        // A link-less item is a system/status entry (e.g. "Request submitted")
        // rather than an uploaded file — no filename, preview, or download row.
        if (!item.link) {
            return '<div class="d-flex gap-3 mb-3">' + avatar +
                '<div class="flex-grow-1 border rounded p-3">' + header +
                (item.note ? '<div class="fs-13 text-muted mt-1">' + escapeHtml(item.note) + '</div>' : '') +
                '</div></div>';
        }
        var kind = fileKind(item.filename, item.fileType);
        var sizeStr = fmtFileSize(item.fileSize);
        var previewBtn = (kind === 'pdf' || kind === 'image')
            ? '<button type="button" class="btn btn-sm btn-soft-primary" onclick="openDraftPreviewModal(\'' + (prefix || 'dr') + '\', ' + idx + ')"><i class="ri-eye-line me-1"></i>Preview</button>'
            : '<span class="text-muted fs-12 align-self-center">Preview not available for this file type</span>';
        var safeItemLink = sanitizeUrl(item.link);
        var downloadBtnHtml = safeItemLink
            ? ('<a href="' + safeItemLink + '" download="' + escapeHtml(item.filename) + '" class="btn btn-sm btn-soft-success"><i class="ri-download-2-line me-1"></i>Download</a>')
            : '<span class="text-muted fs-12 align-self-center">Link unavailable</span>';
        return '<div class="d-flex gap-3 mb-3">' + avatar +
            '<div class="flex-grow-1 border rounded p-3">' + header +
            '<div class="fs-13 fw-medium mt-1">' + escapeHtml(item.filename) + (sizeStr ? ' <span class="text-muted fs-12">(' + sizeStr + ')</span>' : '') + '</div>' +
            (item.note ? '<div class="fs-13 text-muted mt-1 fst-italic">"' + escapeHtml(item.note) + '"</div>' : '') +
            '<div class="d-flex align-items-center gap-2 mt-2">' + previewBtn + ' ' + downloadBtnHtml + '</div>' +
            '</div></div>';
    }

    /* ─── DOCUMENT REQUEST DRAFT / DOCUMENT COLLABORATION ───
       The item builder feeds the shared helpers (fileKind, fmtFileSize,
       draftItemHtml, ROLE_LABEL). The first entry is synthetic ("Request
       submitted") since Document Requests have no attachmentLink-style
       original file. */
    function buildDRDraftTimelineItems(r) {
        var items = [{
            uploadedBy: r.requestedBy || 'You', role: 'Requester',
            when: r.submittedAt
                ? new Date(r.submittedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' })
                : (r.date || '—'),
            note: 'Request submitted'
        }];
        (r.supportingDocuments || []).forEach(function (d) {
            items.push({
                uploadedBy: d.uploadedBy || 'Unknown', role: d.uploaderRole || 'Reviewer',
                when: d.uploadedAt ? new Date(d.uploadedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) : '—',
                filename: d.originalFilename || 'Document', link: d.fileLink,
                note: d.note || '', fileType: d.fileType, fileSize: d.fileSize
            });
        });
        return items;
    }

    function renderDRDraftTimeline(r) {
        var items = buildDRDraftTimelineItems(r);
        DRAFT_TIMELINE_ITEMS.dr = items;
        var wrap = document.getElementById('dr-draft-timeline');
        wrap.innerHTML = items.map(function (it, idx) { return draftItemHtml(it, idx, 'dr'); }).join('');
    }

    var currentDraftDRId = null;
    function openDRDraftModal(id) {
        var r = myDocRequests.find(function (x) { return x.id === id; });
        if (!r) return;
        currentDraftDRId = id;
        document.getElementById('dr-draft-modal-title').innerHTML = '<i class="ri-file-list-3-line me-2 text-primary"></i>Draft Collaboration — #' + r.id;
        renderDRDraftTimeline(r);
        setBreadcrumb(['Monitoring', 'Document Request', drRequestLabel(r), 'Draft Collaboration']);
        var drDetailInstance = bootstrap.Modal.getInstance(document.getElementById('dr-detail-modal'));
        if (drDetailInstance) { draftDetailReturnTo = 'dr-detail-modal'; drDetailInstance.hide(); }
        bootstrap.Modal.getOrCreateInstance(document.getElementById('dr-draft-modal')).show();
    }

    var myDocRequests = [];
    var flashDRIds = new Set();   // rows a live update just changed
    var currentDRDetailId = null;

    function renderDRTable() {
        var body = document.getElementById('dr-monitor-body');
        if (!myDocRequests.length) {
            body.innerHTML = '<tr><td colspan="10" class="text-center text-muted py-4">No document requests yet.</td></tr>';
            return;
        }
        body.innerHTML = myDocRequests.map(function (r) {
            var cs = r.canonicalStatus || r.status;
            // Requester-facing Actions: View Details only. Draft history,
            // PDF download and Cancel remain reachable from the details modal.
            var actions = '<button class="btn btn-sm btn-soft-secondary" onclick="openDRDetail(' + r.id + ')" title="View Details"><i class="ri-eye-line me-1"></i>View Details</button>';
            return '<tr data-dr-id="' + r.id + '"' + (flashDRIds.has(r.id) ? ' class="rt-flash"' : '') + '>' +
                '<td class="text-muted">#' + r.id + '</td>' +
                '<td>' + escapeHtml(r.institution) + '</td>' +
                '<td style="max-width:200px;">' + renderExpandable(r.documentType, 60) + '</td>' +
                '<td><span class="badge ' + statusBadgeClass(cs) + '">' + cs + '</span></td>' +
                '<td>' + (r.date || '—') + '</td>' +
                '<td>' + fmtWhen(r.updatedAt, r.date) + '</td>' +
                '<td>' + (DR_STAGE_LABEL[cs] || cs) + '</td>' +
                '<td>' + (r.decidedBy || '—') + '</td>' +
                '<td class="fs-12" style="max-width:220px;">' + renderExpandable(r.remark, 60) + '</td>' +
                '<td class="text-end text-nowrap">' + actions + '</td></tr>';
        }).join('');
    }

    function openDRDetail(id) {
        var r = myDocRequests.find(function (x) { return x.id === id; });
        if (!r) return;
        currentDRDetailId = id;
        var cs = r.canonicalStatus || r.status;
        document.getElementById('drd-id').textContent = '#' + r.id;
        document.getElementById('drd-type').textContent = r.documentType || '—';
        document.getElementById('drd-inst').textContent = r.institution || '—';
        document.getElementById('drd-status').innerHTML = '<span class="badge ' + statusBadgeClass(cs) + '">' + cs + '</span>';
        document.getElementById('drd-date').textContent = r.date || '—';
        document.getElementById('drd-updated').textContent = fmtWhen(r.updatedAt, r.date);
        document.getElementById('drd-stage').textContent = DR_STAGE_LABEL[cs] || cs;
        document.getElementById('drd-admin').textContent = r.decidedBy || '—';
        document.getElementById('drd-progress').innerHTML = drProgressChecklistHtml(cs);
        document.getElementById('drd-purpose').textContent = r.notes || '—';
        document.getElementById('drd-remark').textContent = r.remark || '—';
        document.getElementById('drd-docs').innerHTML = renderAttachedDocs(r);
        setBreadcrumb(['Monitoring', 'Document Request', drRequestLabel(r)]);

        var footer = '<button class="btn btn-soft-info" onclick="openDRDraftModal(' + id + ')"><i class="ri-file-list-3-line me-1"></i>View Draft</button>' +
            '<a href="/api/document-requests/' + id + '/pdf" class="btn btn-soft-info"><i class="ri-file-download-line me-1"></i>Download PDF</a>';
        if (cs === 'Received') {
            footer += '<button class="btn btn-danger" onclick="cancelDocRequest(' + r.id + ', this)"><i class="ri-close-circle-line me-1"></i>Cancel</button>';
        }
        footer += '<button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>';
        document.getElementById('drd-footer').innerHTML = footer;

        bootstrap.Modal.getOrCreateInstance(document.getElementById('dr-detail-modal')).show();
    }

    // A real close (Close button, Esc, backdrop click, or after Cancel) drops the breadcrumb back to Monitoring.
    // "View Draft" also hides this modal, but sets draftDetailReturnTo first (checked here) so that swap doesn't count.
    document.getElementById('dr-detail-modal').addEventListener('hidden.bs.modal', function () {
        if (!draftDetailReturnTo) resetBreadcrumb();
    });

    function cancelDocRequest(id, btn) {
        if (!confirm('Cancel this document request?')) return;
        return CIPRMS.busy(btn, function () {
            return CIPRMS.api('/api/document-requests/' + id, { method: 'DELETE', quiet: true }).then(function (res) {
                if (res.ok) {
                    showToast('Request cancelled.', '#15803d');
                    var m = bootstrap.Modal.getInstance(document.getElementById('dr-detail-modal')); if (m) m.hide();
                } else {
                    showToast(res.error || 'Failed to cancel request.', '#f06548');
                }
                return loadDRRequests({ live: !res.ok });   // re-read either way: after a refusal the row on screen may be stale
            });
        }, 'Cancelling…');
    }

    // Stat cards + Approval Progress track the requester's own Document
    // Requests. (The Partnership Requests section is not shown on this page,
    // so no partnership-request counts are mixed in.) Document requests use
    // the 6-stage workflow (see DR_WORKFLOW_STATUSES above) — "Approved" and
    // everything after it (Release, Completed) counts toward Approved, since
    // the request was approved and just continues through fulfillment.
    var DR_APPROVED_IDX = DR_WORKFLOW_STATUSES.indexOf('Approved');
    function drWorkflowIdx(r) { return DR_WORKFLOW_STATUSES.indexOf(r.canonicalStatus || r.status); }
    function drIsInProgress(r) { var idx = drWorkflowIdx(r); return idx > -1 && idx < DR_APPROVED_IDX; }
    function drIsApproved(r) { return drWorkflowIdx(r) >= DR_APPROVED_IDX; }

    function renderRequestStats() {
        var total = myDocRequests.length;
        var inProgress = myDocRequests.filter(drIsInProgress).length;
        var approved = myDocRequests.filter(drIsApproved).length;

        setCount('cnt-total', total);
        setCount('cnt-progress', inProgress);
        setCount('cnt-approved', approved);

        var progBox = document.getElementById('approval-progress-body');
        var pct = total ? Math.round((approved / total) * 100) : 0;
        progBox.innerHTML =
            '<div class="d-flex justify-content-between mb-1"><span>Approved</span><span>' + approved + ' / ' + total + '</span></div>' +
            '<div class="progress mb-3" style="height:10px"><div class="progress-bar bg-success" style="width:' + pct + '%"></div></div>' +
            '<div class="row g-2 text-center">' +
                '<div class="col-6"><div class="border rounded p-2"><h5 class="mb-0">' + inProgress + '</h5><small class="text-muted">In Progress</small></div></div>' +
                '<div class="col-6"><div class="border rounded p-2"><h5 class="mb-0 text-success">' + approved + '</h5><small class="text-muted">Approved</small></div></div>' +
            '</div>';
    }

    // Stat cards are clickable: each one jumps to and highlights the
    // matching Document Request rows (Total/In Progress/Approved use the same
    // status definitions as renderRequestStats above), or the Document
    // Verification table for Documents on File.
    function highlightRows(rows) {
        if (!rows.length) return false;
        rows[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
        rows.forEach(function (el) { el.classList.add('table-warning'); });
        setTimeout(function () { rows.forEach(function (el) { el.classList.remove('table-warning'); }); }, 3000);
        return true;
    }

    function highlightRequestRows(drIds) {
        var rows = [];
        drIds.forEach(function (id) {
            var el = document.querySelector('#dr-monitor-body tr[data-dr-id="' + id + '"]');
            if (el) rows.push(el);
        });
        return highlightRows(rows);
    }

    function goToTotal() {
        if (!highlightRequestRows(myDocRequests.map(function (r) { return r.id; }))) showToast('No document requests yet.', '#405189');
    }

    function goToInProgress() {
        if (!highlightRequestRows(myDocRequests.filter(drIsInProgress).map(function (r) { return r.id; }))) showToast('No in-progress document requests right now.', '#405189');
    }

    function goToApproved() {
        if (!highlightRequestRows(myDocRequests.filter(drIsApproved).map(function (r) { return r.id; }))) showToast('No approved document requests yet.', '#405189');
    }

    function goToDocuments() {
        var rows = Array.prototype.slice.call(document.querySelectorAll('#doc-verification-body tr.doc-file-row'));
        if (!highlightRows(rows)) showToast('No documents on file yet.', '#405189');
    }

    // opts.live: a background refresh after a live update — rows that changed flash, and a failed read leaves the screen alone.
    function loadDRRequests(opts) {
        var live = !!(opts && opts.live);
        return CIPRMS.api('/api/document-requests/mine', { quiet: true }).then(function (res) {
            if (!res.ok || !Array.isArray(res.data)) {
                if (live) return false;   // (false = try again later)
                document.getElementById('dr-monitor-body').innerHTML = '<tr><td colspan="10" class="text-center text-danger py-4">Failed to load requests.</td></tr>';
                document.getElementById('approval-progress-body').innerHTML = '';
                return;
            }
            var previous = {};
            myDocRequests.forEach(function (r) { previous[r.id] = JSON.stringify(r); });
            flashDRIds = new Set(live ? res.data.filter(function (r) { return previous[r.id] !== JSON.stringify(r); }).map(function (r) { return r.id; }) : []);
            myDocRequests = res.data;
            renderDRTable();
            flashDRIds = new Set();
            renderRequestStats();
            refreshOpenDRModals();
            return live ? undefined : openFromQuery();
        });
    }

    // a modal that is open on a request whose data just changed shows the new state (status, progress, timeline)
    function refreshOpenDRModals() {
        var shown = function (id) { var el = document.getElementById(id); return el && el.classList.contains('show'); };
        if (shown('dr-detail-modal') && currentDRDetailId && myDocRequests.some(function (x) { return x.id === currentDRDetailId; })) openDRDetail(currentDRDetailId);
        if (shown('dr-draft-modal') && currentDraftDRId) {
            var r = myDocRequests.find(function (x) { return x.id === currentDraftDRId; });
            if (r) renderDRDraftTimeline(r);
        }
    }

    // Deep-link support so a notification ("Document Request Fulfilled", etc.)
    // can jump straight to and highlight the matching row. Notification links
    // for Partnership Requests (type=pr) have no table here anymore and are
    // simply ignored.
    function openFromQuery() {
        var params = new URLSearchParams(window.location.search);
        var id = params.get('id');
        if (!id || params.get('type') !== 'dr') return;
        var row = document.querySelector('#dr-monitor-body tr[data-dr-id="' + id + '"]');
        if (!row) return;
        row.scrollIntoView({ behavior: 'smooth', block: 'center' });
        row.classList.add('table-warning');
        setTimeout(function () { row.classList.remove('table-warning'); }, 3000);
    }

    function refreshDocs() {
        return CIPRMS.api('/api/documents/mine', { quiet: true }).then(function (res) {
            var body = document.getElementById('doc-verification-body');
            if (!res.ok || !Array.isArray(res.data)) {
                if (!body.querySelector('tr.doc-file-row')) body.innerHTML = '<tr><td colspan="2" class="text-center text-danger py-4">Failed to load documents.</td></tr>';
                return false;
            }
            var docs = res.data;
            setCount('cnt-docs', docs.length);
            if (docs.length === 0) {
                body.innerHTML = '<tr><td colspan="2" class="text-center text-muted py-4">No documents uploaded yet.</td></tr>';
                return;
            }
            body.innerHTML = docs.map(function (d) {
                var badge = d.status === 'Needs Review' ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success';
                var label = d.status === 'Needs Review' ? 'Pending Verification' : 'Verified';
                return '<tr class="doc-file-row"><td>' + escapeHtml(d.title) + '</td><td><span class="badge ' + badge + '">' + label + '</span></td></tr>';
            }).join('');
        });
    }
    refreshDocs();

    loadDRRequests();
    // Live updates: a reviewer moved one of my Document Requests to the next stage. The server is asked again for the
    // real data — counters, Approval Progress and the table are all recomputed from it, never from the event itself.
    if (window.CIPRMS && CIPRMS.live) {
        CIPRMS.live(['documentRequest.updated', 'documentRequest.statusChanged', 'request.updated', 'request.statusChanged', 'partnership.updated', 'partnership.statusChanged'], function () {
            return Promise.all([loadDRRequests({ live: true }), refreshDocs()]).then(function (r) { return r.indexOf(false) === -1; });
        }, { debounce: 250 });
    }
</script>
</body>
</html>
