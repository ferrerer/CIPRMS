<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up — CSPC-CIRL</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .signup-page .right-side { position: relative; }
        .success-overlay {
            position: absolute; inset: 0;
            background: rgba(8,35,80,0.75); backdrop-filter: blur(8px);
            display: flex; align-items: center; justify-content: center;
            z-index: 9999; opacity: 0; pointer-events: none;
            transition: opacity 0.35s ease; border-radius: inherit;
        }
        .success-overlay.show { opacity: 1; pointer-events: all; }
        .success-box { border-radius: 20px; padding: 40px 48px; text-align: center; box-shadow: 0 20px 60px rgba(0,0,0,.5); transform: scale(.85); transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1); }
        .success-overlay.show .success-box { transform: scale(1); }
        .success-icon { width:72px; height:72px; background:#16a34a; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 20px; animation: pop 0.4s ease 0.2s both; }
        @keyframes pop { 0%{transform:scale(0)} 70%{transform:scale(1.15)} 100%{transform:scale(1)} }
        .success-icon svg { width:38px; height:38px; stroke:#fff; stroke-width:3; fill:none; stroke-linecap:round; stroke-linejoin:round; }
        .success-title { font-size:20px; font-weight:700; color:#fff; margin-bottom:8px; }
        .success-sub { font-size:14px; color:#93c5fd; }
        .success-bar { height:4px; background:rgba(255,255,255,.15); border-radius:99px; margin-top:24px; overflow:hidden; }
        .success-bar-fill { height:100%; width:0%; background:#FDF5E6; border-radius:99px; transition: width 2s linear; }
    </style>
</head>
<body class="signup-page">
    <div class="container">
        <div class="left-side"></div>
        <div class="right-side">
            <div class="success-overlay" id="success-overlay">
                <div class="success-box">
                    <p class="success-title">Account Successfully Created!</p>
                    <p class="success-sub">Redirecting you to the login page...</p>
                    <div class="success-bar"><div class="success-bar-fill" id="success-bar-fill"></div></div>
                </div>
            </div>
            <div class="login-container">
                <div class="logo">
                    <img src="/images/cirl-logo.jpg" alt="CSPC Logo">
                </div>
                <h1 class="title">Center for International<br>Relations and Linkages</h1>

                <form onsubmit="handleSignup(event)">
                    <div class="input-group">
                        <svg class="icon-left" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </svg>
                        <input type="text" placeholder="Enter Username/Email">
                    </div>
                    <div class="input-group">
                        <svg class="icon-left" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/>
                        </svg>
                        <input type="password" placeholder="Enter Password">
                    </div>
                    <div class="input-group">
                        <svg class="icon-left" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM9 6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9V6zm9 14H6V10h12v10zm-6-3c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"/>
                        </svg>
                        <input type="password" placeholder="Confirm Password">
                    </div>
                    <button type="submit" class="login-btn">Signup</button>
                    <p class="signup-text">Already have an account? <a href="/login">Click here</a></p>
                </form>

                <div class="divider"><span class="divider-text">or link account with</span></div>
                <button type="button" class="google-btn">
                    <svg viewBox="0 0 24 24">
                        <path fill="#ffffff" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#ffffff" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#ffffff" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#ffffff" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    Google
                </button>
            </div>
        </div>
    </div>
    <script>
        function handleSignup(e) {
            e.preventDefault();
            const overlay = document.getElementById('success-overlay');
            const barFill = document.getElementById('success-bar-fill');
            overlay.classList.add('show');
            requestAnimationFrame(() => requestAnimationFrame(() => { barFill.style.width = '100%'; }));
            setTimeout(() => { window.location.href = '/login'; }, 2200);
        }
    </script>
</body>
</html>
