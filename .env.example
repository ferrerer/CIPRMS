# Copy this file to .env and fill in real values. Never commit .env (it is gitignored) or paste real
# secrets into this example file.

# --- Required for the app to start -----------------------------------------------------------------
MONGO_URI=
SESSION_SECRET=

# --- Google OAuth / Calendar / Docs integration (optional — features degrade gracefully if unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
CALLBACK_URL=

# --- E-mail notifications (optional — see services/emailService.js) --------------------------------
# Without MAIL_USER/MAIL_APP_PASSWORD, CIPRMS runs normally but skips e-mail delivery; the System
# Status banner will report "Email Notifications" as not configured. Current implementation targets
# Gmail / Google Workspace via an App Password (Google Account -> Security -> 2-Step Verification ->
# App passwords) — not your normal account password.
MAIL_USER=
MAIL_APP_PASSWORD=
# Optional display name for the "From" header (default: "CIPRMS — CSPC CIRL")
MAIL_FROM_NAME=
# Public base URL used to build links inside notification e-mails (default: http://localhost:<PORT>).
# Must be set to the real deployed URL in production, or e-mail links will point at localhost.
APP_BASE_URL=
# Only needed for a non-Gmail SMTP provider; Gmail defaults (smtp.gmail.com:465, secure) are used otherwise.
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
