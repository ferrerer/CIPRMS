# Copy this file to .env and fill in real values. Never commit .env (it is gitignored) or paste real
# secrets into this example file.

# --- Required for the app to start -----------------------------------------------------------------
MONGO_URI=
SESSION_SECRET=

# --- Google OAuth / Calendar / Docs integration (optional — features degrade gracefully if unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=
CALLBACK_URL=

# --- E-mail notifications (optional — see services/emailService.js) --------------------------------
# Without RESEND_API_KEY/MAIL_USER, CIPRMS runs normally but skips e-mail delivery; the System Status
# banner will report "Email Notifications" as not configured. Sent via Resend's HTTPS API (resend.com)
# rather than raw SMTP — Render's free web-service plan blocks all outbound SMTP ports (25/465/587),
# so a Gmail-SMTP setup never completes from there. Get an API key from the Resend dashboard
# (Settings -> API Keys); MAIL_USER must be an address on a domain verified in Resend (Dashboard ->
# Domains) or Resend will reject the send.
RESEND_API_KEY=
MAIL_USER=
# Optional display name for the "From" header (default: "CIPRMS — CSPC CIRL")
MAIL_FROM_NAME=
# Public base URL used to build links inside notification e-mails (default: http://localhost:<PORT>).
# Must be set to the real deployed URL in production, or e-mail links will point at localhost.
APP_BASE_URL=
