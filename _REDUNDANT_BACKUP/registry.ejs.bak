<!DOCTYPE html>
<html lang="en" data-layout="vertical" data-topbar="light" data-sidebar="dark" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-theme-colors="default">
<head>
    <meta charset="utf-8" />
    <title>Registry | CIPRMS-CSPC-CIRL</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/cirl-logo.jpg">
    <!-- Layout config Js -->
    <script src="/velzon/assets/js/layout.js"></script>
    <!-- Bootstrap Css -->
    <link href="/velzon/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="/velzon/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css -->
    <link href="/velzon/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <!-- Custom Css -->
    <link href="/velzon/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <!-- Our Css -->
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/velzon/assets/css/ciprms-bridge.css">
    <!-- Font Awesome (for legacy icons in content) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

</head>

<body>

<!-- Begin page -->
<div id="layout-wrapper">

    <%- include('partials/header') %>

    <%- include('partials/sidebar') %>

    <!-- ============================================================== -->
    <!-- Start right Content here -->
    <!-- ============================================================== -->
    <div class="main-content">

        <div class="page-content">
            <div class="container-fluid">

<!-- page title -->
<div class="row">
  <div class="col-12">
    <div class="page-title-box d-sm-flex align-items-center justify-content-between bg-galaxy-transparent">
      <h4 class="mb-sm-0">Partnership Registry</h4>
      <div class="page-title-right">
        <ol class="breadcrumb m-0">
          <li class="breadcrumb-item"><a href="/dashboard">CIPRMS</a></li>
          <li class="breadcrumb-item active">Registry</li>
        </ol>
      </div>
    </div>
  </div>
</div>
<!-- stat cards -->
<div class="row">
  <div class="col-xl-3 col-md-6">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <p class="fw-medium text-muted mb-0">Total Partnerships</p>
            <h2 class="mt-4 ff-secondary fw-semibold" id="cnt-total">0</h2>
            <p class="mb-0 text-muted"><span class="badge bg-light text-dark mb-0">MOA &amp; MOU</span></p>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-primary-subtle rounded-circle fs-2"><i data-feather="file-text" class="text-primary"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <p class="fw-medium text-muted mb-0">Active</p>
            <h2 class="mt-4 ff-secondary fw-semibold" id="cnt-active">0</h2>
            <p class="mb-0 text-muted"><span class="badge bg-success-subtle text-success mb-0">In effect</span></p>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-success-subtle rounded-circle fs-2"><i data-feather="check-circle" class="text-success"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <p class="fw-medium text-muted mb-0">Expiring Soon</p>
            <h2 class="mt-4 ff-secondary fw-semibold" id="cnt-expiring">0</h2>
            <p class="mb-0 text-muted"><span class="badge bg-warning-subtle text-warning mb-0">Within 90 days</span></p>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-warning-subtle rounded-circle fs-2"><i data-feather="alert-triangle" class="text-warning"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-xl-3 col-md-6">
    <div class="card card-animate">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
            <p class="fw-medium text-muted mb-0">Expired</p>
            <h2 class="mt-4 ff-secondary fw-semibold" id="cnt-expired">0</h2>
            <p class="mb-0 text-muted"><span class="badge bg-danger-subtle text-danger mb-0">Needs renewal</span></p>
          </div>
          <div class="avatar-sm flex-shrink-0">
            <span class="avatar-title bg-danger-subtle rounded-circle fs-2"><i data-feather="x-circle" class="text-danger"></i></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- filter card -->
<div class="card">
  <div class="card-header align-items-center d-flex">
    <h4 class="card-title mb-0 flex-grow-1"><i class="ri-filter-3-line me-1"></i> Filter Partnerships</h4>
    <button class="btn btn-soft-danger btn-sm" onclick="clearFilters()"><i class="ri-refresh-line me-1"></i>Clear</button>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-md-4 col-lg-3">
        <label class="form-label">Search Institution</label>
        <div class="input-group"><span class="input-group-text"><i class="ri-search-line"></i></span>
          <input class="form-control" id="reg-search" placeholder="Institution or country…" oninput="applyFilter()">
        </div>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label">Type</label>
        <select class="form-select" id="reg-type" onchange="applyFilter()">
          <option value="">All</option><option>MOA</option><option>MOU</option><option>Other</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label">Category</label>
        <select class="form-select" id="reg-cat" onchange="applyFilter()">
          <option value="">All</option><option>International</option><option>Local</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label">Status</label>
        <select class="form-select" id="reg-status" onchange="applyFilter()">
          <option value="">All</option><option>Active</option><option>Expiring Soon</option><option>Expired</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label">Region</label>
        <select class="form-select" id="reg-region" onchange="applyFilter()">
          <option value="">All</option><option>Asia</option><option>Europe</option><option>Americas</option><option>Oceania</option><option>Africa</option><option>Local</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label">College / Unit</label>
        <select class="form-select" id="reg-unit" onchange="applyFilter()">
          <option value="">All</option><option>CCS</option><option>CILS</option><option>CETE</option><option>CNAS</option><option>CAMS</option><option>CIRL</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label">Year Signed</label>
        <select class="form-select" id="reg-yr-signed" onchange="applyFilter()">
          <option value="">All</option><option>2019</option><option>2020</option><option>2021</option><option>2022</option><option>2023</option><option>2024</option><option>2025</option><option>2026</option>
        </select>
      </div>
      <div class="col-6 col-md-2">
        <label class="form-label">Year Expiry</label>
        <select class="form-select" id="reg-yr-exp" onchange="applyFilter()">
          <option value="">All</option><option>2024</option><option>2025</option><option>2026</option><option>2027</option><option>2028</option><option>2029</option><option>2030</option>
        </select>
      </div>
    </div>
  </div>
</div>
<!-- registry table card - exact tables-listjs.html pattern -->
<div class="row">
  <div class="col-lg-12">
    <div class="card">
      <div class="card-header">
        <h4 class="card-title mb-0">All Partnerships</h4>
      </div><!-- end card header -->

      <div class="card-body">
        <div class="listjs-table" id="partnership-list">
          <div class="row g-4 mb-3">
            <div class="col-sm-auto">
              <div>
                <button type="button" class="btn btn-success add-btn" data-bs-toggle="modal" id="create-btn" data-bs-target="#addPartnershipModal">
                  <i class="ri-add-line align-bottom me-1"></i> Add Partnership
                </button>
              </div>
            </div>
            <div class="col-sm">
              <div class="d-flex justify-content-sm-end">
                <div class="search-box ms-2">
                  <input type="text" class="form-control search" id="reg-search" placeholder="Search..." oninput="applyFilter()">
                  <i class="ri-search-line search-icon"></i>
                </div>
              </div>
            </div>
          </div>

          <div class="table-responsive table-card mt-3 mb-1">
            <table class="table align-middle table-nowrap" id="partnershipTable">
              <thead class="table-light">
                <tr>
                  <th class="sort" data-sort="inst">Institution</th>
                  <th>Country / Region</th>
                  <th class="sort" data-sort="ptype">Type</th>
                  <th class="sort" data-sort="pnature">Nature</th>
                  <th class="sort" data-sort="punit">Unit</th>
                  <th class="sort" data-sort="pstart">Start</th>
                  <th class="sort" data-sort="pend">End</th>
                  <th class="sort" data-sort="pstatus">Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="reg-tbody" class="list form-check-all"></tbody>
            </table>
            <div class="noresult" style="display: none">
              <div class="text-center">
                <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#121331,secondary:#08a88a" style="width:75px;height:75px"></lord-icon>
                <h5 class="mt-2">Sorry! No Result Found</h5>
                <p class="text-muted mb-0">No partnerships match your current search or filters.</p>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-end">
            <div class="pagination-wrap hstack gap-2">
              <a class="page-item pagination-prev disabled" href="javascript:void(0);">Previous</a>
              <ul class="pagination listjs-pagination mb-0" id="reg-pagination"></ul>
              <a class="page-item pagination-next" href="javascript:void(0);">Next</a>
            </div>
          </div>
        </div>
      </div><!-- end card body -->
    </div><!-- end card -->
  </div><!-- end col -->
</div><!-- end row -->

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- ADD PARTNERSHIP MODAL — forms-wizard.html Arrow Nav Steps        -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade zoomIn" id="addPartnershipModal" tabindex="-1" aria-labelledby="addPartnershipModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light p-3">
        <h5 class="modal-title" id="addPartnershipModalLabel">Add New Partnership</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
      </div>
      <div class="modal-body">
        <form class="form-steps" autocomplete="off" id="addPartnershipForm">

          <!-- STEP NAV — Arrow Nav Steps (forms-wizard.html) -->
          <div class="step-arrow-nav mb-4">
            <ul class="nav nav-pills custom-nav nav-justified" role="tablist">
              <li class="nav-item" role="presentation">
                <button class="nav-link active" id="add-step1-tab" data-bs-toggle="pill" data-bs-target="#add-step1" type="button" role="tab" aria-selected="true">
                  <i class="ri-user-line me-1"></i> Partner Info
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="add-step2-tab" data-bs-toggle="pill" data-bs-target="#add-step2" type="button" role="tab" aria-selected="false">
                  <i class="ri-file-list-3-line me-1"></i> Agreement Details
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link" id="add-step3-tab" data-bs-toggle="pill" data-bs-target="#add-step3" type="button" role="tab" aria-selected="false">
                  <i class="ri-building-line me-1"></i> CSPC-CIRL Details
                </button>
              </li>
            </ul>
          </div>

          <div class="tab-content">
            <!-- STEP 1: Partner Info -->
            <div class="tab-pane fade show active" id="add-step1" role="tabpanel">
              <div class="mb-4">
                <h5 class="mb-1">Partner Information</h5>
                <p class="text-muted">Fill in the partner institution details.</p>
              </div>
              <div class="row">
                <div class="col-lg-12 mb-3">
                  <label class="form-label" for="f-inst">Institution Name <span class="text-danger">*</span>
                    <span class="badge bg-info-subtle text-info ms-2"><i class="ri-global-line me-1"></i>Worldwide DB</span>
                  </label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="ri-building-line"></i></span>
                    <input type="text" class="form-control" id="f-inst" placeholder="Type to search worldwide universities…" autocomplete="off" oninput="instSearch(this.value)" onkeydown="instKeyNav(event)">
                    <i class="fa-solid fa-circle-notch ac-spinner" id="ac-spinner" style="display:none;position:absolute;right:10px;top:50%;transform:translateY(-50%)"></i>
                  </div>
                  <div id="ac-dropdown" class="list-group mt-1" style="position:absolute;z-index:9999;width:calc(100% - 2rem)"></div>
                  <div class="form-text"><i class="ri-information-line me-1"></i>Country &amp; region auto-fill on select.</div>
                </div>
                <div class="col-lg-6 mb-3">
                  <label class="form-label" for="f-country">Country <span class="text-danger">*</span></label>
                  <input type="text" class="form-control" id="f-country" placeholder="e.g. Japan">
                </div>
                <div class="col-lg-6 mb-3">
                  <label class="form-label" for="f-region">Region <span class="text-danger">*</span></label>
                  <select class="form-select" id="f-region">
                    <option value="">Select region…</option>
                    <option>Asia</option><option>Europe</option><option>Americas</option>
                    <option>Oceania</option><option>Africa</option><option>Local</option>
                  </select>
                </div>
                <div class="col-lg-6 mb-3">
                  <label class="form-label" for="f-partner-email">Partner Contact Email</label>
                  <input type="email" class="form-control" id="f-partner-email" placeholder="contact@institution.edu">
                </div>
              </div>
              <div class="d-flex align-items-start gap-3 mt-4">
                <button type="button" class="btn btn-success btn-label right ms-auto nexttab nexttab" data-nexttab="add-step2-tab">
                  <i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Next: Agreement Details
                </button>
              </div>
            </div><!-- end step 1 -->

            <!-- STEP 2: Agreement Details -->
            <div class="tab-pane fade" id="add-step2" role="tabpanel">
              <div class="mb-4">
                <h5 class="mb-1">Agreement Details</h5>
                <p class="text-muted">Fill in the MOA/MOU agreement terms.</p>
              </div>
              <div class="row">
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-type">Type (MOA/MOU) <span class="text-danger">*</span></label>
                  <select class="form-select" id="f-type">
                    <option value="">Select…</option><option>MOA</option><option>MOU</option>
                  </select>
                </div>
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-nature">Nature of Partnership <span class="text-danger">*</span></label>
                  <select class="form-select" id="f-nature">
                    <option value="">Select…</option>
                    <option>Research</option><option>Student Exchange</option><option>Training</option>
                    <option>Conference</option><option>Faculty Exchange</option><option>Joint Program</option>
                    <option>Internship</option><option>Other</option>
                  </select>
                </div>
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-cat">Category</label>
                  <select class="form-select" id="f-cat">
                    <option value="International">International</option>
                    <option value="Local">Local</option>
                  </select>
                </div>
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-start">Start Date <span class="text-danger">*</span></label>
                  <input type="date" class="form-control" id="f-start">
                </div>
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-end">End Date <span class="text-danger">*</span></label>
                  <input type="date" class="form-control" id="f-end" onchange="computeStatus()">
                </div>
                <div class="col-lg-4 mb-3">
                  <label class="form-label" for="f-status">Status <span class="text-muted">(Auto-computed)</span></label>
                  <input type="text" class="form-control bg-light" id="f-status" readonly placeholder="Set end date…">
                </div>
              </div>
              <div class="d-flex align-items-start gap-3 mt-4">
                <button type="button" class="btn btn-light btn-label previestab" data-previous="add-step1-tab">
                  <i class="ri-arrow-left-line label-icon align-middle fs-16 me-2"></i>Back
                </button>
                <button type="button" class="btn btn-success btn-label right ms-auto nexttab nexttab" data-nexttab="add-step3-tab">
                  <i class="ri-arrow-right-line label-icon align-middle fs-16 ms-2"></i>Next: CSPC-CIRL Details
                </button>
              </div>
            </div><!-- end step 2 -->

            <!-- STEP 3: CSPC-CIRL Details -->
            <div class="tab-pane fade" id="add-step3" role="tabpanel">
              <div class="mb-4">
                <h5 class="mb-1">CSPC-CIRL Details</h5>
                <p class="text-muted">Link this agreement to the appropriate unit and upload the document.</p>
              </div>
              <div class="row">
                <div class="col-lg-6 mb-3">
                  <label class="form-label" for="f-unit">Responsible Unit <span class="text-danger">*</span></label>
                  <select class="form-select" id="f-unit">
                    <option value="">Select unit…</option>
                    <option>CCS</option><option>CILS</option><option>CETE</option>
                    <option>CNAS</option><option>CAMS</option><option>CIRL</option>
                  </select>
                </div>
                <div class="col-lg-6 mb-3">
                  <label class="form-label" for="f-coordinator">CIRL Coordinator / Contact Person</label>
                  <input type="text" class="form-control" id="f-coordinator" placeholder="e.g. Dr. Santos">
                </div>
                <div class="col-lg-12 mb-3">
                  <label class="form-label" for="f-doc-link">Google Drive Link to Scanned Document</label>
                  <div class="input-group">
                    <span class="input-group-text"><i class="ri-links-line"></i></span>
                    <input type="url" class="form-control" id="f-doc-link" placeholder="https://drive.google.com/…">
                  </div>
                </div>
                <div class="col-lg-12 mb-3">
                  <label class="form-label">Or Upload PDF (OCR will be applied)</label>
                  <input class="form-control" type="file" id="f-doc-pdf" accept=".pdf" onchange="handleOcrPdf(this)">
                  <div id="f-ocr-status" class="mt-2 text-success fw-semibold fs-12" style="display:none">
                    <i class="ri-checkbox-circle-line me-1"></i><span id="f-ocr-msg"></span>
                  </div>
                </div>
                <div class="col-lg-12 mb-3">
                  <label class="form-label" for="f-remarks">Remarks</label>
                  <textarea class="form-control" id="f-remarks" rows="3" placeholder="e.g. Renewed in 2024, pending 2nd extension…"></textarea>
                </div>
              </div>
              <div class="d-flex align-items-start gap-3 mt-4">
                <button type="button" class="btn btn-light btn-label previestab" data-previous="add-step2-tab">
                  <i class="ri-arrow-left-line label-icon align-middle fs-16 me-2"></i>Back
                </button>
                <button type="button" class="btn btn-primary btn-label right ms-auto" onclick="submitPartnership()">
                  <i class="ri-save-line label-icon align-middle fs-16 ms-2"></i>Save Partnership
                </button>
              </div>
            </div><!-- end step 3 -->
          </div><!-- end tab-content -->
        </form>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- VIEW DETAIL MODAL                                               -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade zoomIn" id="viewPartnershipModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light p-3">
        <h5 class="modal-title" id="view-title">Partnership Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" id="view-close"></button>
      </div>
      <div class="modal-body" id="view-body"></div>
      <div class="modal-footer">
        <div class="hstack gap-2 justify-content-end">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- EDIT PARTNERSHIP MODAL                                          -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade zoomIn" id="editPartnershipModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light p-3">
        <h5 class="modal-title" id="editModalLabel">Edit Partnership</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" id="edit-close"></button>
      </div>
      <div class="modal-body">
        <div class="row">
          <div class="col-lg-12 mb-3">
            <label class="form-label" for="e-inst">Institution Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="e-inst">
          </div>
          <div class="col-lg-6 mb-3">
            <label class="form-label" for="e-country">Country <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="e-country">
          </div>
          <div class="col-lg-6 mb-3">
            <label class="form-label" for="e-region">Region</label>
            <select class="form-select" id="e-region">
              <option value="">Select…</option>
              <option>Asia</option><option>Europe</option><option>Americas</option>
              <option>Oceania</option><option>Africa</option><option>Local</option>
            </select>
          </div>
          <div class="col-lg-6 mb-3">
            <label class="form-label" for="e-partner-email">Partner Contact Email</label>
            <input type="email" class="form-control" id="e-partner-email">
          </div>
          <div class="col-lg-3 mb-3">
            <label class="form-label" for="e-type">Type <span class="text-danger">*</span></label>
            <select class="form-select" id="e-type"><option value="">Select…</option><option>MOA</option><option>MOU</option></select>
          </div>
          <div class="col-lg-3 mb-3">
            <label class="form-label" for="e-nature">Nature <span class="text-danger">*</span></label>
            <select class="form-select" id="e-nature">
              <option value="">Select…</option>
              <option>Research</option><option>Student Exchange</option><option>Training</option>
              <option>Conference</option><option>Faculty Exchange</option><option>Joint Program</option>
              <option>Internship</option><option>Other</option>
            </select>
          </div>
          <div class="col-lg-3 mb-3">
            <label class="form-label" for="e-cat">Category</label>
            <select class="form-select" id="e-cat">
              <option value="International">International</option><option value="Local">Local</option>
            </select>
          </div>
          <div class="col-lg-3 mb-3">
            <label class="form-label" for="e-unit">Unit <span class="text-danger">*</span></label>
            <select class="form-select" id="e-unit">
              <option value="">Select…</option>
              <option>CIRL</option><option>CCS</option><option>CETE</option><option>CNAS</option><option>CILS</option><option>All</option>
            </select>
          </div>
          <div class="col-lg-4 mb-3">
            <label class="form-label" for="e-start">Start Date</label>
            <input type="date" class="form-control" id="e-start">
          </div>
          <div class="col-lg-4 mb-3">
            <label class="form-label" for="e-end">End Date <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="e-end" onchange="computeEditStatus()">
          </div>
          <div class="col-lg-4 mb-3">
            <label class="form-label" for="e-status">Status (Auto-computed)</label>
            <input type="text" class="form-control bg-light" id="e-status" readonly>
          </div>
          <div class="col-lg-6 mb-3">
            <label class="form-label" for="e-coordinator">CIRL Coordinator</label>
            <input type="text" class="form-control" id="e-coordinator">
          </div>
          <div class="col-lg-6 mb-3">
            <label class="form-label" for="e-doclink">Document Link (Google Drive)</label>
            <input type="url" class="form-control" id="e-doclink">
          </div>
          <div class="col-lg-12 mb-3">
            <label class="form-label" for="e-remarks">Remarks</label>
            <textarea class="form-control" id="e-remarks" rows="2"></textarea>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <div class="hstack gap-2 justify-content-end">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-success" id="edit-btn" onclick="saveEdit()"><i class="ri-save-line me-1"></i>Update</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- RENEW PARTNERSHIP MODAL                                         -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade zoomIn" id="renewPartnershipModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-light p-3">
        <h5 class="modal-title">Renew Partnership</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" id="renew-close"></button>
      </div>
      <div class="modal-body">
        <div class="p-3 bg-success-subtle rounded mb-3">
          <div class="text-success fw-bold fs-11 text-uppercase mb-1">Renewing Partnership</div>
          <div class="fw-bold text-dark" id="renew-inst-name">—</div>
          <div class="text-muted fs-12" id="renew-inst-sub">—</div>
        </div>
        <div class="row">
          <div class="col-6 mb-3">
            <label class="form-label">Previous End Date</label>
            <input type="text" class="form-control bg-light" id="renew-prev-end" readonly>
          </div>
          <div class="col-6 mb-3">
            <label class="form-label">New End Date <span class="text-danger">*</span></label>
            <input type="date" class="form-control" id="renew-new-end" onchange="computeRenewStatus()">
          </div>
          <div class="col-6 mb-3">
            <label class="form-label">Validity Period</label>
            <input type="text" class="form-control bg-light fw-semibold" id="renew-validity" readonly>
          </div>
          <div class="col-6 mb-3">
            <label class="form-label">New Status</label>
            <input type="text" class="form-control bg-light" id="renew-status" readonly>
          </div>
          <div class="col-12 mb-3">
            <label class="form-label">Renewal Remarks</label>
            <textarea class="form-control" id="renew-remarks" rows="2" placeholder="e.g. Extended for 3 years — signed Apr 2026…"></textarea>
          </div>
        </div>
        <div class="alert alert-warning py-2 mb-0">
          <i class="ri-alert-line me-1"></i>This will update the partnership status to <strong>Active</strong> and record the new end date.
        </div>
      </div>
      <div class="modal-footer">
        <div class="hstack gap-2 justify-content-end">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-success" onclick="saveRenew()"><i class="ri-refresh-line me-1"></i>Confirm Renewal</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal - exact deleteRecordModal pattern from tables-listjs.html -->
<div class="modal fade zoomIn" id="deleteRecordModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="btn-close"></button>
      </div>
      <div class="modal-body">
        <div class="mt-2 text-center">
          <lord-icon src="https://cdn.lordicon.com/gsqxdxog.json" trigger="loop" colors="primary:#f7b84b,secondary:#f06548" style="width:100px;height:100px"></lord-icon>
          <div class="mt-4 pt-2 fs-15 mx-4 mx-sm-5">
            <h4>Are you Sure?</h4>
            <p class="text-muted mx-4 mb-0">Are you sure you want to remove this partnership record?</p>
          </div>
        </div>
        <div class="d-flex gap-2 justify-content-center mt-4 mb-2">
          <button type="button" class="btn w-sm btn-light" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn w-sm btn-danger" id="delete-record" onclick="confirmDelete()">Yes, Delete It!</button>
        </div>
      </div>
    </div>
  </div>
</div>
<!--end delete modal -->

<!-- Velzon toast anchor -->
<div id="reg-toast"><span id="reg-toast-msg"></span></div>

            </div><!-- container-fluid -->
        </div><!-- page-content -->

        <footer class="footer">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-6">
                        <script>document.write(new Date().getFullYear())</script> &copy; CIPRMS &mdash; CSPC-CIRL
                    </div>
                    <div class="col-sm-6">
                        <div class="text-sm-end d-none d-sm-block">
                            Camarines Sur Polytechnic Colleges
                        </div>
                    </div>
                </div>
            </div>
        </footer>

    </div><!-- end main content -->

</div><!-- END layout-wrapper -->




    <script>
      // ──────────────────────────────────────────────────────────
      // DATA (demo — replace with real DB calls later)
      // ──────────────────────────────────────────────────────────
      let partnerships = [
        { id: 1, inst: "Ateneo de Manila University", country: "Philippines", region: "Local", type: "MOA", nature: "Research", cat: "Local", unit: "CCS", coordinator: "Dr. Santos", partnerEmail: "ateneo@admu.edu.ph", docLink: "https://drive.google.com/", startYear: 2021, endYear: 2026, start: "Apr 12, 2021", end: "Apr 12, 2026", status: "Expiring Soon", remarks: "Up for renewal Q2 2026" },
        { id: 2, inst: "Osaka University", country: "Japan", region: "Asia", type: "MOU", nature: "Student Exchange", cat: "International", unit: "CIRL", coordinator: "Prof. Reyes", partnerEmail: "intl@osaka-u.ac.jp", docLink: "https://drive.google.com/", startYear: 2022, endYear: 2026, start: "May 3, 2022", end: "May 3, 2026", status: "Expiring Soon", remarks: "" },
        { id: 3, inst: "University of Santo Tomas", country: "Philippines", region: "Local", type: "MOA", nature: "Joint Program", cat: "Local", unit: "CILS", coordinator: "Dr. Santos", partnerEmail: "oir@ust.edu.ph", docLink: "https://drive.google.com/", startYear: 2021, endYear: 2026, start: "Dec 15, 2021", end: "Dec 15, 2026", status: "Active", remarks: "" },
        { id: 4, inst: "Chonnam National University", country: "South Korea", region: "Asia", type: "MOU", nature: "Research", cat: "International", unit: "CETE", coordinator: "Prof. Reyes", partnerEmail: "global@jnu.ac.kr", docLink: "https://drive.google.com/", startYear: 2022, endYear: 2027, start: "Mar 30, 2022", end: "Mar 30, 2027", status: "Active", remarks: "" },
        { id: 5, inst: "TESDA Region V", country: "Philippines", region: "Local", type: "MOA", nature: "Training", cat: "Local", unit: "CETE", coordinator: "Admin Rivera", partnerEmail: "regionv@tesda.gov.ph", docLink: "", startYear: 2020, endYear: 2025, start: "Jan 1, 2020", end: "Jan 1, 2025", status: "Expired", remarks: "Needs renewal" },
        { id: 6, inst: "University of Macau", country: "China", region: "Asia", type: "MOA", nature: "Student Exchange", cat: "International", unit: "CILS", coordinator: "Dr. Santos", partnerEmail: "admo@um.edu.mo", docLink: "https://drive.google.com/", startYear: 2022, endYear: 2027, start: "Jul 22, 2022", end: "Jul 22, 2027", status: "Active", remarks: "" },
        { id: 7, inst: "De La Salle University", country: "Philippines", region: "Local", type: "MOA", nature: "Faculty Exchange", cat: "Local", unit: "CCS", coordinator: "Admin Rivera", partnerEmail: "iro@dlsu.edu.ph", docLink: "https://drive.google.com/", startYear: 2023, endYear: 2028, start: "Feb 1, 2023", end: "Feb 1, 2028", status: "Active", remarks: "" },
        { id: 8, inst: "NTU Singapore", country: "Singapore", region: "Asia", type: "MOU", nature: "Research", cat: "International", unit: "CIRL", coordinator: "Prof. Reyes", partnerEmail: "global@ntu.edu.sg", docLink: "", startYear: 2022, endYear: 2025, start: "Aug 10, 2022", end: "Aug 10, 2025", status: "Expired", remarks: "Renewal under review" },
        { id: 9, inst: "University of Melbourne", country: "Australia", region: "Oceania", type: "MOU", nature: "Research", cat: "International", unit: "CNAS", coordinator: "Dr. Santos", partnerEmail: "partnerships@unimelb.edu.au", docLink: "https://drive.google.com/", startYear: 2023, endYear: 2028, start: "Jun 5, 2023", end: "Jun 5, 2028", status: "Active", remarks: "" },
        { id: 10, inst: "DOST Region V", country: "Philippines", region: "Local", type: "MOA", nature: "Research", cat: "Local", unit: "CNAS", coordinator: "Admin Rivera", partnerEmail: "regionv@dost.gov.ph", docLink: "", startYear: 2022, endYear: 2026, start: "Nov 15, 2022", end: "Nov 15, 2026", status: "Active", remarks: "" },
        { id: 11, inst: "Kyoto University", country: "Japan", region: "Asia", type: "MOA", nature: "Research", cat: "International", unit: "CIRL", coordinator: "Prof. Reyes", partnerEmail: "oia@kyoto-u.ac.jp", docLink: "https://drive.google.com/", startYear: 2021, endYear: 2027, start: "Jan 20, 2021", end: "Jan 20, 2027", status: "Active", remarks: "" },
        { id: 12, inst: "Mapua University", country: "Philippines", region: "Local", type: "MOA", nature: "Joint Program", cat: "Local", unit: "CCS", coordinator: "Dr. Santos", partnerEmail: "iro@mapua.edu.ph", docLink: "https://drive.google.com/", startYear: 2023, endYear: 2028, start: "Mar 1, 2023", end: "Mar 1, 2028", status: "Active", remarks: "" },
        { id: 13, inst: "Hiroshima University", country: "Japan", region: "Asia", type: "MOA", nature: "Research", cat: "International", unit: "CIRL", coordinator: "Prof. Reyes", partnerEmail: "", docLink: "", startYear: 2026, endYear: 2031, start: "Apr 29, 2026", end: "Apr 29, 2031", status: "Pending Approval", remarks: "Submitted by Auth. Personnel. Awaiting admin activation." },
      ];

      // ──────────────────────────────────────────────────────────
      // FILTER & RENDER
      // ──────────────────────────────────────────────────────────
      let filtered = [...partnerships];

      function applyFilter() {
        const q = document.getElementById('reg-search').value.toLowerCase();
        const typ = document.getElementById('reg-type').value;
        const cat = document.getElementById('reg-cat').value;
        const st = document.getElementById('reg-status').value;
        const reg = document.getElementById('reg-region').value;
        const unt = document.getElementById('reg-unit').value;
        const yrs = document.getElementById('reg-yr-signed').value;
        const yre = document.getElementById('reg-yr-exp').value;

        filtered = partnerships.filter(p =>
          (!q || p.inst.toLowerCase().includes(q) || p.country.toLowerCase().includes(q)) &&
          (!typ || p.type === typ) &&
          (!cat || p.cat === cat) &&
          (!st || p.status === st) &&
          (!reg || p.region === reg) &&
          (!unt || p.unit === unt) &&
          (!yrs || p.startYear == yrs) &&
          (!yre || p.endYear == yre)
        );
        page = 1;
        renderTable();
      }

      function clearFilters() {
        ['reg-search', 'reg-type', 'reg-cat', 'reg-status', 'reg-region', 'reg-unit', 'reg-yr-signed', 'reg-yr-exp']
          .forEach(id => {
            const el = document.getElementById(id);
            if (el.tagName === 'INPUT') el.value = ''; else el.value = '';
          });
        applyFilter();
      }

      function sbadge(s) {
        const m = {
          'Active': 'bg-success-subtle text-success',
          'Expiring Soon': 'bg-warning-subtle text-warning',
          'Expired': 'bg-danger-subtle text-danger',
          'Pending Approval': 'bg-info-subtle text-info'
        };
        return `<span class="badge ${m[s]||'bg-secondary-subtle text-secondary'}">${s}</span>`;
      }

      function renderTable() {
        document.getElementById('cnt-total').textContent = partnerships.length;
        document.getElementById('cnt-active').textContent = partnerships.filter(p => p.status === 'Active').length;
        document.getElementById('cnt-expiring').textContent = partnerships.filter(p => p.status === 'Expiring Soon').length;
        document.getElementById('cnt-expired').textContent = partnerships.filter(p => p.status === 'Expired').length;
        document.getElementById('reg-count').textContent = `${filtered.length} of ${partnerships.length} records`;
        document.getElementById('pg-info').textContent = `${filtered.length} record${filtered.length !== 1 ? 's' : ''} shown`;

        document.getElementById('reg-tbody').innerHTML = filtered.length ? filtered.map((p, i) => `
    <tr class="item">
      <td class="text-muted fw-semibold">${i + 1}</td>
      <td>
        <div class="fw-semibold inst">${p.inst}</div>
        ${p.coordinator ? `<div class="text-muted fs-11"><i class="ri-user-line me-1"></i>${p.coordinator}</div>` : ''}
      </td>
      <td>
        <div>${p.country}</div>
        <div class="text-muted fs-11"><i class="ri-map-pin-line me-1"></i>${p.region}</div>
      </td>
      <td><span class="badge bg-primary-subtle text-primary ptype">${p.type}</span></td>
      <td class="text-muted fs-12 pnature">${p.nature}</td>
      <td><span class="badge bg-success-subtle text-success punit">${p.unit}</span></td>
      <td class="text-muted fs-12 pstart">${p.start}</td>
      <td class="fw-semibold fs-12 pend" style="color:${p.status==='Expired'?'#dc2626':p.status==='Expiring Soon'?'#d97706':'#15803d'}">${p.end}</td>
      <td class="pstatus">${sbadge(p.status)}</td>
      <td>
        <div class="d-flex gap-2">
          <div class="view">
            <button class="btn btn-sm btn-info view-item-btn" onclick="openViewModal(${p.id})">View</button>
          </div>
          <div class="edit">
            ${p.status === 'Pending Approval'
              ? `<button class="btn btn-sm btn-success" onclick="approveRecord(${p.id})">Approve</button>`
              : p.status === 'Expired' || p.status === 'Expiring Soon'
                ? `<button class="btn btn-sm btn-success edit-item-btn" onclick="openEditModal(${p.id})">Edit</button>`
                : `<button class="btn btn-sm btn-success edit-item-btn" onclick="openEditModal(${p.id})">Edit</button>`
            }
          </div>
          ${p.status === 'Expired' || p.status === 'Expiring Soon'
            ? `<div class="renew"><button class="btn btn-sm btn-warning" onclick="openRenewModal(${p.id})">Renew</button></div>`
            : ''
          }
          <div class="remove">
            <button class="btn btn-sm btn-danger remove-item-btn" onclick="openDeleteModal(${p.id})">Remove</button>
          </div>
        </div>
      </td>
    </tr>`).join('') : `<tr><td colspan="10" class="text-center py-4 text-muted">No records found.</td></tr>`;

        if (typeof partnerList !== 'undefined' && partnerList) partnerList.reIndex();
      }

      // ──────────────────────────────────────────────────────────
      // MODAL HELPERS
      // ──────────────────────────────────────────────────────────
      function openAddModal() {
        const m = new bootstrap.Modal(document.getElementById('addPartnershipModal'));
        m.show();
      }

      function openViewModal(id) {
        const p = partnerships.find(x => x.id === id);
        if (!p) return;
        document.getElementById('view-title').textContent = p.inst;
        document.getElementById('view-body').innerHTML = `
    <div class="row g-3">
      <div class="col-sm-6"><div class="text-muted fs-12">Institution</div><div class="fw-semibold">${p.inst}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">Country</div><div class="fw-semibold">${p.country}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">Region</div><div class="fw-semibold">${p.region}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">Type</div><div class="fw-semibold">${p.type}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">Nature</div><div class="fw-semibold">${p.nature}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">Category</div><div class="fw-semibold">${p.cat}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">Start Date</div><div class="fw-semibold">${p.start}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">End Date</div><div class="fw-semibold">${p.end}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">Status</div><div>${sbadge(p.status)}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">Responsible Unit</div><div class="fw-semibold">${p.unit}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">CIRL Coordinator</div><div class="fw-semibold">${p.coordinator || '—'}</div></div>
      <div class="col-sm-6"><div class="text-muted fs-12">Partner Email</div><div>${p.partnerEmail ? `<a href="mailto:${p.partnerEmail}">${p.partnerEmail}</a>` : '—'}</div></div>
      <div class="col-sm-12"><div class="text-muted fs-12">Document Link</div><div>${p.docLink ? `<a href="${p.docLink}" target="_blank">${p.docLink}</a>` : '— Not uploaded'}</div></div>
      <div class="col-sm-12"><div class="text-muted fs-12">Remarks</div><div>${p.remarks || '—'}</div></div>
    </div>`;
        const m = new bootstrap.Modal(document.getElementById('viewPartnershipModal'));
        m.show();
      }


      function approveRecord(id) {
        const p = partnerships.find(x => x.id === id);
        if (!p) return;
        if (!confirm(`Approve and activate the partnership with "${p.inst}"?`)) return;
        p.status = 'Active';
        filtered = [...partnerships];
        renderTable();
        showToast('<i class="ri-checkbox-circle-line"></i> Partnership approved and set to Active!');
      }

      let deletingId = null;
      function openDeleteModal(id) {
        deletingId = id;
        const m = new bootstrap.Modal(document.getElementById('deleteRecordModal'));
        m.show();
      }

      function confirmDelete() {
        if (!deletingId) return;
        const idx = partnerships.findIndex(x => x.id === deletingId);
        if (idx === -1) return;
        const name = partnerships[idx].inst;
        partnerships.splice(idx, 1);
        deletingId = null;
        bootstrap.Modal.getInstance(document.getElementById('deleteRecordModal'))?.hide();
        applyFilter();
        showToast(`"${name}" has been removed from the registry.`);
      }

      function showToast(msg, color = '#1e3a8a') {
        let t = document.getElementById('reg-toast');
        if (!t) { t = document.createElement('div'); t.id = 'reg-toast'; document.body.appendChild(t); }
        t.style.cssText = `position:fixed;bottom:28px;right:28px;z-index:9999;padding:12px 20px;border-radius:10px;color:#fff;font-size:13px;font-weight:600;display:flex;align-items:center;gap:8px;box-shadow:0 4px 20px rgba(0,0,0,.18);transition:opacity .3s;background:${color};opacity:1;`;
        t.innerHTML = msg;
        clearTimeout(t._to); t._to = setTimeout(() => { t.style.opacity = '0'; }, 3500);
      }

      function closeModal(id) {
        document.getElementById(id).classList.remove('open');
      }

      // ── OCR PDF Upload ────────────────────────────────────────
      function handleOcrPdf(input) {
        const file = input.files[0];
        if (!file) return;
        const status = document.getElementById('f-ocr-status');
        const msg = document.getElementById('f-ocr-msg');
        status.style.display = 'flex';
        status.style.alignItems = 'center';
        status.style.gap = '6px';
        msg.textContent = `"${file.name}" selected — OCR will be applied on save.`;
      }


      let editingId = null;

      function openEditModal(id) {
        const p = partnerships.find(x => x.id === id);
        if (!p) return;
        editingId = id;
        // Pre-fill fields
        document.getElementById('e-inst').value = p.inst;
        document.getElementById('e-country').value = p.country;
        document.getElementById('e-region').value = p.region;
        document.getElementById('e-partner-email').value = p.partnerEmail || '';
        document.getElementById('e-type').value = p.type;
        document.getElementById('e-nature').value = p.nature;
        document.getElementById('e-cat').value = p.cat;
        // Convert "Apr 12, 2021" → "2021-04-12" for date inputs
        const toISO = s => { const d = new Date(s); return isNaN(d) ? '' : d.toISOString().slice(0, 10); };
        document.getElementById('e-start').value = toISO(p.start);
        document.getElementById('e-end').value = toISO(p.end);
        document.getElementById('e-status').value = p.status;
        document.getElementById('e-unit').value = p.unit;
        document.getElementById('e-coordinator').value = p.coordinator || '';
        document.getElementById('e-doclink').value = p.docLink || '';
        document.getElementById('e-remarks').value = p.remarks || '';
        const m = new bootstrap.Modal(document.getElementById('editPartnershipModal'));
        m.show();
      }

      function computeEditStatus() {
        const endVal = document.getElementById('e-end').value;
        if (!endVal) return;
        const diff = Math.ceil((new Date(endVal) - new Date()) / 86400000);
        document.getElementById('e-status').value = diff < 0 ? 'Expired' : diff <= 90 ? 'Expiring Soon' : 'Active';
      }

      function saveEdit() {
        const inst = document.getElementById('e-inst').value.trim();
        const end = document.getElementById('e-end').value;
        if (!inst || !end) { alert('Institution name and End Date are required.'); return; }
        const fmtDate = v => new Date(v).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const p = partnerships.find(x => x.id === editingId);
        if (!p) return;
        p.inst = inst;
        p.country = document.getElementById('e-country').value.trim();
        p.region = document.getElementById('e-region').value;
        p.partnerEmail = document.getElementById('e-partner-email').value.trim();
        p.type = document.getElementById('e-type').value;
        p.nature = document.getElementById('e-nature').value;
        p.cat = document.getElementById('e-cat').value;
        p.start = fmtDate(document.getElementById('e-start').value);
        p.end = fmtDate(end);
        p.endYear = new Date(end).getFullYear();
        p.status = document.getElementById('e-status').value;
        p.unit = document.getElementById('e-unit').value;
        p.coordinator = document.getElementById('e-coordinator').value.trim();
        p.docLink = document.getElementById('e-doclink').value.trim();
        p.remarks = document.getElementById('e-remarks').value.trim();
        bootstrap.Modal.getInstance(document.getElementById('editPartnershipModal'))?.hide();
        applyFilter();
        showToast(`"${p.inst}" updated successfully.`);
      }

      // ── Renew Modal ───────────────────────────────────────────
      let renewingId = null;

      function openRenewModal(id) {
        const p = partnerships.find(x => x.id === id);
        if (!p) return;
        renewingId = id;
        document.getElementById('renew-inst-name').textContent = p.inst;
        document.getElementById('renew-inst-sub').textContent = `${p.type} · ${p.country} · Previously expired: ${p.end}`;
        document.getElementById('renew-prev-end').value = p.end;
        document.getElementById('renew-new-end').value = '';
        document.getElementById('renew-validity').value = '';
        document.getElementById('renew-status').value = '';
        document.getElementById('renew-remarks').value = '';
        const m = new bootstrap.Modal(document.getElementById('renewPartnershipModal'));
        m.show();
      }

      function computeRenewStatus() {
        const endVal = document.getElementById('renew-new-end').value;
        if (!endVal) return;
        const endDate = new Date(endVal);
        const diff = Math.ceil((endDate - new Date()) / 86400000);
        document.getElementById('renew-status').value = diff < 0 ? 'Expired' : diff <= 90 ? 'Expiring Soon' : 'Active';
        // Compute validity in years+months from today
        const now = new Date();
        const yrs = endDate.getFullYear() - now.getFullYear();
        const mos = endDate.getMonth() - now.getMonth();
        const total = yrs * 12 + mos;
        const y = Math.floor(total / 12), m = total % 12;
        document.getElementById('renew-validity').value = (y > 0 ? y + ' yr' + (y > 1 ? 's' : '') : '') + (m > 0 ? (y > 0 ? ' ' : '') + m + ' mo' : '') || '< 1 month';
      }

      function saveRenew() {
        const newEnd = document.getElementById('renew-new-end').value;
        if (!newEnd) { alert('Please set a new end date.'); return; }
        const fmtDate = v => new Date(v).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const p = partnerships.find(x => x.id === renewingId);
        if (!p) return;
        p.end = fmtDate(newEnd);
        p.endYear = new Date(newEnd).getFullYear();
        const diff = Math.ceil((new Date(newEnd) - new Date()) / 86400000);
        p.status = diff < 0 ? 'Expired' : diff <= 90 ? 'Expiring Soon' : 'Active';
        const rmk = document.getElementById('renew-remarks').value.trim();
        if (rmk) p.remarks = rmk;
        bootstrap.Modal.getInstance(document.getElementById('renewPartnershipModal'))?.hide();
        applyFilter();
        showToast(`"${p.inst}" renewed — new end date: ${p.end}.`);
      }

      // ── Toast ─────────────────────────────────────────────────
      let toastTimer = null;
      function showToast(msg) {
        const t = document.getElementById('reg-toast');
        document.getElementById('reg-toast-msg').textContent = msg;
        t.style.display = 'flex';
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => { t.style.display = 'none'; }, 3500);
      }

      // close modal-overlay listener no longer needed (Bootstrap handles it)

      // ──────────────────────────────────────────────────────────
      // AUTO-COMPUTE STATUS FROM END DATE
      // ──────────────────────────────────────────────────────────
      function computeStatus() {
        const endVal = document.getElementById('f-end').value;
        if (!endVal) return;
        const today = new Date();
        const endDate = new Date(endVal);
        const diff = Math.ceil((endDate - today) / (1000 * 60 * 60 * 24));
        let status = 'Active';
        if (diff < 0) status = 'Expired';
        else if (diff <= 90) status = 'Expiring Soon';
        document.getElementById('f-status').value = status;
      }

      // ──────────────────────────────────────────────────────────
      // SUBMIT (demo)
      // ──────────────────────────────────────────────────────────
      function submitPartnership() {
        const inst = document.getElementById('f-inst').value.trim();
        const type = document.getElementById('f-type').value;
        const start = document.getElementById('f-start').value;
        const end = document.getElementById('f-end').value;
        const unit = document.getElementById('f-unit').value;
        const region = document.getElementById('f-region').value;

        // Validation
        if (!inst) { highlight('f-inst', true); }
        if (!type) { highlight('f-type', true); }
        if (!start) { highlight('f-start', true); }
        if (!end) { highlight('f-end', true); }
        if (!unit) { highlight('f-unit', true); }
        if (!inst || !type || !start || !end || !unit) {
          return;
        }

        const fmtDate = v => new Date(v).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        const diff = Math.ceil((new Date(end) - new Date()) / 86400000);
        const status = document.getElementById('f-status').value ||
          (diff < 0 ? 'Expired' : diff <= 90 ? 'Expiring Soon' : 'Active');

        const newP = {
          id: partnerships.length + 1,
          inst,
          country: document.getElementById('f-country').value.trim() || '—',
          region: region || '—',
          type,
          nature: document.getElementById('f-nature').value || '—',
          cat: document.getElementById('f-cat').value || 'International',
          unit,
          coordinator: document.getElementById('f-coordinator').value.trim(),
          partnerEmail: document.getElementById('f-partner-email').value.trim(),
          docLink: document.getElementById('f-doc-link').value.trim(),
          startYear: new Date(start).getFullYear(),
          endYear: new Date(end).getFullYear(),
          start: fmtDate(start),
          end: fmtDate(end),
          status,
          remarks: document.getElementById('f-remarks').value.trim(),
        };

        partnerships.push(newP);
        applyFilter();
        bootstrap.Modal.getInstance(document.getElementById('addPartnershipModal'))?.hide();
        showToast(`"${newP.inst}" added to the registry.`);

      }

      function highlight(id, on) {
        const el = document.getElementById(id);
        if (!el) return;
        el.style.borderColor = on ? '#dc2626' : '';
        el.addEventListener('input', () => { el.style.borderColor = ''; }, { once: true });
      }


